<!-- 「计划完成」的日历浮层：一个月历 + 一排时刻快捷档，点格子就设好（不用滚轮）。
     下面留一个 time picker 兜底，真要 14:37 这种时刻才用得上。
     样式：.sheet / .sh-* / .btn 是 app.wxss 的全局样式（本组件开了 addGlobalClass 才拿得到），
     .du-* 是这个浮层自己的。
     z-index 抬到 70（.sheet 默认 60）：上面还可能压着快捷记面板（62）或撤销条 -->
<view wx:if="{{open}}" class="sheet du-sheet">
  <view class="sh-h">
    <view class="st">计划完成</view>
    <view class="sx" bindtap="onClose" aria-label="关闭">✕</view>
  </view>
  <view class="sh-sub">点一天，再点一个大致时刻；都不设就按那天结束前算</view>
  <view class="sh-list">
    <!-- 月份头：‹ 10月 ›。翻月只改「在看哪个月」，选中的日期不动 -->
    <view class="du-mon">
      <view class="du-arrow" bindtap="onPrev" aria-label="上一月">‹</view>
      <view class="du-mon-t">{{monT}}</view>
      <view class="du-arrow" bindtap="onNext" aria-label="下一月">›</view>
    </view>
    <!-- 周一起始（与「回看」的自然周一致）。固定 6 行，格子不跳 -->
    <view class="du-wk">
      <view wx:for="{{week}}" wx:key="*this" class="du-wk1">{{item}}</view>
    </view>
    <view class="du-grid">
      <view wx:for="{{grid}}" wx:key="ymd" class="du-cell {{item.inMonth ? '' : 'out'}} {{item.today ? 'today' : ''}} {{item.sel ? 'sel' : ''}} {{item.past ? 'past' : ''}}" data-d="{{item.ymd}}" bindtap="onDay">{{item.d}}</view>
    </view>
    <!-- 时刻快捷档：一次点到，不开滚轮 -->
    <view class="du-lab">时刻</view>
    <view class="du-times">
      <view wx:for="{{times}}" wx:key="k" class="du-time {{timeKey===item.k ? 'on' : ''}}" data-k="{{item.k}}" catchtap="onTimePick">{{item.n}}</view>
    </view>
    <!-- 兜底：任意时刻（只有真的要 14:37 才用） -->
    <picker mode="time" value="{{time}}" bindchange="onTime">
      <view class="du-pk"><view class="du-pick"><text class="du-k">其它时刻</text><text class="du-v">{{time}}</text><text class="du-c">▸</text></view></view>
    </picker>
    <view class="du-hint">「不设时刻」＝那天 23:59（＝那天结束前），和今天 / 明天那几档同一个口径。</view>
  </view>
  <view class="sh-foot">
    <view class="btn gh" bindtap="onClose">取消</view>
    <view class="btn" bindtap="onOk">好</view>
  </view>
</view>
