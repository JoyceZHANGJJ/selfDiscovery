<!-- 待办清单：待完成 / 已完成 / 已放弃 三段（与看页、清单页同一套样式，样式在 app.wxss）。
     这里只负责渲染与折叠态，勾选/选中/长按/展开等交互都通过事件交给页面处理，
     这样清单页与看页可以各自接同一份渲染，行为口径保持一致。 -->
<view class="todo-list">
  <!-- 标题行：左边标题（+汇总），右边留给使用方的入口（看页的「去清单页管理 ›」）——
       入口与标题**同一行、右起**，不再在下面单独占一行（见 app.wxss 的 .tl-top）。
       没传插槽内容时右侧是空的（宽度为 0），清单页的排布不受影响 -->
  <view class="tl-top">
    <view class="tl-top-l">
      <view wx:if="{{tit}}" class="sect-t">{{tit}}</view>
      <view wx:if="{{sum}}" class="tsum">{{sum}}</view>
    </view>
    <view class="tl-top-r"><slot></slot></view>
  </view>

  <!-- 待完成 -->
  <view wx:if="{{undoneN}}">
    <view class="tfhd" bindtap="onFold" data-k="undone">
      <view class="tt">待完成 · {{undoneN}}</view>
      <view class="tl"></view>
      <view class="tc {{openU?'open':''}}">▸</view>
    </view>
    <block wx:if="{{openU}}">
      <view wx:for="{{undone}}" wx:key="id" id="erow-{{item.id}}" class="rec list tl {{sel===item.id?'sel':''}} {{item.done?'done':''}} {{edId===item.id?'blank':''}}" style="--dot:{{item.c}}" data-id="{{item.id}}" catchtap="onTapRow" bindlongpress="onLongPress" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel">
        <view class="edge" style="background:{{item.c}}"></view>
        <view class="hd">
          <view class="ck {{item.done?'on':''}}" data-id="{{item.id}}" catchtap="onCheck" aria-role="checkbox" aria-checked="{{item.done}}" aria-label="标记完成"></view>
          <text class="mn" style="color:{{item.c}}" wx:if="{{showMn}}">{{item.m}}</text>
          <view class="prio" wx:if="{{item.pn}}" style="color:{{item.pc}}" aria-label="优先级 {{item.pn}}"></view>
          <text class="tv">{{item.txt}}</text>
          <!-- 计划完成：**没计划就不渲染**（多数待办本来就没计划时间）。
               位置在「创建时间」的**左边**：时间是这一行最后一眼扫到的东西，
               计划完成是额外挂着的一条期限，排在时间前面才读得出「几天后 / 已经过期」。
               点一下＝取消这条待办的计划（会先问一句）；要定日子走行尾左滑的快捷记面板，
               或进记卡里那一行 chips。 -->
          <view wx:if="{{item.dueHas}}" class="due {{item.dueOv?'ov':''}}" data-id="{{item.id}}" catchtap="onDueTap" aria-label="计划完成 {{item.due}}，点一下取消计划">{{item.due}}</view>
          <!-- 时间用 tt（待办行专用：今天＝时刻，非今天＝简洁日期）而不是 t：
               清单页的 recVM 把 t 覆盖成了 tt，看页没有，两边都读 tt 才真的同一份口径 -->
          <view class="twr"><text class="twx">{{item.reason || item.usefor}}</text><text wx:if="{{item.reason || item.usefor}}" class="twd">·</text><text class="twt">{{item.tt}}</text></view>
        </view>
        <view wx:if="{{item.done}}" class="done-at">{{item.doneLabel}}</view>
      </view>
      <view wx:if="{{undoneHide}}" class="moreline" data-k="u" bindtap="onMore">显示更多（还有 {{undoneHide}} 条）</view>
    </block>
  </view>

  <!-- 已完成：按完成那天分段（与看页同一套日标签），段内按完成时间倒序 -->
  <view wx:if="{{doneN}}">
    <view class="tfhd" bindtap="onFold" data-k="done">
      <view class="tt">已完成 · {{doneN}}</view>
      <view class="tl"></view>
      <view class="tc {{openD?'open':''}}">▸</view>
    </view>
    <block wx:if="{{openD}}">
      <view wx:for="{{doneGroups}}" wx:key="key" wx:for-item="g">
        <view class="daylab">{{g.day}}<text wx:if="{{g.more || g.all}}" class="daymore" data-k="{{g.key}}" data-w="d" bindtap="onDayMore">{{g.all ? '收起' : '展开全部 ' + g.n + ' 条'}}</text></view>
        <view wx:for="{{g.recs}}" wx:for-item="item" wx:key="id" id="erow-{{item.id}}" class="rec list tl done {{sel===item.id?'sel':''}} {{edId===item.id?'blank':''}}" style="--dot:{{item.c}}" data-id="{{item.id}}" catchtap="onTapRow" bindlongpress="onLongPress" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel">
          <view class="edge" style="background:{{item.c}}"></view>
          <view class="hd">
            <view class="ck on" data-id="{{item.id}}" catchtap="onCheck" aria-role="checkbox" aria-checked="{{true}}" aria-label="取消完成"></view>
            <text class="mn" style="color:{{item.c}}" wx:if="{{showMn}}">{{item.m}}</text>
            <view class="prio" wx:if="{{item.pn}}" style="color:{{item.pc}}" aria-label="优先级 {{item.pn}}"></view>
            <text class="tv">{{item.txt}}</text>
            <view class="twr"><text class="twx">{{item.reason || item.usefor}}</text><text wx:if="{{item.reason || item.usefor}}" class="twd">·</text><text class="twt">{{item.tt}}</text></view>
          </view>
          <view class="done-at">{{item.doneAtText}}</view>
        </view>
      </view>
      <view wx:if="{{doneHide}}" class="moreline" data-k="d" bindtap="onMore">显示更早（还有 {{doneHide}} 天）</view>
    </block>
  </view>

  <!-- 已放弃：与已完成同构（按放弃那天分段）；点条目出操作条可「恢复」 -->
  <view wx:if="{{abandN}}">
    <view class="tfhd" bindtap="onFold" data-k="aband">
      <view class="tt">已放弃 · {{abandN}}</view>
      <view class="tl"></view>
      <view class="tc {{openA?'open':''}}">▸</view>
    </view>
    <block wx:if="{{openA}}">
      <view wx:for="{{abandGroups}}" wx:key="key" wx:for-item="g">
        <view class="daylab">{{g.day}}<text wx:if="{{g.more || g.all}}" class="daymore" data-k="{{g.key}}" data-w="a" bindtap="onDayMore">{{g.all ? '收起' : '展开全部 ' + g.n + ' 条'}}</text></view>
        <view wx:for="{{g.recs}}" wx:for-item="item" wx:key="id" id="erow-{{item.id}}" class="rec list tl ab {{sel===item.id?'sel':''}} {{edId===item.id?'blank':''}}" style="--dot:{{item.c}}" data-id="{{item.id}}" catchtap="onTapRow" bindlongpress="onLongPress" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel">
          <view class="edge" style="background:{{item.c}}"></view>
          <view class="hd">
            <!-- 圈里画 × 且不可点：完成要走操作条里的「恢复」，不是直接勾掉 -->
            <view class="ck" aria-label="已放弃"></view>
            <text class="mn" style="color:{{item.c}}" wx:if="{{showMn}}">{{item.m}}</text>
            <view class="prio" wx:if="{{item.pn}}" style="color:{{item.pc}}" aria-label="优先级 {{item.pn}}"></view>
            <text class="tv">{{item.txt}}</text>
            <view class="twr"><text class="twx">{{item.reason || item.usefor}}</text><text wx:if="{{item.reason || item.usefor}}" class="twd">·</text><text class="twt">{{item.tt}}</text></view>
          </view>
          <view class="done-at">{{item.abandAtText}}</view>
        </view>
      </view>
      <view wx:if="{{abandHide}}" class="moreline" data-k="a" bindtap="onMore">显示更早（还有 {{abandHide}} 天）</view>
    </block>
  </view>
</view>
