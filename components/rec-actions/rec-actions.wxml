<!-- bottom 可选：页面没传就用样式里的默认值（抬到底部 tab 栏之上）。
     清单页这类「没有 tab 栏」的页面传一个更小的值，免得条子悬在半空、下面留一条空档 -->
<view class="actbar {{visible ? 'on' : ''}}" style="{{bottom ? 'bottom:' + bottom : ''}}">
  <view wx:if="{{title}}" class="tx">{{title}}</view>

  <view wx:if="{{flow.length}}" class="grp flowgrp">
    <view wx:for="{{flow}}" wx:key="type" class="flow {{item.cls}}" data-type="{{item.type}}" bindtap="onTap">{{item.label}}</view>
  </view>

  <view wx:if="{{showEndSep}}" class="sep"></view>
  <view wx:if="{{showWantSep}}" class="sep"></view>

  <view wx:if="{{showEditDel}}" class="grp mgrp">
    <view class="edit" data-type="edit" bindtap="onTap">改</view>
    <view class="del" data-type="del" bindtap="onTap">删除</view>
  </view>
</view>
