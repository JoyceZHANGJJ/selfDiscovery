/* pages/analysis/analysis.wxss —— AI 回看
   基础布局（.app / .screen / .body / .sect-t / .sk / .loadfail）来自 app.wxss，
   这里只补本页特有的卡片与空态 */

.app { position: static; min-height: 100vh; display: block; }
.screen { height: auto; }
.body { min-height: calc(100vh + 60px); }

/* 子页头部：返回 + 标题（与 options 页同一套 .bk 风格） */
.a-hd { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
.a-hd .bk { flex-shrink: 0; font-size: 15px; color: var(--ink2); padding: 4px 2px; }
.a-hd .a-tt { font-size: 17px; font-weight: 800; color: var(--ink); }

.hint { font-size: 12px; color: var(--ink3); margin: -2px 0 12px; }

/* 单条每日回看卡片：白底 + 细边，与回看页档案卡同一套语言 */
.acard { background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 13px 14px; margin-bottom: 10px; }
.ac-h { display: flex; align-items: baseline; gap: 10px; }
.ac-date { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-start; line-height: 1.2; }
.ac-date .ac-d { font-size: 14px; font-weight: 800; color: var(--ink); }
.ac-date .ac-w { font-size: 11px; color: var(--ink3); }
.ac-sum { flex: 1; min-width: 0; font-size: 14px; color: var(--ink); line-height: 1.5; word-break: break-word; }
.ac-chev { flex-shrink: 0; font-size: 12px; color: var(--ink3); transition: transform .18s; }
.acard.open .ac-chev { transform: rotate(90deg); }

.ac-mood { margin-top: 7px; font-size: 12.5px; color: var(--ink2); }
.ac-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 9px; }
.ac-tag { font-size: 11.5px; color: var(--accent); background: var(--accent-soft); border-radius: 99px; padding: 2px 9px; }

.ac-detail { margin-top: 11px; padding-top: 11px; border-top: 1px solid var(--line); }
.ac-sec { margin-bottom: 11px; }
.ac-sec-l { font-size: 11.5px; color: var(--ink3); margin-bottom: 4px; }
.ac-sec-v { font-size: 13.5px; color: var(--ink2); line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
.ac-sug { background: var(--accent-soft); border-radius: 12px; padding: 10px 12px; font-size: 13px; color: var(--ink); line-height: 1.6; }

/* 空态 */
.empty { margin-top: 40px; text-align: center; padding: 0 20px; }
.empty-t { font-size: 15px; font-weight: 800; color: var(--ink2); margin-bottom: 8px; }
.empty-s { font-size: 12.5px; color: var(--ink3); line-height: 1.7; }
