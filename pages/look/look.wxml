<view class="app" style="--status-h:{{statusH}}px;{{themeStyle}}" bindtouchstart="onSwipeStart" bindtouchend="onSwipeEnd">
  <view class="statusbar-mask"></view>
  <!-- 整页改为页面级滚动（与记页一致）：搜索框等原生输入层由微信同步位置，不再套在 scroll-view 里 -->
  <view class="screen">
    <view class="body" bindtap="clearFloats">
      <!-- 骨架屏：首屏数据未就绪时占位（与记页同一套 .sk 样式），避免空白页闪一下 -->
      <view wx:if="{{!ready}}" class="sk skpage">
        <view class="sk-line sk-w30 sk-sm"></view>
        <view class="sk-box sk-search"></view>
        <view class="sk-row"><view class="sk-line sk-w30"></view><view class="sk-line sk-w30"></view><view class="sk-line sk-w30"></view></view>
        <view class="sk-hr"></view>
        <view class="sk-row"><view class="sk-dot"></view><view class="sk-line sk-w60"></view></view>
        <view class="sk-row"><view class="sk-dot"></view><view class="sk-line sk-w40"></view></view>
        <view class="sk-row"><view class="sk-dot"></view><view class="sk-line sk-w60"></view></view>
        <view class="sk-row"><view class="sk-dot"></view><view class="sk-line sk-w40"></view></view>
        <view class="sk-row"><view class="sk-dot"></view><view class="sk-line sk-w60"></view></view>
      </view>

      <block wx:else>
      <view class="sect-t" id="blk-title">{{filter==='all'?'全部记录':(filterName+' · 记录')}}</view>
      <input id="searchBox" class="search" placeholder="搜索…" value="{{q}}" bindinput="onSearch" confirm-type="search" adjust-position="{{true}}" cursor-spacing="20" always-embed="{{true}}" bindfocus="onSearchFocus" />

      <view class="filters">
        <view class="ft {{filter==='all'?'on':''}}" data-f="all" bindtap="onFilter">全部</view>
        <view wx:for="{{modules}}" wx:key="k" class="ft {{filter===item.k?'on':''}}" data-f="{{item.k}}" bindtap="onFilter">
          <text class="fd" style="background:{{item.c}}"></text>{{item.n}}
        </view>
      </view>

      <!-- 快捷时间选择（待办不展示这一行：见 loadAllTasks——它的查询也不再按时间范围限制） -->
      <view wx:if="{{filter!=='todo'}}" class="ranges">
        <view class="rg {{range==='all'?'on':''}}" data-r="all" bindtap="onRange">全部</view>
        <view class="rg {{range==='today'?'on':''}}" data-r="today" bindtap="onRange">今天</view>
        <view class="rg {{range==='7d'?'on':''}}" data-r="7d" bindtap="onRange">近7天</view>
        <view class="rg {{range==='30d'?'on':''}}" data-r="30d" bindtap="onRange">近30天</view>
      </view>

      <!-- 统计（待办不展示；随记按「类别」数数量，与待办同一口径） -->
      <view class="bars" wx:if="{{!stats.hide}}">
        <view class="sect-t" style="margin:0 0 8px">统计 · {{filter==='all'?'全部':filterName}}</view>
        <view wx:if="{{stats.all}}" class="st-sum">共 <b>{{stats.total}}</b> 条</view>
        <view wx:else class="st-sum">{{stats.lead}}</view>
        <view wx:for="{{stats.bars}}" wx:key="n" class="barrow">
          <view class="bn">{{item.n}}</view>
          <view class="bb"><view class="bf" style="width:{{item.w}};background:{{item.c}}"></view></view>
          <view class="bv">{{item.n2}}</view>
        </view>
        <!-- 占位行：让统计块高度只跟维度有关，换二级筛选（喜恶 / 类别）时不再伸缩（见 _padStats） -->
        <view wx:for="{{stats.pads}}" wx:key="*this" class="barrow pad">
          <view class="bn">占位</view><view class="bb"></view><view class="bv"></view>
        </view>
        <view wx:if="{{stats.extra}}" class="st-ex">{{stats.extra}}</view>
      </view>

      <!-- 待办 · 类别：全部 + 各类别（类别实时取选项池，「✎ 管理」里加新类别后自动多一项） -->
      <view wx:if="{{filter==='todo' && kinds.length}}" class="filters states">
        <view class="ft {{kindFilter==='all'?'on':''}}" data-k="all" bindtap="onKindFilter">全部</view>
        <view wx:for="{{kinds}}" wx:key="*this" class="ft {{kindFilter===item?'on':''}}" data-k="{{item}}" bindtap="onKindFilter">{{item}}</view>
      </view>

      <!-- 待办：看页只作「概览」——可勾选完成，但改 / 删 / 放弃 / 恢复都去清单页做。
           渲染复用公用组件 todo-list；manage=false 关闭「点击出操作条 / 长按就地编辑」 -->
      <!-- manage=true：待办行也支持「点一下出操作条」与「行尾左滑改」（都是进记卡那一条路，
           勾选完成照旧在本页直接勾；放弃 / 恢复仍是本地处理） -->
      <todo-list wx:if="{{tasks.show}}" id="todoList"
        tit="{{tasks.tit}}" sum="{{tasks.sum}}"
        manage="{{true}}" showMn="{{filter==='all' || filter==='todo'}}"
        undone="{{tasks.undone}}" doneGroups="{{tasks.doneGroups}}" abandGroups="{{tasks.abandGroups}}"
        undoneN="{{tasks.undoneN}}" doneN="{{tasks.doneN}}" abandN="{{tasks.abandN}}"
        undoneHide="{{tasks.undoneHide}}" doneHide="{{tasks.doneHide}}" abandHide="{{tasks.abandHide}}"
        bind:check="onRecCheck" bind:longpress="onRowLongPress" bind:swipeleft="onRowSwipe" bind:more="onTaskMore" bind:daymore="onDayMore">
        <!-- 看页只作概览：给一个去清单页管理的入口——落在组件标题行的右端（与「待办」标题同一行、右起） -->
        <view class="tolist-link" bindtap="goList">去清单页管理 ›</view>
      </todo-list>

      <!-- 觉察 · 喜恶：与「可做」的流转状态筛选同一个位置（喜恶是存在 ext 里的细节值，选项取池子） -->
      <view wx:if="{{filter==='obs' && kinds.length}}" class="filters states">
        <view class="ft {{kindFilter==='all'?'on':''}}" data-k="all" bindtap="onKindFilter">全部</view>
        <view wx:for="{{kinds}}" wx:key="*this" class="ft {{kindFilter===item?'on':''}}" data-k="{{item}}" bindtap="onKindFilter">{{item}}</view>
      </view>

      <!-- 随记 · 类别：全部 + 各随记类别（与觉察的喜恶、待办的类别同一套）——
           随记记录走下面的时间线，标题会带上所选类别 -->
      <view wx:if="{{filter==='jot' && kinds.length}}" class="filters states">
        <view class="ft {{kindFilter==='all'?'on':''}}" data-k="all" bindtap="onKindFilter">全部</view>
        <view wx:for="{{kinds}}" wx:key="*this" class="ft {{kindFilter===item?'on':''}}" data-k="{{item}}" bindtap="onKindFilter">{{item}}</view>
      </view>

      <!-- 可以 维度：状态切换 未做 / 在做 / 做了 -->
      <view wx:if="{{filter==='want'}}" class="filters states">
        <view class="ft {{stateFilter==='all'?'on':''}}" data-s="all" bindtap="onStateFilter">全部</view>
        <view class="ft {{stateFilter==='todo'?'on':''}}" data-s="todo" bindtap="onStateFilter">未做</view>
        <view class="ft {{stateFilter==='doing'?'on':''}}" data-s="doing" bindtap="onStateFilter">在做</view>
        <view class="ft {{stateFilter==='done'?'on':''}}" data-s="done" bindtap="onStateFilter">做了</view>
        <view class="ft {{stateFilter==='abandon'?'on':''}}" data-s="abandon" bindtap="onStateFilter">不做</view>
      </view>

      <!-- 时间线 -->
      <block wx:if="{{days.length}}">
        <view wx:for="{{days}}" wx:key="day" wx:for-item="grp">
          <view class="daylab">{{grp.day}}</view>
          <!-- 手势：点一下出操作条 / 左滑进记卡改 / 长按复制（行内横滑优先，见 onRowTouchend） -->
          <view wx:for="{{grp.recs}}" wx:for-item="r" wx:key="id" class="rec tl {{r.desc?'has-desc':''}} {{sel===r.id?'sel':''}}" style="--dot:{{r.c}}" data-id="{{r.id}}" catchtap="onRecTap" bindlongpress="onRowLongPress" bindtouchstart="onRowTouchStart" bindtouchend="onRowTouchend" bindtouchcancel="onRowTouchCancel">
            <view class="edge" style="background:{{r.c}}"></view>
            <view class="hd"><text class="mn" style="color:{{r.c}}">{{r.m}}</text><text wx:if="{{r.doingDays}}" class="tag doing">第{{r.doingDays}}天</text><view class="tvw"><text class="tv">{{r.txt}}</text><text wx:if="{{r.desc}}" class="tdesc">{{r.desc}}</text><text wx:if="{{r.dur}}" class="tdur">{{r.dur}}</text></view><text class="tw">{{r.d}}{{r.t}}</text></view>
            <view wx:if="{{r.from}}" class="from">{{r.from}}</view>
            <view class="dt">
              <text wx:for="{{r.dt}}" wx:for-item="d" wx:key="index" class="it"><text class="k" wx:if="{{d.lbl}}">{{d.lbl}}</text>{{d.v}}</text>
            </view>
          </view>
        </view>
      </block>
      <view wx:if="{{days.length || tasks.show}}" class="loadmore">
        <text wx:if="{{loading}}">加载中…</text>
        <text wx:elif="{{hasMore}}">上拉加载更多</text>
        <text wx:else>— 已经到底了 —</text>
      </view>
      <view wx:elif="{{empty}}" class="empty-mini">没有匹配的记录</view>
      </block>
    </view>
  </view>

  <!-- 记录操作条：与记页共用同一组件，按钮集合/可见性只维护一处 -->
  <rec-actions rec="{{selRec}}" visible="{{sel!=null}}" bind:action="onRecAction" />

  <view wx:if="{{delUndo}}" class="toastline undo-bar">
    <view class="tx">已删除「{{delUndo.txt}}」</view>
    <view class="tb" bindtap="onUndoDel">撤销</view>
  </view>

  <!-- 程序名：按胶囊矩形定位，平时被原生胶囊挡住，下拉时随页面下移才露出来 -->
  <view wx:if="{{brandH}}" class="brand {{brandPlay?'play':''}}" style="position:fixed;top:{{brandTop}}px;left:{{brandLeft}}px;width:{{brandW}}px;height:{{brandH}}px;">
    <text wx:for="{{brandChars}}" wx:key="*this" class="bc">{{item}}</text>
  </view>

  <theme-switcher />
</view>
