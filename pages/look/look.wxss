/* pages/look/look.wxss —— 看页补充样式（其余沿用 app.wxss） */

/* 整页页面级滚动：与记页一致，.app 还原为普通文档流，
   否则 .app 只有固定一屏高，滚出一屏后页面底色露白、背景分层 */
.app { position: static; min-height: 100vh; display: block; }
.screen { height: auto; }
/* 切维度 / 换二级筛（喜恶、类别、状态）时时间线长短会变：给内容一个最小高度，
   短的那份也留出可滚动的余量，页面高度差被收住（不然停在底部会被拉回去，看着像跳）。
   余量要盖住「二级筛那一行以上的高度」——换筛时会把它顶到屏幕顶部，
   页面滚不了那么远就会被夹住、退回显示标题（记录少的筛选项最容易撞上） */
.body { min-height: calc(100vh + 420px); }

/* 首屏骨架屏占位（动画与尺寸沿用 app.wxss 的 .sk* 系列，这里只压一下搜索框那条的高度） */
.skpage { padding-top: 2px; }
.skpage .sk-search { height: 40px; margin-bottom: 10px; }

/* 快捷时间筛选 */
.ranges { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 12px; }
.rg { font-size: 13px; color: var(--ink3); padding: 5px 12px; border-radius: 999px; background: var(--soft); line-height: 1; }
.rg.on { color: #fff; background: var(--accent); }

/* 上拉加载更多 */
/* 维度行：横向滚动，维度多也不换行（换行会把下面整块内容往下顶一截）。
   结构与记页的 .tagrow-wrap 同一套（滚动区 + 两侧渐变提示），但类名分开：
   两处的字号、间距、下边框样式都不同，共用类名就得靠更多的覆盖规则去掰，
   那样改一处会牵动另一处 */
.dimrow-wrap { position: relative; margin: 11px 0 4px; }
.dimrow-scroll { width: 100%; white-space: nowrap; }
.dimrow { display: flex; gap: 10px; align-items: center; flex-wrap: nowrap; }
.dimrow .ft { flex-shrink: 0; }
/* 两端渐变：右侧「右边还有」，左侧「已经往回滚过」（各自独立，见 pageBase.applyScrollFade）。
   上下用 mask 淡出，避免渐变的方角贴到标签的字上 */
.dimrow-fade { position: absolute; top: 0; right: 0; width: 10px; height: 26px; background: linear-gradient(to right, rgba(51,50,45,0), rgba(51,50,45,.10)); pointer-events: none; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 35%, #000 65%, transparent); mask-image: linear-gradient(to bottom, transparent, #000 35%, #000 65%, transparent); }
.dimrow-fade-l { right: auto; left: 0; background: linear-gradient(to left, rgba(51,50,45,0), rgba(51,50,45,.10)); }

.loadmore { text-align: center; color: var(--ink4); font-size: 12px; padding: 14px 0 24px; }

/* 看页待办只作概览：标题行右端给一个「去清单页管理」入口（与左边的「待办」标题同一行）。
   padding-top 16px 是跟着 .sect-t 的上边距走的：这样入口的文字与标题的文字在同一水平线上 */
.tolist-link { font-size: 12.5px; color: var(--accent); text-align: right; padding: 16px 0 2px 6px; }

/* 在做 / 来自 标签 */
.tag.doing { font-size: 11px; color: #fff; background: #C0A05A; padding: 1px 7px; border-radius: 999px; margin-right: 6px; line-height: 1.5; }
.tag.done { font-size: 11px; color: #fff; background: #6E8CB0; padding: 1px 7px; border-radius: 999px; margin-right: 6px; line-height: 1.5; }
.from { font-size: 12px; color: var(--ink4); margin: 2px 0 0 12px; }
/* 用时/历时：紧跟在事件文字后（沿用 from 的文字样式），右侧时间仍靠右 */
.rec .tvw { flex: 1; min-width: 0; display: flex; align-items: baseline; }
.rec .tvw .tv { flex: 0 1 auto; }
.rec .tdur { flex-shrink: 0; font-size: 11.5px; color: var(--ink3); margin-left: 8px; }

/* 「今日」维度的总数行：只有「共 N 条」一个数字，不值得占一张白卡
   （一个数字撑满16px 内边距的卡片，下面还留大片空白）。改成一行轻量文字，
   与上方的筛选栏拉开一点距离即可。 */
.sumline { margin: 14px 2px 2px; font-size: 12.5px; color: var(--ink3); }
.sumline b { color: var(--ink); font-weight: 800; }
