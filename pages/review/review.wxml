<view class="app" style="--status-h:{{statusH}}px;{{themeStyle}}" bindtouchstart="onSwipeStart" bindtouchend="onSwipeEnd">
  <view class="statusbar-mask"></view>
  <!-- 整页页面级滚动（与记 / 看 / 清单 一致）：不再套 scroll-view。
       这样 wx.pageScrollTo（回顶、翻期、切视图）才是真的，原生下拉刷新也走同一套 -->
  <view class="screen">
    <view class="body">
      <!-- 取数失败：给一句说明 + 一个能点的重试 -->
      <block wx:if="{{loadFail}}">
        <view class="loadfail">
          <view class="lft">没加载出来</view>
          <view class="lfr" bindtap="onRetry">点击重试</view>
        </view>
      </block>
      <!-- 骨架屏：首屏数据未就绪时占位（与记 / 看 同一套 .sk 样式） -->
      <block wx:elif="{{!ready}}">
        <view class="sk skpage">
          <view class="sk-line sk-w30 sk-sm"></view>
          <view class="sk-hr"></view>
          <view class="sk-row"><view class="sk-dot"></view><view class="sk-line sk-w60"></view></view>
          <view class="sk-row"><view class="sk-dot"></view><view class="sk-line sk-w40"></view></view>
          <view class="sk-row"><view class="sk-dot"></view><view class="sk-line sk-w60"></view></view>
        </view>
      </block>
      <block wx:else>
      <view class="sect-t">回看</view>

      <!-- AI 回看入口：有最新一份就显示，点开看完整历史 -->
      <view wx:if="{{aiLatest}}" class="ai-entry" bindtap="goAnalysis">
        <view class="ai-e-badge">AI</view>
        <view class="ai-e-l">
          <view class="ai-e-t">AI 回看 · {{aiLatest.dateLabel}} {{aiLatest.weekday}}</view>
          <view class="ai-e-s">{{aiLatest.summary}}</view>
        </view>
        <view class="ai-e-go">›</view>
      </view>

      <!-- 个人画像入口：已生成就显示，点开看完整画像 -->
      <view wx:if="{{profileLatest}}" class="ai-entry" bindtap="goProfile">
        <view class="ai-e-badge prof">像</view>
        <view class="ai-e-l">
          <view class="ai-e-t">个人画像</view>
          <view class="ai-e-s">{{profileLatest.summary}}</view>
        </view>
        <view class="ai-e-go">›</view>
      </view>

      <!-- 周 / 月复盘，以及最后的「全部」（主题档案，全历史） -->
      <view class="filters">
        <view class="ft {{view==='week'?'on':''}}" data-v="week" bindtap="onView">周</view>
        <view class="ft {{view==='month'?'on':''}}" data-v="month" bindtap="onView">月</view>
        <view class="ft {{view==='all'?'on':''}}" data-v="all" bindtap="onView">全部</view>
      </view>

      <!-- ================= 全部：主题档案 =================
           以内容为轴：每一条内容出现多少次、跨多久、按时间怎么分布，展开看它自身的变化 -->
      <block wx:if="{{view==='all'}}">
        <view class="dochead">{{docHead}}</view>
        <view class="filters" style="margin:0 0 9px">
          <view class="ft {{docSort==='n'?'on':''}}" data-s="n" bindtap="onDocSort">最常出现</view>
          <view class="ft {{docSort==='recent'?'on':''}}" data-s="recent" bindtap="onDocSort">最近出现</view>
        </view>

        <view wx:for="{{docs}}" wx:key="txt" wx:for-item="d" wx:for-index="i" class="doc {{d.open?'open':''}}">
          <view class="doc-h" data-i="{{i}}" bindtap="onDocTap">
            <view class="doc-t">{{d.txt}}</view>
            <view wx:if="{{d.hasChange}}" class="doc-tag">变</view>
            <view class="doc-n">{{d.n}} 次</view>
            <view class="doc-chev">▸</view>
          </view>
          <view class="doc-m">
            <view wx:for="{{d.mods}}" wx:for-item="m" wx:key="k" class="doc-mn"><view class="dot" style="background:{{m.c}}"></view>{{m.nm}} {{m.n}}</view>
            <view class="doc-span">{{d.metaTxt}}</view>
          </view>

          <block wx:if="{{d.open}}">
            <view class="doc-sec">
              <view class="doc-sec-l">时间分布</view>
              <view class="heat doc-heat"><i wx:for="{{d.months}}" wx:key="index" class="l{{item.lv}}"></i></view>
            </view>
            <view wx:if="{{d.changes.length}}" class="doc-sec">
              <view class="doc-sec-l">变化</view>
              <view wx:for="{{d.changes}}" wx:for-item="c" wx:key="l" class="doc-chg"><text class="cl">{{c.l}}</text><text class="cv">{{c.v}}</text></view>
            </view>
            <view wx:if="{{d.notes.length}}" class="doc-sec">
              <view class="doc-sec-l">要点</view>
              <view wx:for="{{d.notes}}" wx:for-item="nt" wx:key="index" class="doc-note"><text class="nd">{{nt.d}}</text><text class="nv">{{nt.v}}</text></view>
            </view>
            <view wx:if="{{!d.changes.length && !d.notes.length}}" class="doc-sec doc-dim">这条只有记录，没留下细节</view>
          </block>
        </view>

        <view wx:if="{{docTotal > docs.length}}" class="doc-more" bindtap="onDocMore">显示更多（还有 {{docTotal - docs.length}} 个）</view>
        <view wx:if="{{docTotal===0}}" class="empty-mini">还没有可回看的内容</view>
      </block>

      <!-- ================= 周 / 月复盘 ================= -->
      <block wx:else>
        <view class="revper">
          <view class="revnav" bindtap="onPrev">‹</view>
          <view class="revper-c">
            <view class="revper-l">{{curLabel}}</view>
            <view class="revper-s">{{curRel}} · {{preText}}</view>
          </view>
          <view class="revnav {{offset>=0?'off':''}}" bindtap="onNext">›</view>
        </view>

        <!-- 概览 -->
        <view class="kpis">
          <view wx:for="{{kpis}}" wx:key="l" class="kpi">
            <view class="n">{{item.n}}</view>
            <view class="l">{{item.l}}</view>
            <view wx:if="{{item.s}}" class="s {{item.cls}}">{{item.s}}</view>
          </view>
        </view>

        <!-- 各维度：本期条数 + 与上期的增减 -->
        <view class="bars">
          <view class="sect-t" style="margin:0 0 10px">各维度</view>
          <view wx:for="{{dims}}" wx:key="k" class="barrow">
            <view class="bn">{{item.n}}</view>
            <view class="bb"><view class="bf" style="width:{{item.w}};background:{{item.c}}"></view></view>
            <view class="bv"><text>{{item.v}}</text><text wx:if="{{item.dt}}" class="bd {{item.up?'up':'dn'}}">{{item.dt}}</text></view>
          </view>
        </view>

        <!-- 剩余能量趋势：本期每天一条「今日」的能量（1..5）画折线。没记过的日子断开不补0 -->
        <view wx:if="{{batTrend.has}}" class="bars">
          <view class="sect-t" style="margin:0 0 4px">剩余能量</view>
          <view class="btrend">
            <!-- 横向参考线：1 / 3 / 5 档（0.2 / 0.6 / 1.0） -->
            <view class="bt-g"><view class="bt-gline" style="bottom:20%"></view><view class="bt-gline" style="bottom:60%"></view><view class="bt-gline bt-gtop" style="bottom:100%"></view></view>
            <!-- 折线：相邻有值的点之间画一段（几何在 js 里算好：x0/y0 起点、w 长度、rot 倾角） -->
            <block wx:for="{{batTrend.seg}}" wx:key="k">
              <view class="bt-seg" style="left:{{item.x0}}%;bottom:{{item.y0}}%;width:{{item.w}}rpx;transform:rotate({{item.rot}}deg)"></view>
            </block>
            <!-- 数据点 -->
            <view wx:for="{{batTrend.pts}}" wx:key="i" class="bt-pt" style="left:{{item.pct}}%;bottom:{{item.pct2}}%"></view>
          </view>
          <view class="bt-axis">
            <text>{{batTrend.first}}</text>
            <text>{{batTrend.last}}</text>
          </view>
          <view class="heat-sum">{{batTrend.sum}}</view>
        </view>

        <!-- 本期每天：条数分布 -->
        <view class="bars">
          <view class="sect-t" style="margin:0 0 8px">本期每天</view>
          <view class="heat"><i wx:for="{{trend}}" wx:key="index" class="l{{item.lv}}"></i></view>
          <view class="heat-sum">{{trendSum}}</view>
        </view>

        <!-- 流转：可做（新增 / 做了 / 放弃）、待办（记了 / 完成） -->
        <view class="bars">
          <view class="sect-t" style="margin:0 0 10px">流转</view>
          <view wx:for="{{flow}}" wx:key="l" class="flowrow">
            <view class="bn">{{item.l}}</view>
            <view class="flowit" wx:for="{{item.items}}" wx:for-item="x" wx:key="n"><text class="fl">{{x.n}}</text><text class="fv">{{x.v}}</text></view>
          </view>
        </view>

        <!-- 记得最多的：觉察 / 此刻 / 可做 按内容 Top 3；待办 / 随记 按「类别 + 条数」 -->
        <view class="bars">
          <view class="sect-t" style="margin:0 0 8px">记得最多的</view>
          <view wx:if="{{!tops.length}}" class="empty-mini">本期还没有记录</view>
          <view wx:for="{{tops}}" wx:key="k" wx:for-item="g" class="topg">
            <view class="topg-h"><view class="dot" style="background:{{g.c}}"></view>{{g.n}}</view>
            <view wx:for="{{g.items}}" wx:for-item="it" wx:key="t" class="topi"><view wx:if="{{it.c}}" class="dot" style="background:{{it.c}}"></view><text class="tt">{{it.t}}</text><text class="tn">{{it.n}}</text></view>
          </view>
        </view>
      </block>
      </block>
    </view>
  </view>

  <!-- 程序名：按胶囊矩形定位，平时被原生胶囊盖住，下拉时随页面下移才露出来（与记 / 看 / 清单 同一套） -->
  <view wx:if="{{brandH}}" class="brand {{brandPlay?'play':''}}" style="position:fixed;top:{{brandTop}}px;left:{{brandLeft}}px;width:{{brandW}}px;height:{{brandH}}px;">
    <text wx:for="{{brandChars}}" wx:key="*this" class="bc">{{item}}</text>
  </view>

  <theme-switcher />
</view>
