/* pages/review/review.wxss —— 回看（全部 · 主题档案 / 周 · 月复盘）
   基础卡片（.kpis/.kpi/.bars/.heat/.barrow/.empty-mini）来自 app.wxss，这里补本页特有的 */

/* 整页页面级滚动：与记 / 看 / 清单 一致，.app 还原为普通文档流
   （否则 .app 只有固定一屏高，滚出一屏后页面底色露白、背景分层） */
.app { position: static; min-height: 100vh; display: block; }
.screen { height: auto; }
/* 内容留一个最小高度：本期没什么记录时整页也不会短到滑不动
   （换视图 / 翻期时会先回到顶部，见 review.js 的 onView / onPrev） */
.body { min-height: calc(100vh + 60px); }

/* ================= 全部：主题档案 ================= */
.dochead { font-size: 12px; color: var(--ink3); margin: 8px 0 4px; }
.doc { background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 12px 14px; margin-bottom: 9px; }
.doc-h { display: flex; align-items: baseline; gap: 8px; }
.doc-h .doc-t { flex: 1; min-width: 0; font-size: 14.5px; font-weight: 700; color: var(--ink); word-break: break-word; }
.doc-h .doc-n { flex-shrink: 0; font-size: 12px; color: var(--ink3); font-variant-numeric: tabular-nums; }
.doc-h .doc-tag { flex-shrink: 0; font-size: 10.5px; color: var(--accent); border: 1px solid var(--accent); border-radius: 99px; padding: 0 5px; line-height: 15px; }
.doc-h .doc-chev { flex-shrink: 0; font-size: 11px; color: var(--ink3); transition: transform .18s; }
.doc.open .doc-chev { transform: rotate(90deg); }

.doc-m { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin-top: 4px; }
.doc-mn { display: flex; align-items: center; gap: 4px; font-size: 11.5px; color: var(--ink3); }
.doc-mn .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.doc-span { margin-left: auto; font-size: 11.5px; color: var(--ink4); }

.doc-sec { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); }
.doc-sec-l { font-size: 11.5px; color: var(--ink3); margin-bottom: 5px; }
.doc-heat { margin-top: 0; }
.doc-heat i { height: 16px; }
.doc-chg { display: flex; align-items: baseline; gap: 10px; font-size: 13px; color: var(--ink); padding: 2px 0; }
.doc-chg .cl { flex: 0 0 34px; font-size: 11.5px; color: var(--ink3); }
.doc-chg .cv { flex: 1; min-width: 0; word-break: break-word; }
.doc-note { display: flex; align-items: baseline; gap: 10px; font-size: 12.5px; padding: 2px 0; }
.doc-note .nd { flex-shrink: 0; color: var(--ink3); font-variant-numeric: tabular-nums; }
.doc-note .nv { flex: 1; min-width: 0; color: var(--ink2); word-break: break-word; }
.doc-dim { font-size: 12px; color: var(--ink3); }
/* 命中区补齐：约 34px 高 → 撑到约 44px。只向下扩（上方紧挨着档案卡片，向上扩会抢它的点击） */
.doc-more { text-align: center; font-size: 12.5px; color: var(--accent); padding: 10px 0 2px; position: relative; }
.doc-more::after { content: ''; position: absolute; left: 0; right: 0; top: 0; bottom: -10px; }

/* ================= AI 回看入口 ================= */
.ai-entry { display: flex; align-items: center; gap: 11px; background: var(--accent-soft); border-radius: var(--r-card); padding: 12px 14px; margin: 0 0 12px; }
.ai-e-badge { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.ai-e-badge.prof { background: #B0853A; }   // 个人画像：琥珀色，和 AI 回看的绿色区分
.ai-e-l { flex: 1; min-width: 0; }
.ai-e-t { font-size: 12.5px; font-weight: 700; color: var(--ink); }
.ai-e-s { font-size: 12.5px; color: var(--ink2); margin-top: 2px; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.ai-e-go { flex-shrink: 0; font-size: 18px; color: var(--ink3); }

/* ================= 周 / 月复盘 ================= */

/* 周期切换行：‹ 周期 › */
.revper { display: flex; align-items: center; gap: 10px; margin: 2px 0 2px; }
.revnav { width: 30px; height: 30px; flex: 0 0 30px; border-radius: 50%; background: var(--soft); color: var(--ink2); display: flex; align-items: center; justify-content: center; font-size: 17px; line-height: 1; }
.revnav.off { opacity: .32; }
.revper-c { flex: 1; min-width: 0; text-align: center; }
.revper-l { font-size: 14px; font-weight: 700; color: var(--ink); }
.revper-s { font-size: 11.5px; color: var(--ink3); margin-top: 1px; }

/* 概览卡里的对比行 */
.kpi .s { font-size: 11.5px; color: var(--ink3); margin-top: 3px; }
.kpi .s.up { color: var(--accent); }

/* 维度条：右侧的值 + 增减（覆盖 app.wxss 里给纯数字留的窄宽） */
.barrow .bv { flex: 0 0 auto; display: flex; align-items: baseline; gap: 5px; }
.bd { font-size: 11px; font-weight: 700; font-variant-numeric: tabular-nums; }
.bd.up { color: var(--accent); }
.bd.dn { color: var(--ink3); }

/* 流转：可做 新增/做了/放弃、待办 记了/完成 */
.flowrow { display: flex; align-items: baseline; gap: 10px; margin-bottom: 10px; }
.flowrow:last-child { margin-bottom: 0; }
.flowrow .bn { flex: 0 0 42px; color: var(--ink2); font-size: 12.5px; }
.flowit { display: flex; align-items: baseline; gap: 4px; margin-right: 16px; }
.flowit .fl { font-size: 11.5px; color: var(--ink3); }
.flowit .fv { font-size: 14px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }

/* 高频事项 */
.topg { margin-bottom: 11px; }
.topg:last-child { margin-bottom: 0; }
.topg-h { display: flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 700; color: var(--ink2); margin-bottom: 4px; }
.topg-h .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.topi { display: flex; align-items: baseline; gap: 10px; font-size: 13px; color: var(--ink); padding: 2px 0 2px 15px; }
/* 类别项前面的色点（待办 / 随记按类别统计时带的是类别自己的颜色） */
.topi .dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.topi .tt { flex: 1; min-width: 0; word-break: break-word; }
.topi .tn { color: var(--ink3); font-size: 11.5px; font-variant-numeric: tabular-nums; }

/* ================= 剩余能量趋势（周 / 月） =================
   折线用「绝对定位的细条 + rotate」画：小程序 wxml 没有 svg polyline，这样最省。
   几何（起点 left/bottom、长度 rpx、倾角 deg）全部由 review.js 的 buildPeriod 算好。 */
.btrend { position: relative; height: 72px; margin-top: 12px; }
/* 横向参考线：1 / 3 / 5 档（20% / 60% / 100%），最上面那条是 5 档满格线 */
.bt-g { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.bt-gline { position: absolute; left: 0; right: 0; height: 1px; background: var(--line); }
.bt-gtop { background: var(--line2); }
/* 线段：transform-origin 落在左端，绕起点旋转 */
.bt-seg { position: absolute; height: 2px; border-radius: 1px; background: var(--accent); opacity: .55; transform-origin: left center; }
/* 数据点 */
.bt-pt { position: absolute; width: 8px; height: 8px; margin-left: -4px; margin-bottom: -4px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 2px var(--surface); }
/* x轴两端日期 + 概述 */
.bt-axis { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--ink4); margin-top: 5px; }
