/* 设置页微调 */

/* 整页页面级滚动：与记 / 看 一致，.app 还原为普通文档流，
   否则 .app 只有固定一屏高，滚出一屏后页面底色露白、背景分层 */
.app { position: static; min-height: 100vh; display: block; }
.screen { height: auto; }
.dot { width: 8px; height: 8px; border-radius: 50%; }
.mini-b { font-size: 11.5px; color: var(--ink3); border: 1px solid var(--line2); background: #fff; border-radius: 99px; padding: 4px 11px; }
.mini-b.del { color: var(--danger); border-color: #E5C9C7; }
.gr-row { display: flex; align-items: center; gap: 8px; padding: 8px 2px; border-bottom: 1px solid var(--line); }
.gr-t { flex: 1; font-size: 13px; color: var(--ink); min-width: 0; word-break: break-all; }
.gr-in { flex: 1; min-width: 0; }
.gr-add { font-size: 12.5px; color: var(--accent); padding: 9px 2px; }
.gr-reset { font-size: 12.5px; color: var(--ink3); padding: 11px 2px; border-top: 1px solid var(--line); margin-top: 4px; }
.ta { width: 100%; }
.hint { font-size: 11.5px; color: var(--ink3); }
/* 更新日志 */
.lg-b { margin-bottom: 18px; }
.lg-d { font-size: 12px; font-weight: 800; color: var(--accent); margin-bottom: 5px; letter-spacing: .02em; }
.lg-i { font-size: 13px; color: var(--ink2); line-height: 1.8; }
/* 快捷创建类别勾选 */
.qa-dot { width: 7px; height: 7px; border-radius: 50%; }
.qcpick { display: flex; flex-wrap: wrap; gap: 8px; padding: 4px 2px 2px; }
.qctag { display: inline-flex; align-items: center; font-size: 13px; color: var(--ink2); padding: 7px 13px; border: 1px solid var(--line2); border-radius: 99px; background: #fff; box-sizing: border-box; }
.qctag .qa-dot { margin-right: 6px; }
.qctag.on { color: #fff; background: var(--accent); border-color: var(--accent); }
.qc-hint { font-size: 11.5px; color: var(--ink3); margin: 8px 2px 0; line-height: 1.6; }
/* 主题选择：左边色点 + 名称（点一下即切），右边「常用」勾选（加入右上圆点的循环） */
.th-row { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); }
.th-pick { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; }
.th-swatch { width: 26px; height: 26px; border-radius: 50%; box-shadow: 0 0 0 1px var(--line2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
/* 当前主题：外环换成它自己的主色（内联 style 覆盖上面那条灰环），再加中心白点 */
.th-tick { width: 8px; height: 8px; border-radius: 50%; background: #fff; }
.th-name { font-size: 14px; color: var(--ink); }
.th-name.on { font-weight: 700; color: var(--accent); }
.th-fav { font-size: 11.5px; color: var(--ink3); border: 1px solid var(--line2); background: #fff; border-radius: 99px; padding: 4px 11px; flex-shrink: 0; }
.th-fav.on { color: #fff; background: var(--accent); border-color: var(--accent); }
