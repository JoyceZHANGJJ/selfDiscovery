<view class="app" style="--status-h:{{statusH}}px;{{themeStyle}}">
  <view class="statusbar-mask"></view>
  <!-- 整页页面级滚动（与记 / 看 一致）：不再套 scroll-view -->
  <view class="screen">
    <view class="body">
      <view class="sect-t">设置</view>

      <!-- 问候语轮换 -->
      <view class="srow" bindtap="toggleGreet">
        <view class="sl">问候语轮换</view>
        <view class="sr">{{greetOpen?'▾':'▸'}}</view>
      </view>
      <view wx:if="{{greetOpen}}" class="gwrap open">
        <view class="gbody">
          <view class="sect-t" style="margin:6px 0 8px">白天（5:00–18:00）</view>
          <view wx:for="{{greets.day}}" wx:key="index" class="gr-row">
            <block wx:if="{{geEdit && geEdit.pool==='day' && geEdit.idx===index}}">
              <input class="gr-in mini-in" value="{{geEditVal}}" bindinput="onGeEditInput" adjust-position="{{false}}" cursor-spacing="20" />
              <view class="mini-b" bindtap="confirmGeEdit">保存</view>
              <view class="mini-b" bindtap="cancelGeEdit">取消</view>
            </block>
            <block wx:else>
              <view class="gr-t">{{item}}</view>
              <view class="mini-b" data-pool="day" data-idx="{{index}}" bindtap="editGreet">改</view>
              <view class="mini-b del" data-pool="day" data-idx="{{index}}" bindtap="delGreet">删</view>
            </block>
          </view>
          <view wx:if="{{geNew==='day'}}" class="gr-row">
            <input class="gr-in mini-in" placeholder="新增一句…" value="{{geNewVal}}" bindinput="onGeNewInput" adjust-position="{{false}}" cursor-spacing="20" />
            <view class="mini-b" data-pool="day" bindtap="confirmGeNew">添加</view>
          </view>
          <view wx:else class="gr-add" data-pool="day" bindtap="addGreetTap">＋ 新增一句</view>

          <view class="sect-t" style="margin:14px 0 8px">夜里（18:00–5:00）</view>
          <view wx:for="{{greets.night}}" wx:key="index" class="gr-row">
            <block wx:if="{{geEdit && geEdit.pool==='night' && geEdit.idx===index}}">
              <input class="gr-in mini-in" value="{{geEditVal}}" bindinput="onGeEditInput" adjust-position="{{false}}" cursor-spacing="20" />
              <view class="mini-b" bindtap="confirmGeEdit">保存</view>
              <view class="mini-b" bindtap="cancelGeEdit">取消</view>
            </block>
            <block wx:else>
              <view class="gr-t">{{item}}</view>
              <view class="mini-b" data-pool="night" data-idx="{{index}}" bindtap="editGreet">改</view>
              <view class="mini-b del" data-pool="night" data-idx="{{index}}" bindtap="delGreet">删</view>
            </block>
          </view>
          <view wx:if="{{geNew==='night'}}" class="gr-row">
            <input class="gr-in mini-in" placeholder="新增一句…" value="{{geNewVal}}" bindinput="onGeNewInput" adjust-position="{{false}}" cursor-spacing="20" />
            <view class="mini-b" data-pool="night" bindtap="confirmGeNew">添加</view>
          </view>
          <view wx:else class="gr-add" data-pool="night" bindtap="addGreetTap">＋ 新增一句</view>

          <view class="qc-hint">写新句子时别点名具体时刻（「早晨」「正午」「天黑透」「今晚」）：白天是 5:00–18:00、夜里是 18:00–5:00，写死了落到这个时段的其它时间就对不上；也别断言天气（改成「…的话」）。</view>
          <view class="gr-reset" bindtap="resetGreet">恢复默认问候语</view>
        </view>
      </view>

      <!-- 外观 · 主题：点色点即切换（整站立即生效）；勾「常用」＝加入右上圆点的循环，最多 5 个 -->
      <view class="sect-t" style="margin-top:18px">外观</view>
      <view class="srow" bindtap="openTheme">
        <view class="sl">主题</view>
        <view class="sv">{{themeName}} · 常用 {{favCount}}/{{favMax}} ▸</view>
      </view>

      <!-- 快捷创建：点「＋」球时平铺哪些类别（待办类别 + 随记类别），上限见 store.QUICKCATS_MAX -->
      <view class="sect-t" style="margin-top:18px">快捷创建</view>
      <view class="srow"><view class="sl">点「＋」球时显示的类别</view><view class="sv">{{quickCount}}/{{quickMax}}</view></view>
      <view class="qcpick">
        <view wx:for="{{quickOpts}}" wx:key="key" class="qctag {{item.on?'on':''}}" data-k="{{item.key}}" bindtap="onQuickToggle">
          <view class="qa-dot" style="background:{{item.c}}"></view>{{item.n}}
        </view>
      </view>
      <view class="qc-hint">从「待办类别 + 随记类别」里选，最多 {{quickMax}} 个（面板里多了会自动换行）。新增类别去记页相应维度的「✎ 管理」。</view>

      <!-- 数据 -->
      <view class="sect-t" style="margin-top:18px">数据</view>
      <view class="srow"><view class="sl">导出全部记录</view><view class="sr" bindtap="onExport">复制</view></view>
      <view class="srow"><view class="sl">导入记录</view><view class="sr" bindtap="onImportTap">粘贴</view></view>
      <view class="srow"><view class="sl">清空所有记录</view><view class="sr danger" bindtap="onClear">清空</view></view>

      <!-- 自定义标签：设置页只列出已有的自定义维度（可移除），不再展示节标题与「新增维度」入口。
           新增维度的浮层与逻辑（onAddDimTap / confirmDim）都还在，要恢复入口把那行 srow 加回来即可。
           没有自定义维度时整块不渲染（原来那句「还没有自定义维度」是配合新增入口的，入口没了就没意义了） -->
      <view wx:if="{{dims.length}}" style="margin-top:18px">
        <view wx:for="{{dims}}" wx:key="k" class="srow">
          <view class="sl"><view class="dot" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:{{item.c}};margin-right:8px"></view>{{item.n}}</view>
          <view class="sv">自定义 · {{item.opt}} 个选项</view>
          <view class="mini-b del" data-k="{{item.k}}" bindtap="delDim">移除</view>
        </view>
      </view>

      <!-- 关于 -->
      <view class="sect-t" style="margin-top:18px">关于</view>
      <view class="srow"><view class="sl">选项池</view><view class="sv">{{optGroups}} 组 · {{optCount}} 个</view></view>
      <view class="srow"><view class="sl">数据位置</view><view class="sv">云开发数据库</view></view>
      <view class="srow" bindtap="openLog"><view class="sl">更新日志</view><view class="sv">最近 {{logLatest}} ▸</view></view>
    </view>
  </view>

  <!-- 导入浮层 -->
  <view wx:if="{{importOverlay}}" class="sheet">
    <view class="sh-h"><view class="st">导入记录</view><view class="sx" bindtap="closeImport">✕</view></view>
    <view class="sh-sub">粘贴导出的文本，一行一条</view>
    <view class="sh-list">
      <textarea class="ta" adjust-position="{{false}}" cursor-spacing="20" style="width:100%;min-height:180px;border:1px solid var(--line);border-radius:12px;padding:10px 12px;font-size:13px;line-height:1.6;background:var(--soft);color:var(--ink);box-sizing:border-box" value="{{importText}}" bindinput="onImportInput" maxlength="-1" placeholder="日期 时间 | 维度 | 内容 | 细节（细节用顿号分隔）"></textarea>
      <view class="hint" style="font-size:11.5px;color:var(--ink3);padding:6px 0">只新增，不覆盖已有记录。</view>
    </view>
    <view class="sh-foot">
      <view class="btn gh" bindtap="closeImport">取消</view>
      <view class="btn" bindtap="doImport">导入</view>
    </view>
  </view>

  <!-- 新增维度浮层 -->
  <view wx:if="{{dimOverlay}}" class="sheet">
    <view class="sh-h"><view class="st">新增维度</view><view class="sx" bindtap="confirmDim">✓</view></view>
    <view class="sh-sub">维度会顺次排在后面，带一个内容选项池和一个补充输入框</view>
    <view class="sh-list">
      <input class="mini-in" placeholder="维度名称，如「运动」" value="{{dimName}}" bindinput="onDimName" adjust-position="{{false}}" cursor-spacing="20" />
      <view class="themes" style="margin-top:14px;justify-content:flex-start">
        <view wx:for="{{colors}}" wx:key="*this" class="th {{dimColor===item?'on':''}}" data-c="{{item}}" bindtap="onDimColor"><i style="background:{{item}}"></i></view>
      </view>
    </view>
    <view class="sh-foot"><view class="btn" bindtap="confirmDim">新增</view></view>
  </view>

  <!-- 右上圆点的主题切换器：给它一个 id，主题面板里切完顺手把它的名称也同步过去 -->
  <theme-switcher id="themeSw" />

  <!-- 更新日志浮层 -->
  <view wx:if="{{logOverlay}}" class="sheet">
    <view class="sh-h"><view class="st">更新日志</view><view class="sx" bindtap="closeLog">✕</view></view>
    <view class="sh-sub">按时间倒序，记录每次功能升级</view>
    <view class="sh-list">
      <view wx:for="{{logs}}" wx:key="d" class="lg-b">
        <view class="lg-d">{{item.d}}</view>
        <view wx:for="{{item.items}}" wx:for-item="x" wx:key="index" class="lg-i">· {{x}}</view>
      </view>
      <view wx:if="{{logs.length===0}}" class="sh-empty">还没有更新记录</view>
    </view>
    <view class="sh-foot"><view class="btn gh" bindtap="closeLog">关闭</view></view>
  </view>

  <!-- 主题浮层：点色点即切换（整站立即生效）；右侧「常用」勾选＝加入右上圆点的循环，最多 favMax 个 -->
  <view wx:if="{{themeOverlay}}" class="sheet">
    <view class="sh-h"><view class="st">主题</view><view class="sx" bindtap="closeTheme">✕</view></view>
    <view class="sh-sub">点一下即切换；勾「常用」＝加入右上圆点的切换循环，最多 {{favMax}} 个</view>
    <view class="sh-list">
      <view wx:for="{{themeOpts}}" wx:key="k" class="th-row">
        <view class="th-pick" data-k="{{item.k}}" bindtap="onThemePick">
          <view class="th-swatch" style="background:{{item.c}};{{item.on?'box-shadow:0 0 0 2px '+item.c:''}}">
            <view wx:if="{{item.on}}" class="th-tick"></view>
          </view>
          <view class="th-name {{item.on?'on':''}}">{{item.n}}</view>
        </view>
        <view class="th-fav {{item.fav?'on':''}}" data-k="{{item.k}}" bindtap="onFavToggle">{{item.fav?'常用 ✓':'＋ 常用'}}</view>
      </view>
      <view class="qc-hint">「常用」决定右上圆点在哪些主题之间循环（按这里的排列顺序）；一个都不勾时回到全部 {{themeOpts.length}} 个。</view>
    </view>
    <view class="sh-foot"><view class="btn gh" bindtap="closeTheme">完成</view></view>
  </view>
</view>
