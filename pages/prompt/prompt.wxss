/* pages/prompt/prompt.wxss —— 提示词管理 + 试跑
   基础布局（.app / .screen / .body / .sect-t / .btn / .mini-in）来自 app.wxss，
   这里只补本页特有的：tab 栏、槽位行、版本行、输入卡片、结果节点树、历史行 */

/* 两个 tab（管理 / 试跑）。与管理内容无关，所以固定在最上面。 */
.mtabs { display: flex; gap: 8px; margin: 8px 0 12px; }
.mtab { flex: 1; text-align: center; font-size: 14px; color: var(--ink2); background: #fff; border: 1px solid var(--line); border-radius: 99px; padding: 8px 0; }
.mtab.on { color: #fff; background: var(--accent); border-color: var(--accent); font-weight: 700; }

.app { position: static; min-height: 100vh; display: block; }
.screen { height: auto; }
.body { min-height: calc(100vh + 60px); }

/* 子页头部：返回 + 标题（与 AI 回看页 / 选项页同一套 .bk 风格） */
.a-hd { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
.a-hd .bk { flex-shrink: 0; font-size: 15px; color: var(--ink2); padding: 4px 2px; }
.a-hd .a-tt { font-size: 17px; font-weight: 800; color: var(--ink); }

.hint { font-size: 12px; color: var(--ink3); margin: -2px 0 10px; }

/* 类型切换（与 AI 回看页同一套胶囊语言） */
.atabs { display: flex; gap: 8px; margin-bottom: 6px; }
.atab { flex: 1; text-align: center; font-size: 13px; color: var(--ink2); background: #fff; border: 1px solid var(--line); border-radius: 99px; padding: 6px 0; }
.atab.on { color: #fff; background: var(--accent); border-color: var(--accent); font-weight: 700; }

.qhint { font-size: 11.5px; color: var(--ink3); line-height: 1.65; margin: 4px 0 0; }

/* 输入卡片 */
.card { background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 13px 14px; margin-top: 12px; }
.c-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.c-t { font-size: 14px; font-weight: 800; color: var(--ink); }
.c-clear { font-size: 12px; color: var(--ink3); padding: 3px 6px; }

.ta { width: 100%; box-sizing: border-box; min-height: 130px; background: var(--soft); border: 1px solid var(--line); border-radius: 10px; padding: 9px 10px; font-size: 13px; line-height: 1.7; color: var(--ink); }

/* 开关行：整段替换 vs 追加 */
.swrow { display: flex; align-items: flex-start; gap: 9px; margin: 11px 0 10px; }
.sw { flex-shrink: 0; width: 40px; height: 23px; border-radius: 99px; background: var(--line); margin-top: 1px; position: relative; transition: background .18s; }
.sw .swd { position: absolute; top: 2px; left: 2px; width: 19px; height: 19px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.18); transition: transform .18s; }
.sw.on { background: var(--accent); }
.sw.on .swd { transform: translateX(17px); }
.swx { flex: 1; min-width: 0; }
.swt { font-size: 13px; font-weight: 700; color: var(--ink); }
.swd2 { font-size: 11.5px; color: var(--ink3); line-height: 1.6; margin-top: 2px; }

.lb { margin-top: 2px; }

.btn.run { margin-top: 12px; }
.btn.dis { opacity: .55; }
.btn.copy { margin-top: 12px; }

.err { margin-top: 12px; font-size: 12.5px; color: #B4544E; background: rgba(180,84,78,.07); border-left: 3px solid #B4544E; border-radius: 0 8px 8px 0; padding: 8px 10px; line-height: 1.6; }

/* 「用了哪版」：从 .meta 表格里拎出来单放。
   原因：原来它跟「耗时 / 模型」并排，值又是整段提示词原文，视觉上分不清
   哪部分是系统自带的规则、哪部分是你自己加的，越看越像「系统怎么这麼乱」。
   拆成醒目的标签 + 单独一块原文后，一眼就清楚。 */
.ver { background: #fff; border: 1px solid var(--line); border-left: 3px solid var(--ink3); border-radius: 0 var(--r-card) var(--r-card) 0; padding: 9px 12px; margin-top: 10px; }
.ver.on { border-left-color: var(--accent); }
.ver-t { font-size: 12.5px; font-weight: 700; color: var(--ink); }
.ver.on .ver-t { color: var(--accent); }
.ver-n { font-size: 11.5px; color: var(--ink3); margin-top: 3px; line-height: 1.6; }

/* 你追加 / 替换的那段原文：单独开一块，标清「这是你写的」，避免和系统规则混淆 */
.rules-box { background: var(--soft, #F7F5F1); border: 1px solid var(--line); border-radius: var(--r-card); padding: 9px 12px; margin-top: 6px; }
.rules-h { font-size: 11px; color: var(--ink3); }
.rules-b { font-size: 12.5px; color: var(--ink2); line-height: 1.75; margin-top: 4px; white-space: pre-wrap; word-break: break-word; }

/* 结果的元信息（喂了多少、耗时、模型） */
.meta { background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 10px 12px; margin-top: 10px; }
.meta-r { display: flex; gap: 8px; font-size: 12px; line-height: 1.6; padding: 2px 0; }
.meta-k { flex-shrink: 0; width: 62px; color: var(--ink3); }
.meta-v { flex: 1; min-width: 0; color: var(--ink2); word-break: break-word; }

/* 节点树：路径 + 值。调提示词时要看清每个字段返回了什么形状，所以一字段一行 */
.nodes { margin-top: 8px; }
.node { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 8px 11px; margin-bottom: 6px; }
.np { font-size: 11px; color: var(--accent); word-break: break-all; }
.nt { font-size: 13px; color: var(--ink2); line-height: 1.7; margin-top: 2px; white-space: pre-wrap; word-break: break-word; }

/* 历史行 */
.hrow { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 10px 12px; margin-bottom: 7px; }
.hrow.open { border-color: var(--accent); }
.hr-l { flex: 1; min-width: 0; }
.hr-t { display: flex; align-items: baseline; gap: 7px; }
.hr-k { flex-shrink: 0; font-size: 13px; font-weight: 800; color: var(--ink); }
.hr-time { font-size: 12px; color: var(--ink2); min-width: 0; word-break: break-word; }
.hr-d { font-size: 11px; color: var(--ink3); margin-top: 2px; }
.hr-del { flex-shrink: 0; width: 26px; height: 26px; text-align: center; line-height: 26px; font-size: 13px; color: var(--ink3); border-radius: 99px; background: var(--soft); }

/* ===== 提示词管理 =====
   槽位行做成「可点的卡片」而不是设置项那种一列开关：每一条本身内容较长
   （名字 + 说明 + 字数），横向排布会挤成两行，所以左信息右数字。 */
.prow { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 11px 13px; margin-bottom: 7px; }
.pr-l { flex: 1; min-width: 0; }
.pr-t { font-size: 13.5px; font-weight: 700; color: var(--ink); display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
.pr-v { font-size: 11.5px; font-weight: 400; color: var(--ink3); }
/* 「已改过」是中性提示、「未接入」是弱化——两者都不该抢注意力 */
.pr-ed { font-size: 10.5px; font-weight: 400; color: var(--accent); background: rgba(47,143,123,.10); border-radius: 99px; padding: 1px 6px; }
.pr-re { font-size: 10.5px; font-weight: 400; color: var(--ink3); background: var(--soft, #F7F5F1); border-radius: 99px; padding: 1px 6px; }
.pr-d { font-size: 11.5px; color: var(--ink3); line-height: 1.6; margin-top: 3px; }
.pr-n { flex-shrink: 0; font-size: 11.5px; color: var(--ink3); }

/* 加载骨架：复用 app.wxss 的 .sk-line（动画、圆角都现成）。
   但灰条要压在**白底卡片**上，而 --soft 只比白深一档，对比太弱、几乎看不见。
   所以这里按 profile / persona 页的既有做法压一层半透明黑——天然跟着卡片底色走。 */
.skrow { align-items: flex-start; }
.skrow .sk-line, .skline-only .sk-line { background: rgba(0, 0, 0, .06); }
.skrow .sk-line::after, .skline-only .sk-line::after { background: linear-gradient(90deg, transparent, rgba(255,255,255,.7), transparent); }
.skline-only { background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 12px 13px; margin-bottom: 7px; }

/* 历史版本行 */
.vrow { background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 10px 12px; margin-bottom: 7px; }
.vrow.open { border-color: var(--accent); }
.vr-h { display: flex; align-items: center; gap: 10px; }
.vr-l { flex: 1; min-width: 0; }
.vr-t { font-size: 13px; font-weight: 700; color: var(--ink); }
.vr-note { font-size: 11.5px; font-weight: 400; color: var(--ink2); margin-left: 5px; word-break: break-word; }
/* 基线标记：出厂默认那版永远不会被清掉，得一眼能认出来 */
.vr-base { display: inline-block; font-size: 10px; font-weight: 700; color: var(--accent); border: 1px solid var(--accent); border-radius: 99px; padding: 0 6px; margin-left: 5px; vertical-align: 1px; }
.vr-d { font-size: 11px; color: var(--ink3); margin-top: 2px; }
/* 「切回」做成描边小按钮而不是纯文字：它会改掉正在生效的内容，得像个体操 */
.vr-x { flex-shrink: 0; font-size: 12px; color: var(--ink2); border: 1px solid var(--line); border-radius: 99px; padding: 4px 11px; }

/* 契约层正文：等宽 + 弱化，让它一眼看出「这是只读的规格说明，不是要改的东西」 */
.rules-b.contract { font-family: var(--font-mono, monospace); font-size: 11.5px; color: var(--ink3); }

/* 「设为线上生效」用描边而不是实心——它动的是线上，但不像「删除」那么重，
   也不该和「保存并生效」（本页最重的操作）抢视觉重心。 */
.btn.adopt { margin-top: 12px; background: transparent; color: var(--accent); border: 1px solid var(--accent); }
.qhint.live { margin-top: 6px; }