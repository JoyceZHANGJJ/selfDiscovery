<view class="app" style="--status-h:{{statusH}}px;{{themeStyle}}">
  <view class="statusbar-mask"></view>
  <view class="screen">
    <view class="body">
      <view class="a-hd">
        <view class="bk" bindtap="onClose">‹ 返回</view>
        <view class="a-tt" bindtap="onTitleTap">提示词</view>
      </view>

      <!-- 两个 tab：管理 / 试跑。
           试跑是开发调试用的，默认**不露出入口**：它一次要真调大模型、花额度，
           误点进去的人只看到一堆 JSON，还以为出了错。改成连点标题 5 次才进（见 onTitleTap）。
           真进了试跑之后 tab 才显示——否则没有回来的路。 -->
      <view wx:if="{{tab==='test'}}" class="mtabs">
        <view class="mtab {{tab==='manage'?'on':''}}" data-v="manage" bindtap="onTabTap">提示词</view>
        <view class="mtab on" data-v="test" bindtap="onTabTap">试跑</view>
      </view>

      <!-- ============ 提示词管理 ============ -->
      <block wx:if="{{tab==='manage'}}">
        <view class="hint">改完<text style="font-weight:700">保存即生效</text>，不用再上传部署云函数。旧版自动留成历史，随时能切回来。</view>

        <view wx:if="{{plErr}}" class="err">提示词读不到：{{plErr}}</view>

        <!-- 加载中：先给骨架，别先说「还没有提示词槽位」。
             云函数这一来一回通常要一秒多，那一秒里屏幕是空的，
             用户会以为是自己没配过，或者以为页面坏了。 -->
        <block wx:if="{{plLoading}}">
          <view wx:for="{{skRows}}" wx:key="*this" class="prow skrow">
            <view class="pr-l">
              <view class="sk-line sk-w60"></view>
              <view class="sk-line sk-sm sk-w40" style="margin-top:7px"></view>
            </view>
            <view class="sk-line sk-sm" style="width:44px"></view>
          </view>
        </block>

        <block wx:else>
        <block wx:for="{{groups}}" wx:key="group" wx:for-item="g">
          <view class="sect-t">{{g.name}}</view>
          <view wx:if="{{g.group==='preset'}}" class="qhint" style="margin:-2px 0 8px">这几条不会自己生效——它们是备用的附加指令：用的时候把正文复制到上面某个槽位的末尾（或粘到「试跑」里的追加框）。</view>
          <view wx:for="{{g.slots}}" wx:key="slot" wx:for-item="s"
                class="prow" data-slot="{{s.slot}}" bindtap="openSlot">
            <view class="pr-l">
              <view class="pr-t">{{s.name}} <text class="pr-v">v{{s.rev}}</text><text wx:if="{{s.edited}}" class="pr-ed">已改过</text><text wx:if="{{s.state==='opt'}}" class="pr-re">不自动生效</text></view>
              <view class="pr-d">{{s.desc}}</view>
            </view>
            <view class="pr-n">{{s.chars}} 字 ›</view>
          </view>
        </block>
        <view wx:if="{{!plErr && !groups.length}}" class="qhint">还没有提示词槽位。</view>
        </block>

        <!-- 一键全部恢复：放在列表读完的位置，不放顶部。
             它一次改掉所有被改过的槽位，是本页破坏性最大的操作，得让人先看完清单再决定。
             editedCount 是唯一判据——一个都没改过时不该弹确认框（见 resetAllDefault 注释）。 -->
        <view wx:if="{{!plLoading && editedCount > 0}}" class="sect-t" style="margin-top:20px">全部恢复</view>
        <view wx:if="{{!plLoading && editedCount > 0}}" class="card">
          <view class="c-h">
            <view class="c-t">恢复出厂默认</view>
            <view class="c-clear" bindtap="resetAllDefault">{{resetting?'恢复中…':'一键全部恢复'}}</view>
          </view>
          <view class="qhint" style="margin-top:0">
            当前有 <text style="font-weight:700">{{editedCount}}</text> 个提示词被你改过。
            点右边会把它们<text style="font-weight:700">全部</text>换回内置版本——每个旧版都会留成历史，需要的话还能逐个切回来。
          </view>
        </view>
        <view wx:if="{{!plLoading && editedCount === 0 && groups.length}}" class="qhint">
          所有提示词都还是出厂默认，没有需要恢复的。
        </view>

        <!-- 打开一个槽位后的编辑区 -->
        <block wx:if="{{cur}}">
          <view class="ver on" style="margin-top:18px">
            <view class="ver-t">{{cur.name}} <text style="font-weight:400">· v{{cur.rev}}</text></view>
            <view class="ver-n">{{cur.edited?'这一版被你改过（改于v' + cur.rev + '）':'还是出厂默认的内容'}}</view>
          </view>
          <view class="qhint">{{cur.desc}}</view>

          <view class="card">
            <view class="c-h">
              <view class="c-t">提示词正文</view>
              <view class="c-clear" bindtap="resetDefault">恢复默认</view>
            </view>
            <textarea class="ta" auto-height adjust-position="{{false}}" cursor-spacing="20"
                      maxlength="-1" value="{{cur.body}}" bindinput="onBodyInput"
                      placeholder="写你要用的提示词。例：&#10;【硬性】不要用「可能」「也许」这类词下判断。"></textarea>
            <input class="mini-in lb" placeholder="这次为什么改（选填，会留在历史版本里）"
                   value="{{saveNote}}" bindinput="onNoteInput" adjust-position="{{false}}" cursor-spacing="20" />
            <view class="btn run {{saving?'dis':''}}" bindtap="save">{{saving?'保存中…':'保存并生效'}}</view>
            <view class="qhint">保存后立即生效，不会影响已经生成好的回看与画像（那些已经写进库里了）。</view>
          </view>

          <!-- 输出字段契约：只读，不给改 -->
          <view class="card" wx:if="{{cur.contract}}">
            <view class="c-h" bindtap="onContractTap">
              <view class="c-t">模型要返回的字段（只读）</view>
              <view class="c-clear">{{showContract?'收起':'展开'}}</view>
            </view>
            <view class="qhint" style="margin-top:0">这是和代码配套的字段结构，<text style="font-weight:700">不能改</text>——改了模型返回的名字程序接不住，页面会显示不出来。要改结构得改代码。</view>
            <view wx:if="{{showContract}}" class="rules-box" style="margin-top:8px">
              <view class="rules-b contract">{{cur.contract}}</view>
            </view>
          </view>

          <!-- 历史版本 -->
          <view class="sect-t" style="margin-top:18px">历史版本</view>
          <view wx:if="{{verErr}}" class="err">{{verErr}}</view>
          <view wx:elif="{{!vers.length}}" class="qhint">还没有历史版本——出厂默认不算「旧版」，你改第一次之后就有了。</view>
          <view wx:for="{{vers}}" wx:key="rev" wx:for-item="v" wx:for-index="i"
                class="vrow {{verIdx===i?'open':''}}">
            <view class="vr-h" data-i="{{i}}" bindtap="openVer">
              <view class="vr-l">
                <view class="vr-t">v{{v.rev}} <text wx:if="{{v.note}}" class="vr-note">{{v.note}}</text><text wx:if="{{v.base}}" class="vr-base">基线</text></view>
                <view class="vr-d">{{v.time}} · {{v.chars}} 字</view>
              </view>
              <view class="vr-x" data-i="{{i}}" catchtap="revertVer">切回</view>
            </view>
            <view wx:if="{{verIdx===i}}" class="rules-box" style="margin-top:8px">
              <view class="rules-b contract">{{verBody}}</view>
            </view>
          </view>
          <view wx:if="{{vers.length}}" class="qhint" style="margin-top:8px">只保留最近 {{verKeep}} 个版本（出厂默认那一版永久保留）；更早的会被自动清掉。</view>

          <view class="btn gh" bindtap="closeSlot">关闭</view>
        </block>
        <view wx:if="{{curErr}}" class="err">{{curErr}}</view>
      </block>

      <!-- ============ 试跑 ============ -->
      <block wx:else>
      <view class="hint">用你的真实记录跑一次，<text style="font-weight:700">不会动</text>正式的回看与画像——放心改。满意了可以一键设为线上生效。</view>

      <!-- 类型 -->
      <view class="atabs">
        <view wx:for="{{types}}" wx:key="k"
              class="atab {{type===item.k?'on':''}}" data-k="{{item.k}}" bindtap="onTypeTap">
          {{item.n}}
        </view>
      </view>
      <view class="qhint">画像 = 在现有画像基础上增量；深度报告 = 全部历史记录重算；日 / 周 / 月 / 年 = 最近一个已结束的周期。</view>
      <view wx:if="{{curLive.has}}" class="qhint live">当前线上生效的是 <text style="font-weight:700">{{curLive.name}} v{{curLive.rev}}</text>。不填提示词直接跑 = 拿这一版做基线，用来和改完的版本对比。</view>

      <!-- 提示词输入 -->
      <view class="card">
        <view class="c-h">
          <view class="c-t">提示词</view>
          <view class="c-clear" bindtap="onClearInput">清空</view>
        </view>
        <textarea class="ta" auto-height adjust-position="{{false}}" cursor-spacing="20"
                  maxlength="-1" value="{{rules}}" bindinput="onRulesInput"
                  placeholder="写要试的那一段。例：&#10;【硬性】actions 里的「执行时机」必须写出具体钟点（如 21:30），不要写「晚上」。"></textarea>

        <view class="swrow" bindtap="onOverrideTap">
          <view class="sw {{override?'on':''}}"><view class="swd"></view></view>
          <view class="swx">
            <view class="swt">{{override?'整段替换':'追加到线上规则后面'}}</view>
            <view class="swd2">{{override?'线上那套规则全部丢掉，只保留任务说明与输出结构——适合从零试一版新的。':'保留线上那一版，把你写的接在最后。模型对结尾的指令更敏感，新要求压得住旧要求。'}}</view>
          </view>
        </view>

        <input class="mini-in lb" placeholder="备注（选填）：这一版想试什么" value="{{label}}" bindinput="onLabelInput" adjust-position="{{false}}" cursor-spacing="20" />

        <view class="btn run {{running?'dis':''}}" bindtap="run">{{running?'跑着…':'跑一次'}}</view>
        <view class="qhint">不填提示词直接跑 = 拿线上那版做基线，用来和改完的版本对比。每次都会花一次模型额度。</view>
      </view>

      <view wx:if="{{errText}}" class="err">{{errText}}</view>

      <!-- 本次结果 -->
      <block wx:if="{{lastResult}}">
        <view class="sect-t" style="margin-top:18px">本次结果</view>
        <view class="ver {{lastResult.ver.ver==='线上原版（基线）'?'':'on'}}">
          <view class="ver-t">用了哪版：{{lastResult.ver.ver}}</view>
          <view class="ver-n">{{lastResult.ver.note}}</view>
        </view>
        <view wx:if="{{lastResult.ver.used}}" class="rules-box">
          <view class="rules-h">你追加 / 替换的原文</view>
          <view class="rules-b">{{lastResult.ver.used}}</view>
        </view>
        <view class="meta">
          <view wx:for="{{lastResult.meta}}" wx:key="k" class="meta-r">
            <view class="meta-k">{{item.k}}</view><view class="meta-v">{{item.v}}</view>
          </view>
        </view>
        <view class="nodes">
          <view wx:for="{{lastResult.nodes}}" wx:key="path" class="node">
            <view class="np">{{item.path}}</view>
            <view class="nt">{{item.text}}</view>
          </view>
        </view>
        <view wx:if="{{!lastResult.nodes.length}}" class="qhint">模型返回了空内容。</view>
        <view wx:if="{{lastResult.canAdopt}}" class="btn adopt" bindtap="adoptTest"
              data-id="{{lastResult._id}}" data-type="{{lastResult.type}}">设为线上生效</view>
        <view wx:elif="{{lastResult}}" class="qhint">这是拿线上那版跑的基线，没改提示词，所以没什么可采纳的。</view>
      </block>

      <!-- 历史 -->
      <view class="sect-t" style="margin-top:18px">历史试跑 <text style="font-weight:400;color:var(--ink3);font-size:11.5px">（留着对比哪一版更好）</text></view>
      <view wx:if="{{listErr}}" class="err">历史读不到：{{listErr}}</view>
      <view wx:elif="{{listLoading}}" class="skline-only">
        <view class="sk-line sk-w40" style="height:11px"></view>
        <view class="sk-line sk-w60" style="height:11px"></view>
        <view class="sk-line sk-w30" style="height:11px"></view>
      </view>
      <view wx:elif="{{!list.length}}" class="qhint">还没有试跑记录。</view>
      <view wx:for="{{list}}" wx:key="_id" wx:for-item="a" wx:for-index="i"
            class="hrow {{detailIdx===i?'open':''}}" data-i="{{i}}" bindtap="onItemTap">
        <view class="hr-l">
          <view class="hr-t">
            <text class="hr-k">{{a.type==='persona'?'画像':a.type==='profile'?'深度报告':a.type==='day'?'日回看':a.type==='week'?'周回看':a.type==='month'?'月回看':'年回看'}}</text>
            <text class="hr-time">{{a.label || ''}}</text>
          </view>
          <view class="hr-d">{{a.overrideRules?'替换版':'追加/基线'}} · {{a.records}} 条 · {{a.ms}}ms · {{a.temperature}}</view>
        </view>
        <view class="hr-del" data-i="{{i}}" catchtap="onDel" aria-label="删除">✕</view>
      </view>

      <!-- 展开的一条 -->
      <block wx:if="{{detail}}">
        <view class="ver {{detail.ver.ver==='线上原版（基线）'?'':'on'}}">
          <view class="ver-t">用了哪版：{{detail.ver.ver}}</view>
          <view class="ver-n">{{detail.ver.note}}</view>
        </view>
        <view wx:if="{{detail.ver.used}}" class="rules-box">
          <view class="rules-h">你追加 / 替换的原文</view>
          <view class="rules-b">{{detail.ver.used}}</view>
        </view>
        <view class="meta">
          <view wx:if="{{detail.label}}" class="meta-r"><view class="meta-k">备注</view><view class="meta-v">{{detail.label}}</view></view>
          <view wx:for="{{detail.meta}}" wx:key="k" class="meta-r">
            <view class="meta-k">{{item.k}}</view><view class="meta-v">{{item.v}}</view>
          </view>
        </view>
        <view class="nodes">
          <view wx:for="{{detail.nodes}}" wx:key="path" class="node">
            <view class="np">{{item.path}}</view>
            <view class="nt">{{item.text}}</view>
          </view>
        </view>
        <view wx:if="{{!detail.nodes.length}}" class="qhint">这一条的结果是空的。</view>
        <view wx:if="{{detail.canAdopt}}" class="btn adopt" bindtap="adoptTest"
              data-id="{{detail._id}}" data-type="{{detail.type}}">设为线上生效</view>
        <view wx:else class="qhint">这次没改提示词（是基线试跑），可以忽略这个按钮。</view>
        <view class="btn gh copy" bindtap="copyResult">复制这份结果</view>
      </block>
      </block>
    </view>
  </view>
</view>