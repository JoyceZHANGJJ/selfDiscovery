/* pages/list/list.wxss —— 复用 app.wxss 全局类（.app/.screen/.body/.rec.list/.filters/.btn/.mini-in 等），
   这里只补本页自己的样式；待办就地编辑的浮层在 components/inline-editor 里 */

/* 整页页面级滚动：与记页一致，.app 还原为普通文档流，
   否则 .app 只有固定一屏高，滚出一屏后页面底色露白、背景分层 */
.app { position: static; min-height: 100vh; display: block; }
.screen { height: auto; position: relative; }

.ehint { font-size: 11.5px; color: var(--ink3); margin: -5px 0 9px; }

/* 快捷新增：一张独立小卡片（列表是轴线行，它是带边框/底色的块，层次一眼分开）。
   位置仍在筛选与列表之间，上下留白拉开距离 */
.qadd {
  display: flex; flex-direction: column; gap: 9px;
  margin: 12px 0 16px; padding: 10px;
  background: var(--surface, #fff); border: 1px solid var(--line2, #E2DCD1); border-radius: 14px;
  box-shadow: 0 4px 14px rgba(35,35,31,.05);
}
.qadd-row { display: flex; align-items: center; }
/* 非全部模式下，目标模块药丸（描边 + 同色文字/圆点；--mc 由页面按 备忘 / 购物 传进来） */
.qadd-m {
  display: flex; align-items: center; flex-shrink: 0; margin-right: 8px;
  font-size: 12.5px; color: var(--mc, #55524A); padding: 5px 10px;
  border: 1px solid var(--mc, #E2DCD1); border-radius: 999px;
}
.qadd-dot { width: 7px; height: 7px; border-radius: 50%; margin-right: 5px; }
/* 全部模式下平铺的可勾选类别（与「＋」球面板同一套 chip 样式） */
.qa-dot { width: 7px; height: 7px; border-radius: 50%; margin-right: 5px; flex-shrink: 0; }
.qa-chips { white-space: nowrap; width: 100%; }
.qa-chip { display: inline-flex; align-items: center; font-size: 12.5px; color: var(--ink2); padding: 5px 11px; border: 1px solid var(--line2); border-radius: 99px; margin-right: 8px; background: #fff; box-sizing: border-box; }
.qa-chip.on { color: #fff; background: var(--accent); border-color: var(--accent); }
/* 输入框沿用记页那套 mini-in 的手感：平时是柔和底色、聚焦才亮边框 */
.qadd-in {
  flex: 1; min-width: 0; height: 34px; line-height: 34px; border: 1px solid transparent;
  border-radius: 10px; padding: 0 11px; font-size: 14px; font-family: inherit; background: var(--soft);
  box-sizing: border-box; caret-color: var(--accent);
}
.qadd-in:focus { background: var(--surface, #fff); border-color: var(--accent); box-shadow: var(--ring); }
.qadd-go { flex-shrink: 0; font-size: 13.5px; font-weight: 700; color: var(--ink3); padding: 8px 0 8px 12px; }
.qadd-go.on { color: var(--accent); }
