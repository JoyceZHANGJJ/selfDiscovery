<view class="app" style="--status-h:{{statusH}}px;{{themeStyle}}" bindtouchstart="onSwipeStart" bindtouchend="onSwipeEnd">
  <view class="statusbar-mask"></view>
  <!-- 整页页面级滚动（与记页一致）：输入框不套在 scroll-view 内，避免安卓上光标/文字飘出去 -->
  <view class="screen">
    <view class="body" bindtap="onBodyTap">
      <view class="sect-t">{{tit}}</view>
      <view wx:if="{{sum}}" class="tsum">{{sum}}</view>
      <view wx:if="{{show}}" class="ehint">长按任意一条即可就地修改或删除</view>

      <!-- 区分：全部（待办）/ 各待办类别（来自选项池，「✎ 管理」里加新类别后自动多一项）/ 随记 -->
      <view class="filters">
        <view wx:for="{{segs}}" wx:key="k" class="ft {{seg===item.k?'on':''}}" data-s="{{item.k}}" bindtap="onSeg">
          <text wx:if="{{item.c}}" class="fd" style="background:{{item.c}}"></text>{{item.n}}
        </view>
      </view>

      <!-- 快捷新增：独立小卡片（和下面轴线式的待办行分层），位置仍在筛选与列表之间。
           回车即记下、可连着加；筛了具体类别 / 随记时目标跟筛走，筛「全部」时平铺可勾选的类别供直接点选 -->
      <view class="qadd" style="--mc:{{qaC}}">
        <scroll-view wx:if="{{seg==='all'}}" class="qa-chips" scroll-x="{{true}}" enhanced show-scrollbar="{{false}}" bindtouchstart="onChipsTouch">
          <view wx:for="{{qaCats}}" wx:key="key" class="qa-chip {{qaKey===item.key?'on':''}}" data-k="{{item.key}}" bindtap="onQaChip">
            <view class="qa-dot" style="background:{{item.c}}"></view>
            <text>{{item.n}}</text>
          </view>
        </scroll-view>
        <view class="qadd-row">
          <input class="qadd-in" placeholder="{{qaPh}}" value="{{qaTxt}}" bindinput="onQaInput" bindconfirm="onQaSave" confirm-type="done" adjust-position="{{true}}" cursor-spacing="24" always-embed="{{true}}" id="qadd" />
          <view class="qadd-go {{qaTxt ? 'on' : ''}}" bindtap="onQaSave">记下</view>
        </view>
      </view>

      <block wx:if="{{show}}">
        <!-- 随记：平铺列表（没有待完成 / 已完成 / 已放弃那套，也没有完成勾选）；
             行只负责显示，就地改 / 删由长按与操作条负责，和待办共用同一个 inline-editor -->
        <block wx:if="{{seg==='jot'}}">
          <view wx:for="{{jots}}" wx:key="id" id="erow-{{item.id}}" class="rec list tl {{edId===item.id?'blank':''}} {{sel===item.id?'sel':''}}" style="--dot:{{item.c}}" data-id="{{item.id}}" catchtap="onRecTap" bindlongpress="onLongPress" bindtouchend="onRowTouchend" bindtouchcancel="onRowTouchend">
            <view class="edge" style="background:{{item.c}}"></view>
            <view class="hd"><text class="tv">{{item.txt}}</text><text class="tw">{{item.t}}</text></view>
          </view>
          <view wx:if="{{jotHide}}" class="moreline" data-k="j" bindtap="onMore">显示更多（还有 {{jotHide}} 条）</view>
        </block>

        <!-- 待办清单（待完成 / 已完成 / 已放弃）：抽成公用组件 todo-list，清单页与看页共用同一份渲染；
             交互（勾选 / 选中 / 长按 / 展开）通过事件回传页面处理 -->
        <todo-list wx:if="{{seg!=='jot'}}" id="todoList"
          tit="{{tit}}" sum="{{sum}}"
          sel="{{sel || ''}}" edId="{{edId}}" showMn="{{seg==='all'}}"
          undone="{{undone}}" doneGroups="{{doneGroups}}" abandGroups="{{abandGroups}}"
          undoneN="{{undoneN}}" doneN="{{doneN}}" abandN="{{abandN}}"
          undoneHide="{{undoneHide}}" doneHide="{{doneHide}}" abandHide="{{abandHide}}"
          bind:check="onCheck" bind:select="onRecTap" bind:longpress="onLongPress"
          bind:touchend="onRowTouchend" bind:more="onMore" bind:daymore="onDayMore" />
      </block>

      <view wx:if="{{empty}}" class="empty-mini">{{seg==='jot' ? '还没有随记' : '还没有备忘或购物记录'}}</view>
    </view>

    <!-- 待办就地编辑：与记页 / 看页共用同一个组件 -->
    <inline-editor visible="{{editing}}" focus="{{edFocus}}" rect="{{ed}}" value="{{edTxt}}" bind:save="onEditSave" bind:del="onEditDel" />

    <!-- 记录操作条：点条目出（放弃 / 恢复 / 改 / 删除）；勾选框仍然是完成，两者互不干扰 -->
    <rec-actions rec="{{selRec}}" visible="{{sel!=null}}" bind:action="onRecAction" />
  </view>

  <!-- 删除撤销（与记 / 看页同一套） -->
  <view wx:if="{{delUndo}}" class="toastline undo-bar">
    <view class="tx">已删除「{{delUndo.txt}}」</view>
    <view class="tb" bindtap="onUndoDel">撤销</view>
  </view>
</view>
