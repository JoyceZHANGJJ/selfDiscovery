<view class="app" style="{{themeStyle}}">
  <view class="body">
    <view class="sect-t">外观 · 主题</view>
    <view class="th-sub">点一下即切换（整站立即生效）；勾「常用」＝加入右上圆点的切换循环，最多 {{favMax}} 个</view>

    <view wx:for="{{themeOpts}}" wx:key="k" class="th-row">
      <view class="th-pick" data-k="{{item.k}}" bindtap="onThemePick">
        <view class="th-swatch" style="background:{{item.c}};{{item.on?'box-shadow:0 0 0 2px '+item.c:''}}">
          <view wx:if="{{item.on}}" class="th-tick"></view>
        </view>
        <view class="th-name {{item.on?'on':''}}">{{item.n}}</view>
      </view>
      <view class="th-fav {{item.fav?'on':''}}" data-k="{{item.k}}" bindtap="onFavToggle">{{item.fav?'常用 ✓':'＋ 常用'}}</view>
    </view>

    <view class="th-hint">「常用」决定右上圆点在哪些主题之间循环（按这里的排列顺序）；一个都不勾时回到全部 {{themeOpts.length}} 个。</view>
  </view>
</view>
