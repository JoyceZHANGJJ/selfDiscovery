/* 记页面样式全部沿用 app.wxss 的共享类，这里仅做微调 */

/* 整页改为页面级滚动：.app 从「固定视口 + 内部 scroll-view」还原为普通文档流，
   页面滚动时微信会同步原生输入层位置，安卓上光标/文字飘出输入框的问题从根上消失 */
.app { position: static; min-height: 100vh; display: block; }
.screen { height: auto; }
/* 记卡区：顶部留白与改结构前一致（status-h + 46px），底部不留额外间距，
   记卡与「最近」的间距交回给卡片自身的 margin-bottom(22px) + 小节标题 margin-top(16px) */
.body-page { padding: calc(var(--status-h, 20px) + 46px) 14px 0; }
/* 程序名（.brand / .bc / .play）样式已提到 app.wxss，记页与看页共用 */

/* 列表跟随页面滚动，不再单独限高（限高会在内容不足时留下大片空白） */
.listpane { height: auto; }
.body-list { padding: 0 14px calc(64px + env(safe-area-inset-bottom, 0px)); }
.composer .big-in { margin-top: 10px; }
.composer .extra:first-child { margin-top: 14px; }
/* 记卡底部：按钮行（.sbbtns）+ 「已记入 …」确认条（.sbline，就在按钮下方）。
   确认条属于记卡的一部分（不再浮在屏幕底部），所以它出现时记卡撑开、消失后收回；
   吸底块整体高度跟着变，但底边始终吸在 bottom:barBottom 处，所以按钮会往上让出这一行 */
.savebar.sticky { display: block; }
.sbbtns { display: flex; align-items: center; gap: 10px; }
.sbline { margin-top: 10px; }
.mini-b { font-size: 11.5px; color: var(--ink3); border: 1px solid var(--line2); background: #fff; border-radius: 99px; padding: 4px 11px; }
.mini-b.del { color: var(--danger); border-color: #E5C9C7; }

/* 编辑态：修改创建时间 */
.etime { display: flex; align-items: center; gap: 10px; margin: 14px 0 2px; font-size: 12px; color: var(--ink3); }
.etime .ql { flex-shrink: 0; }
.etime .ev { display: inline-flex; align-items: center; }
.etime .evv { padding: 4px 11px; border: 1px solid var(--line2); border-radius: 99px; background: var(--surface); color: var(--ink2); font-size: 12.5px; font-variant-numeric: tabular-nums; }
.etime .evv::after { content: '▾'; font-size: 9px; margin-left: 6px; color: var(--ink4); }

/* 在看/记两页共用卡片布局：用时/历时紧跟事件文字后（与看页一致） */
.rec .tvw { flex: 1; min-width: 0; display: flex; align-items: baseline; }
.rec .tvw .tv { flex: 0 1 auto; }
.rec .tdur { flex-shrink: 0; font-size: 11.5px; color: var(--ink3); margin-left: 8px; }
/* 在做：第 N 天 标签（与看页一致） */
.tag.doing { font-size: 11px; color: #fff; background: #C0A05A; padding: 1px 7px; border-radius: 999px; margin-right: 6px; line-height: 1.5; }

/* 「已删除 …」撤销条（浮在屏幕上，与记卡无关）：记页有吸底的「记下 / 保存修改」操作行
   （bottom 58px + 自身约 58px 高），所以这里要从全局的 66px 再抬高一层，否则会压在按钮上。
   注：「已记入 …」那条不在这里——它排进记卡内部、跟着记卡一起收放（见上面的 .sbline） */
.undo-bar { bottom: calc(122px + env(safe-area-inset-bottom, 0px)); }
