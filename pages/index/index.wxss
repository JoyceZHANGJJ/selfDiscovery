/* 记页面样式全部沿用 app.wxss 的共享类，这里仅做微调 */

/* 整页改为页面级滚动：.app 从「固定视口 + 内部 scroll-view」还原为普通文档流，
   页面滚动时微信会同步原生输入层位置，安卓上光标/文字飘出输入框的问题从根上消失 */
.app { position: static; min-height: 100vh; display: block; }
.screen { height: auto; }
/* 记卡区：顶部留白与改结构前一致（status-h + 46px），底部不留额外间距，
   记卡与「最近」的间距交回给卡片自身的 margin-bottom(22px) + 小节标题 margin-top(16px) */
.body-page { padding: calc(var(--status-h, 20px) + 46px) 14px 0; }
/* 程序名（.brand / .bc / .play）样式已提到 app.wxss，记页与看页共用 */

/* 列表跟随页面滚动，不再单独限高（限高会在内容不足时留下大片空白），
   但要留一个最小高度：「最近 / 待办 / 已完成」三段的条数不一样（10 / 3 / 10），
   不留的话整页会随列表长短伸缩——短的那段整页刚好装得下就「滑不动」了，
   停在底部时还会被拉回去，看着像记卡在上下跳。
   （高度与列表长度挂钩：长的那段由内容撑开，短的这段由 min-height 兜住，两段页高接近） */
.listpane { height: auto; min-height: calc(100vh - 200px); }
.body-list { padding: 0 14px calc(64px + env(safe-area-inset-bottom, 0px)); }
/* 「最近 / 已完成」切换：标题位上的两个词（选中的加深 + 主题色下划线），不额外加控件 */
.rectabs .rt { font-size: 13px; font-weight: 800; color: var(--ink4); margin-right: 16px; padding-bottom: 2px; border-bottom: 2px solid transparent; }
.rectabs .rt.on { color: var(--ink); border-bottom-color: var(--accent); }
/* 最近列表的手势提示：点一下出操作条 / 左滑直接改 / 长按复制（与清单页同一套小字） */
.qhint { font-size: 11.5px; color: var(--ink3); margin: -5px 0 9px; }
.composer .big-in { margin-top: 10px; }
.composer .extra:first-child { margin-top: 6px; }
/* 待办 / 随记：「类别 / 优先级 / 计划完成」各组的组距与其他维度统一（.extra 的 16px）；
   只有紧跟维度标签行的第一组保持贴紧（间距全部来自 .tagrow 的 12px + 4px，
   和非纯输入型模块的「什么事 / 归类」那一行同款紧），所以仅 first-child 去掉组距 */
.composer .extra.cattop { margin-top: 16px; }
/* 第一组（类别 / 维度首行）紧贴维度条：.composer 里 .extra 从不是 :first-child
   （前面恒有问候行 greet-row 与维度条 tagrow-wrap），所以 first-child 规则在这里命不中。
   改用相邻选择器，让 plain 模块（待办 / 随记 / 占卜 / 书·剧）的首组与维度条的距离，
   和 non-plain 模块（觉察 / 此刻）主项紧贴维度条一致（间距只来自 .tagrow 的 8px） */
.tagrow-wrap + .extra.cattop { margin-top: 0; }
/* 今日的三件套——剩余能量 / 心情指数 / 能量说明输入框——是一个组：
   组内三段间距（维度条→能量行、能量行→心情行、心情行→输入框）统一 10px
   （输入框那段的 10px 来自 .composer .big-in，正好同口径）。
   这两行是 graph 量，用 .gextra 与待办等模块「类别→优先级」的 16px 组距区分开：
   它们不是两组，是同组里挨着的三行 */
.composer .extra.cattop.gextra { margin-top: 10px; }
/* 记卡底部：按钮行（.sbbtns）+ 「已记入 …」确认条（.sbline，就在按钮下方）。
   确认条属于记卡的一部分（不再浮在屏幕底部），所以它出现时记卡撑开、消失后收回；
   吸底块整体高度跟着变，但底边始终吸在 bottom:barBottom 处，所以按钮会往上让出这一行 */
.savebar.sticky { display: block; }
.sbbtns { display: flex; align-items: center; gap: 10px; }
.sbline { margin-top: 10px; }
/* 命中区补齐：约 23px 高 → 撑到约 39px（上下 8px 与行间距对齐，左右 4px；不改药丸的视觉） */
/* .mini-b 已收敛到 app.wxss（与设置页同一款，含命中区扩展） */

/* 编辑态：修改创建时间 */
.etime { display: flex; align-items: center; gap: 10px; margin: 14px 0 2px; font-size: 12px; color: var(--ink3); }
.etime .ql { flex-shrink: 0; }
.etime .ev { display: inline-flex; align-items: center; }
.etime .evv { padding: 4px 11px; border: 1px solid var(--line2); border-radius: 99px; background: var(--surface); color: var(--ink2); font-size: 12.5px; font-variant-numeric: tabular-nums; }
.etime .evv::after { content: '▾'; font-size: 9px; margin-left: 6px; color: var(--ink4); }

/* 在看/记两页共用卡片布局：用时/历时紧跟事件文字后（与看页一致） */
.rec .tvw { flex: 1; min-width: 0; display: flex; align-items: baseline; }
.rec .tvw .tv { flex: 0 1 auto; }
.rec .tdur { flex-shrink: 0; font-size: 11.5px; color: var(--ink3); margin-left: 8px; }
/* 在做：第 N 天 标签（与看页一致） */
.tag.doing { font-size: 11px; color: #fff; background: #C0A05A; padding: 1px 7px; border-radius: 999px; margin-right: 6px; line-height: 1.5; }

/* 一行式字段（准确率）：标题在左，短输入框在右，单位紧贴框右。
   输入框只给 76px —— 它最多三位数，给成整行宽会让人以为里面能写一段话。
   单位用 ink3（和标题同色）：它是标题的一部分，不是输入框的内容。 */
.qrow.inline { align-items: center; margin: 11px 0 0; }
.qrow.inline .ql { flex-shrink: 0; }
.inline-fld { display: flex; align-items: center; gap: 6px; }
.inline-fld .num-in { width: 76px; flex: none; text-align: center; font-variant-numeric: tabular-nums; }
.inline-fld .unit { font-size: 12px; color: var(--ink3); }

/* 「已删除 …」撤销条（浮在屏幕上，与记卡无关）：位置与样式统一由全局 .undo-bar 管——
   现在是屏幕正中的小卡片（带弹出动效 + 实心「撤销」药丸），不再贴底部，也不再各页各调。
   注：「已记入 …」那条不在这里——它排进记卡内部、跟着记卡一起收放（见上面的 .sbline） */
