<view class="app" style="--status-h:{{statusH}}px;{{themeStyle}}" bindtouchstart="onSwipeStart" bindtouchend="onSwipeEnd">
  <view class="statusbar-mask"></view>
  <!-- 整页使用页面级滚动（不再用 scroll-view）：
       页面滚动时微信会同步原生输入层位置，安卓上光标/文字飘出输入框的问题从根上消失 -->
  <view class="screen" bindtap="onBodyTap">
    <view class="body body-page">
      <!-- 骨架屏：数据未就绪时占位，避免首屏空卡片闪动；取数失败时不占位（换下面的重试） -->
      <view wx:if="{{!ready && !loadFail}}" class="composer sk">
        <view class="sk-line sk-w60"></view>
        <view class="sk-line sk-w40 sk-sm"></view>
        <view class="sk-row">
          <view class="sk-dot"></view><view class="sk-line sk-w40"></view>
          <view class="sk-dot"></view><view class="sk-line sk-w40"></view>
          <view class="sk-dot"></view><view class="sk-line sk-w40"></view>
          <view class="sk-dot"></view><view class="sk-line sk-w40"></view>
        </view>
        <view class="sk-box"></view>
        <view class="sk-hr"></view>
        <view class="sk-line sk-w30 sk-sm"></view>
        <view class="sk-btn"></view>
      </view>

      <!-- 取数失败：给一句说明 + 一个能点的重试 -->
      <view wx:elif="{{loadFail}}" class="loadfail">
        <view class="lft">没加载出来</view>
        <view class="lfr" bindtap="onRetry">点击重试</view>
      </view>

      <block wx:else>
      <!-- 输入区（含问候与模块标签，整块卡片）。
           操作行吸底 / 跟随时它脱离文档流，记卡会少一截：这里补回等高的下内边距，
           既让记卡末尾的字段不被操作行盖住，也让「操作行本该在哪」的推算保持稳定 -->
      <view class="composer" style="{{(kbOn||barFollow) ? 'padding-bottom:' + (barH + 16) + 'px' : ''}}" catchtap="noop" id="blk-top">
        <!-- 问候 -->
        <view class="greet-row">
          <view class="greet-wrap">
            <view class="greet">{{greet.t}}</view>
            <view class="greet-sub">{{greet.s}}</view>
          </view>
        </view>

        <!-- 模块标签（横向滚动，维度多也不挤） -->
        <view class="tagrow-wrap">
          <scroll-view class="tagrow-scroll" scroll-x enable-flex enhanced show-scrollbar="{{false}}" bindscroll="onTagScroll" bindtouchstart="onTagTouch">
            <view class="tagrow">
              <view wx:for="{{modules}}" wx:key="k" class="tg {{tag===item.k?'on':''}}" data-k="{{item.k}}" bindtap="onTag">
                <view class="dot" style="background:{{item.c}}"></view>{{item.n}}
              </view>
            </view>
          </scroll-view>
          <!-- 「可滚动」渐变提示：只在标签真的超出、且右侧还有内容时出现（见 checkTagFade） -->
          <view wx:if="{{tagFade}}" class="tagrow-fade"></view>
        </view>

        <!-- 「今日」已填：顶部只读摘要（内容禁填，点整块进编辑）。编辑态不显示。
             用 5 格能量条代替电池图形：一眼看出能量高低，也比小图更好点。
             下方两组表单（plain 分支的剩余能量选择器、else 分支的能量说明+细节）都已隐藏，
             内容由这一块全权代表，不重复占位 -->
        <view wx:if="{{tag==='today' && todayLocked && !editing}}" class="today-locked" bindtap="onTodayEdit">
          <view class="tl-row">
            <text class="tl-lab">剩余能量</text>
            <view class="tl-bar">
              <view wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="tl-cell {{index<todayLocked.lv?'on':''}}"></view>
            </view>
            <!-- 右起显示创建时间：与时间线行同一口径（datePrefix + t），不另造格式 -->
            <text class="tl-when">{{todayLocked.d}}{{todayLocked.t}}</text>
          </view>
          <text wx:if="{{todayLocked.txt}}" class="tl-txt">{{todayLocked.txt}}</text>
          <text wx:else class="tl-txt tl-none">今天还没写能量说明</text>
        </view>

        <!-- 待办 / 随记：纯主输入框（不要主项标题）。
             类别（待办类别 todoKind / 随记类别 jotKind，可从 ✎ 管理 加新类别）摆在输入框**上方**：
             先定类别，再写内容；其余细节行（如待办的「原因」）仍在输入框下方 -->
        <!-- 待办 / 随记 / 今日已填的只读态：都不渲染下方表单。
             「今日」已记过时，内容由上面那块只读摘要（能量条 + 能量说明）全权代表，
             这里再显示一遍「剩余能量」选择器和禁用的输入框就是纯重复、还让人以为能改 -->
        <block wx:if="{{composer.plain && !(tag==='today' && todayLocked && !editing)}}">
          <view wx:for="{{composer.catItems}}" wx:key="index" wx:for-item="it" class="extra cattop">
            <view class="qrow"><view class="ql">{{it.label}}</view><view wx:if="{{it.group!=='todayBat'}}" class="mg" data-g="{{it.group}}" bindtap="onManage" aria-label="管理这一组的选项">✎ 管理</view></view>
            <view class="chips">
              <!-- 「今日」能量：与只读摘要同一套 5 格条（同一个 .tl-bar/.tl-cell 的视觉），只是这里可点。
                   点第 N 格＝选 N 格能量（1 很低 / 2 低 / 3 一般 / 4 较高 / 5 满）。
                   未选时（新建）一格都不亮，必须自己点一下才算选过。
                   cur==当前档位，用 .cur 标出来，方便看清落在哪一格 -->
              <block wx:if="{{it.group==='todayBat'}}">
                <view class="tl-bar ebar">
                  <view wx:for="{{it.opts}}" wx:for-item="o" wx:key="*this"
                        class="tl-cell ebar-cell {{index<it.lv?'on':''}} {{it.cur===o.v?'cur':''}}"
                        data-g="{{it.group}}" data-v="{{o.v}}" bindtap="onChip"
                        hover-class="ebar-cell-hover" hover-stay-time="80"></view>
                </view>
              </block>
              <block wx:else>
                <view wx:for="{{it.opts}}" wx:for-item="o" wx:key="*this" class="chip {{o.on?'on':''}}" data-g="{{it.group}}" data-v="{{o.v}}" bindtap="onChip">
                  <text>{{o.v}}</text>
                </view>
              </block>
            </view>
          </view>
          <!-- 今日的「能量说明」：这句话写长了要能折行、跟着内容自己变高，所以用 textarea（auto-height）——
               其余类别（备忘 / 购物 / 随记）仍是一行的 input：一句话就够，不需要换行。
               注：textarea 没有键盘上的「完成」键（回车＝换行），保存走底部「记下 / 保存修改」 -->
          <textarea wx:if="{{tag==='today'}}" class="big-in plain-in" auto-height placeholder="{{composer.mainPh}}" value="{{composer.mainVal}}" disabled="{{todayLocked && !editing}}" adjust-position="{{true}}" cursor-spacing="{{kbGap}}" id="fldmain" bindinput="onMainInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" bindkeyboardheightchange="onFieldKb"></textarea>
          <input wx:else class="big-in plain-in" placeholder="{{composer.mainPh}}" value="{{composer.mainVal}}" disabled="{{tag==='today' && todayLocked && !editing}}" bindinput="onMainInput" bindconfirm="doSave" confirm-type="done" adjust-position="{{true}}" cursor-spacing="{{kbGap}}" always-embed="{{true}}" id="fldmain" bindfocus="onFieldFocus" bindblur="onFieldBlur" bindkeyboardheightchange="onFieldKb" />
          <view wx:for="{{composer.items}}" wx:key="index" wx:for-item="it" class="extra">
            <view wx:if="{{it.type==='free'}}" class="qrow"><view class="ql">{{it.label}}</view></view>
            <textarea wx:if="{{it.type==='free'}}" class="mini-in" auto-height placeholder="{{it.ph}}" value="{{it.val}}" bindinput="onFreeInput" data-k="{{it.key}}" data-idx="{{index}}" id="fld{{index}}" focus="{{it.type==='free' && index===focusIdx}}" adjust-position="{{true}}" cursor-spacing="{{kbGap}}" bindfocus="onFieldFocus" bindblur="onFieldBlur" bindkeyboardheightchange="onFieldKb"></textarea>
          </view>
        </block>
        <!-- 今日已填且只读：这个分支（能量说明 / 细节·都可跳过）也一并藏掉。
             内容和上方只读摘要完全重复，留着只是让人以为还能改 -->
        <block wx:elif="{{!(tag==='today' && todayLocked && !editing)}}">
        <view class="ehead"><view class="et">{{composer.mainLabel}}</view><view class="mg" data-g="{{composer.main}}" bindtap="onManage" aria-label="管理这一组的选项">✎ 管理</view></view>
        <view wx:if="{{composer.mainOpts.length}}" class="chips">
          <view wx:for="{{composer.mainOpts}}" wx:key="*this" class="chip {{item.on?'on':''}}" data-v="{{item.v}}" bindtap="onMainChip">{{item.v}}</view>
        </view>
        <!-- 归类 / 什么事：都不给主输入框，只从上面的选项池点选（要靠「✎ 管理」增删），
             这样它始终是可归类的名词，不会被写成一整句话。
             可做的文字输入走下面「具体的描述」那个框——只填它时，它就是「事」（见 doSave） -->
        <textarea wx:if="{{composer.mainInput}}" class="big-in" auto-height placeholder="{{composer.mainPh}}" value="{{composer.mainVal}}" bindinput="onMainInput" bindconfirm="doSave" confirm-type="done" adjust-position="{{true}}" cursor-spacing="{{kbGap}}" id="fldmain" bindfocus="onFieldFocus" bindblur="onFieldBlur" bindkeyboardheightchange="onFieldKb"></textarea>

        <!-- 具体的描述：与「归类」配对（点可归类、描述不可归类），自由记录、可跳过，不带标题 -->
        <view wx:if="{{composer.hasDesc}}" class="extra descrow">
          <textarea class="mini-in" auto-height placeholder="{{composer.descPh}}" value="{{composer.descVal}}" bindinput="onDescInput" id="flddesc" adjust-position="{{true}}" cursor-spacing="{{kbGap}}" bindfocus="onFieldFocus" bindblur="onFieldBlur" bindkeyboardheightchange="onFieldKb"></textarea>
        </view>

        <view class="extra-h">细节 · 都可跳过</view>
        <block wx:for="{{composer.items}}" wx:key="index">
        <!-- hide：如「感受」下面的档位——还没选情绪时整行不出现 -->
        <view wx:if="{{!item.hide}}" class="extra {{item.first?'first':''}} {{item.label?'':'nlab'}} {{item.sub?'sub':''}}">
          <!-- 没有标题的项（如档位副行、自由感受输入框）：不渲染标题行，内容紧跟上面的选项。
               档位副行（item.sub）连管理入口也不给——它就是感受的一个强度档位 -->
          <view wx:if="{{!item.sub && (item.label || item.type==='g')}}" class="qrow">
            <view class="ql">{{item.label}}</view>
            <view wx:if="{{item.type==='g'}}" class="mg" data-g="{{item.group}}" bindtap="onManage" aria-label="管理这一组的选项">✎ 管理</view>
          </view>
          <block wx:if="{{item.type==='g' || item.type==='fx'}}">
            <view class="chips">
              <view wx:for="{{item.opts}}" wx:for-item="o" wx:key="*this" class="chip {{o.on?'on':''}}" data-g="{{item.group}}" data-v="{{o.v}}" bindtap="onChip">{{o.v}}</view>
            </view>
            <input wx:if="{{item.type==='g' && !item.noInput}}" class="mini-in" placeholder="{{item.ph}}" value="{{item.typedVal}}" bindinput="onGroupInput" data-g="{{item.group}}" data-idx="{{index}}" confirm-type="done" bindconfirm="onGroupConfirm" adjust-position="{{true}}" cursor-spacing="{{kbGap}}" always-embed="{{true}}" id="fld{{index}}" bindfocus="onFieldFocus" bindblur="onFieldBlur" bindkeyboardheightchange="onFieldKb" />
          </block>
          <textarea wx:if="{{item.type==='free'}}" class="mini-in" auto-height placeholder="{{item.ph}}" value="{{item.val}}" bindinput="onFreeInput" data-k="{{item.key}}" data-idx="{{index}}" id="fld{{index}}" focus="{{item.type==='free' && index===focusIdx}}" adjust-position="{{true}}" cursor-spacing="{{kbGap}}" bindfocus="onFieldFocus" bindblur="onFieldBlur" bindkeyboardheightchange="onFieldKb"></textarea>
        </view>
        </block>
        </block>

        <!-- 编辑时：可修改时间（创建 / 开始 / 结束），默认回填原时间，改了才生效 -->
        <view wx:if="{{editing}}" class="etime">
          <view class="ql">{{editCreateLabel}}</view>
          <!-- 「今日」一日一记：日期上限锁在今天（不能记到未来）；
               改成昨天 / 前几天都允许，只要那天还没记过（保存时校验，见 doSave） -->
          <picker wx:if="{{tag==='today'}}" class="ev" mode="date" value="{{editDate}}" end="{{todayMaxDate}}" bindchange="onEditDate"><view class="evv">{{editDate}}</view></picker>
          <picker wx:else class="ev" mode="date" value="{{editDate}}" bindchange="onEditDate"><view class="evv">{{editDate}}</view></picker>
          <picker class="ev" mode="time" value="{{editTime}}" bindchange="onEditTime"><view class="evv">{{editTime}}</view></picker>
        </view>
        <view wx:if="{{editing && editHasStart}}" class="etime">
          <view class="ql">开始时间</view>
          <picker class="ev" mode="date" value="{{editStartDate}}" bindchange="onEditStartDate"><view class="evv">{{editStartDate}}</view></picker>
          <picker class="ev" mode="time" value="{{editStartTime}}" bindchange="onEditStartTime"><view class="evv">{{editStartTime}}</view></picker>
        </view>
        <view wx:if="{{editing && editHasEnd}}" class="etime">
          <view class="ql">结束时间</view>
          <picker class="ev" mode="date" value="{{editEndDate}}" bindchange="onEditEndDate"><view class="evv">{{editEndDate}}</view></picker>
          <picker class="ev" mode="time" value="{{editEndTime}}" bindchange="onEditEndTime"><view class="evv">{{editEndTime}}</view></picker>
        </view>
        <view wx:if="{{editing && editHasAbandon}}" class="etime">
          <view class="ql">放弃时间</view>
          <picker class="ev" mode="date" value="{{editAbandonDate}}" bindchange="onEditAbandonDate"><view class="evv">{{editAbandonDate}}</view></picker>
          <picker class="ev" mode="time" value="{{editAbandonTime}}" bindchange="onEditAbandonTime"><view class="evv">{{editAbandonTime}}</view></picker>
        </view>
        <!-- 已放弃的待办：不给「放弃时间」输入框，只标一行状态（与列表里的「放弃 · HH:MM」口径一致） -->

        <!-- 操作行吸底：胶囊卡片再长（编辑态字段多）也能随时点到「记下 / 保存修改 / 取消」。
             bottom 由页面按键盘高度/底部 tab 栏算好传进来；
             键盘弹着（kbOn）或「跟着输入框」（barFollow）时再加 .kb，改成真 fixed；
             记下后的提示条是这个吸底块的最后一行（就在按钮下方），
             所以它出现时记卡跟着撑开、消失后收回。
             「今日」已填且只读时整条不渲染：上方摘要块已经写清内容、点它就能进编辑，
             这里再挂一个占满宽度的「修改」既重复又抢眼 -->
        <view wx:if="{{!(tag==='today' && todayLocked && !editing)}}" class="savebar sticky {{(kbOn||barFollow)?'kb':''}}" id="savebar" style="bottom:{{barBottom}}">
          <view class="sbbtns">
            <view class="btn" bindtap="doSave">{{editing?'保存修改':'记下'}}</view>
            <view wx:if="{{editing}}" class="btn gh" bindtap="onEditCancel">取消</view>
          </view>
          <!-- 记下后的确认条：写清记进了哪个模块（觉察会带上喜恶）。
               待办给「撤销」（随手一句，容易打错），其它维度给「改一下」（逐项填过的，回编辑态改） -->
          <view wx:if="{{saveUndo}}" class="toastline sbline">
            <view class="tx">已记入{{saveUndo.name}}「{{saveUndo.txt}}」</view>
            <view wx:if="{{saveUndo.task}}" class="tb" bindtap="onUndoSaved">撤销</view>
            <view wx:else class="tb" bindtap="onEditSaved">改一下</view>
          </view>
        </view>
      </view>
      </block>
    </view>
  </view>

  <!-- 最近列表：跟随页面滚动（不再单独限高，避免内容不足时底部留一大块空白）。
       这一块上左右滑动切换「最近 / 待办 / 已完成」：用标记法（不 catch），
       让根节点的手势识别跳过这次触摸——既不会误切上面的维度，也不影响页面滚动 -->
  <view class="screen listpane" bindtouchstart="onListSwipeStart" bindtouchend="onListSwipeEnd">
    <view class="body body-list" bindtap="onBodyTap">
      <!-- 「最近 / 待办 / 已完成」：标题位上的几个词就是开关（选中的加深 + 主题色下划线），都只列 10 条 -->
      <view class="sect-t rectabs">
        <text class="rt {{recentTab==='recent'?'on':''}}" data-k="recent" catchtap="onRecentTab">最近</text>
        <text class="rt {{recentTab==='todo'?'on':''}}" data-k="todo" catchtap="onRecentTab">待办</text>
        <text class="rt {{recentTab==='done'?'on':''}}" data-k="done" catchtap="onRecentTab">已完成</text>
      </view>
      <!-- 手势提示：三个手势都看不见，列出来省得靠猜（有记录时才占位） -->
      <view wx:if="{{ready && recent.length}}" class="qhint">点一下出操作条 · 长按复制 · 行尾左滑直接改</view>
      <view wx:if="{{!ready}}">
        <view class="sk-rec"></view>
        <view class="sk-rec"></view>
      </view>
      <view wx:if="{{ready && recent.length===0}}" class="empty-mini">{{recentEmpty}}</view>
      <!-- id 用 erow-<id>：就地编辑器（inline-editor）按它量取这一行的位置（见 _openQ）。
           手势：点一下出操作条 / 长按复制 / 左滑就地改（行内横滑优先，见 onRowTouchend） -->
      <view wx:for="{{recent}}" wx:key="id" id="erow-{{item.id}}" class="rec tl {{item.task?'list':''}} {{item.longTxt?'long':''}} {{item.desc?'has-desc':''}} {{recSel===item.id?'sel':''}} {{item.done?'done':''}} {{qeId===item.id?'blank':''}}" style="--dot:{{item.c}}" data-id="{{item.id}}" catchtap="onRecentTap" bindlongpress="onRecentLongPress" bindtouchstart="onRowTouchStart" bindtouchend="onRowTouchend" bindtouchcancel="onRowTouchCancel">
        <view class="edge" style="background:{{item.c}}"></view>
        <view class="hd">
          <view wx:if="{{item.task}}" class="ck {{item.done?'on':''}}" data-id="{{item.id}}" catchtap="onRecCheck"></view>
          <text class="mn" style="color:{{item.c}}">{{item.m}}</text>
          <text wx:if="{{item.doingDays}}" class="tag doing">第{{item.doingDays}}天</text>
          <!-- 「今日」一日一记：**能量格是主项**（与记页只读摘要 / 看页卡片同一套 5 格条），
               那句话是附属内容、挪到下面「能量说明」那一行（见下面的 .dt） -->
          <view wx:if="{{item.bat}}" class="tvw">
            <text class="tl-lab">剩余能量</text>
            <view class="tl-bar">
              <!-- wx:for-item="c" 必须写：这一层嵌在 recent 的循环里，
                   不改名的话内层会把外层的 item 顶掉，item.bat.lv 就取不到了（格子全不亮） -->
              <view wx:for="{{[0,1,2,3,4]}}" wx:for-item="c" wx:key="*this" class="tl-cell {{index<item.bat.lv?'on':''}}"></view>
            </view>
          </view>
          <view wx:else class="tvw"><text class="tv">{{item.txt}}</text><text wx:if="{{item.desc}}" class="tdesc">{{item.desc}}</text><text wx:if="{{item.dur}}" class="tdur">{{item.dur}}</text></view>
          <view wx:if="{{item.task}}" class="twr"><text class="twx">{{item.reason || item.usefor}}</text><text wx:if="{{item.reason || item.usefor}}" class="twd">·</text><text class="twt">{{item.tt}}</text></view>
          <text wx:else class="tw">{{item.d}}{{item.t}}</text>
        </view>
        <!-- 「今日」：附属内容＝能量说明那句话（没写就不占这一行——只留能量格是正常的） -->
        <view wx:if="{{item.bat}}" class="dt">
          <text wx:if="{{item.txt}}" class="it"><text class="k">能量说明</text>{{item.txt}}</text>
        </view>
        <view wx:elif="{{!item.task}}" class="dt">
          <text wx:for="{{item.dt}}" wx:for-item="d" wx:key="index" class="it"><text class="k" wx:if="{{d.lbl}}">{{d.lbl}}</text>{{d.v}}</text>
        </view>
        <view wx:if="{{item.done}}" class="done-at">{{item.doneLabel}}</view>
      </view>
    </view>
  </view>

  <!-- 记录操作条（选中记录后出现）：记页与看页共用一套组件，按钮集合/可见性只维护一处 -->
  <rec-actions rec="{{recSelRec}}" visible="{{recSel!=null}}" bind:action="onRecAction" />

  <!-- 删除撤销 -->
  <view wx:if="{{delUndo}}" class="toastline undo-bar">
    <view class="tx">已删除「{{delUndo.txt}}」</view>
    <view class="tb" bindtap="onUndoDel">撤销</view>
  </view>

  <!-- 程序名：按胶囊矩形定位，平时被原生胶囊挡住，下拉时随页面下移才露出来 -->
  <view wx:if="{{brandH}}" class="brand {{brandPlay?'play':''}}" style="position:fixed;top:{{brandTop}}px;left:{{brandLeft}}px;width:{{brandW}}px;height:{{brandH}}px;">
    <text wx:for="{{brandChars}}" wx:key="*this" class="bc">{{item}}</text>
  </view>

  <!-- 就地编辑（待办 / 随记：改这一句话 + 删除）：与清单 / 看页共用同一个组件。
       最近里行上「左滑」即弹出（见 index.js 的 onRowTouchend → swipeEdit）；长按是复制 -->
