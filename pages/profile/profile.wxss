/* pages/profile/profile.wxss —— 个人画像
   基础布局（.app / .screen / .body / .sect-t / .sk / .loadfail / .empty）沿用 app.wxss，
   这里补本页的头部、刷新按钮与各画像区块。视觉语言与 AI 回看页（analysis.wxss）一致。 */

.app { position: static; min-height: 100vh; display: block; }
.screen { height: auto; }
.body { min-height: calc(100vh + 60px); }

/* 子页头部：返回 + 标题（与 options 页 .bk 同一套风格）
   注意：标题栏右侧不放操作按钮——「识己手札」brand 是 position:fixed 浮在状态栏胶囊
   位置（brandTop/Left 来自 capsuleRect），同高度放按钮会与它重合。刷新按钮另起一行。 */
.a-hd { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
.a-hd .bk { flex-shrink: 0; font-size: 15px; color: var(--ink2); padding: 4px 2px; }
.a-hd .a-tt { flex: 1; font-size: 17px; font-weight: 800; color: var(--ink); }
.a-refresh { flex-shrink: 0; font-size: 12.5px; color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent); border-radius: 99px; padding: 4px 11px; }
.a-refresh.on { opacity: .55; }

/* 重新生成按钮（一周只能点一次；冷却中置灰不可点） */
.a-regen { flex-shrink: 0; font-size: 12.5px; color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent); border-radius: 99px; padding: 4px 11px; }
.a-regen.off { color: var(--ink3); background: transparent; border-color: var(--line); opacity: .7; }

/* 提示行 + 刷新按钮（避开状态栏胶囊区） */
.hint-row { display: flex; align-items: flex-start; gap: 10px; margin: -2px 0 12px; }
.hint-row .hint { flex: 1; margin: 0; }
.hint-row .a-refresh { margin-top: 1px; }

.hint { font-size: 12px; color: var(--ink3); margin: -2px 0 12px; line-height: 1.6; }

/* 生成中提示条：告诉用户「后台在跑，稍后再看」，而不是让他对着转圈等 */
.pending { background: var(--accent-soft); border: 1px solid var(--accent); border-radius: var(--r-card); padding: 12px 14px; margin-bottom: 12px; }
.pend-t { font-size: 13.5px; font-weight: 700; color: var(--accent); margin-bottom: 4px; }
.pend-s { font-size: 12.5px; color: var(--ink2); line-height: 1.65; }

/* 整体画像卡：强调色底，最吸睛 */
.pcard { background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 13px 14px; margin-bottom: 10px; }
.pcard.sum { background: var(--accent); border-color: var(--accent); }
.pcard.sum .pc-sum { font-size: 15px; font-weight: 700; color: #fff; line-height: 1.7; }
.pc-upd { margin-top: 7px; font-size: 11px; color: rgba(255,255,255,.82); }

/* 章节卡：与 .pcard 同底座，加章节标题（六章深度报告） */
.chap { background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 14px 14px 4px; margin-bottom: 10px; }
.chap-h { font-size: 15px; font-weight: 800; color: var(--ink); margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
.chap-h.sm { font-size: 14px; margin-bottom: 8px; }
.chap-no { flex-shrink: 0; width: 20px; height: 20px; border-radius: 6px; background: var(--accent); color: #fff; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center; }

/* 子区块 */
.sub { margin: 11px 0 13px; }
.sub-l { font-size: 12px; color: var(--ink3); margin-bottom: 6px; font-weight: 600; }
.sub-l.good { color: var(--accent); }
.sub-l.warn { color: #B0853A; }
.sub-l.bad { color: #B0556E; }
.sub-list { display: flex; flex-direction: column; gap: 6px; }
.sub-li { font-size: 13.5px; color: var(--ink2); line-height: 1.7; word-break: break-word; }
.sub-li.act { color: var(--ink); font-weight: 600; }
.sub-p { font-size: 13.5px; color: var(--ink2); line-height: 1.85; white-space: pre-wrap; word-break: break-word; }

/* 风险清单：带因果链条（触发条件 → 后果 → 预警信号），左描边区分于普通列表 */
.risk-li { font-size: 13px; color: var(--ink2); line-height: 1.75; word-break: break-word; padding: 8px 10px; border-left: 3px solid #B0556E; background: rgba(176, 85, 110, .06); border-radius: 0 8px 8px 0; }

/* 总结卡 */
.pcard.concl { background: var(--accent-soft); border-color: var(--accent); }
.concl-t { font-size: 14.5px; font-weight: 700; color: var(--ink); line-height: 1.8; }

/* 空态按钮 */
.empty-btn { margin-top: 16px; display: inline-block; font-size: 13.5px; font-weight: 700; color: #fff; background: var(--accent); border-radius: 99px; padding: 9px 22px; }
.empty-btn.on { opacity: .6; }
