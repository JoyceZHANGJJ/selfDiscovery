<view class="app" style="--status-h:{{statusH}}px;{{themeStyle}}">
  <view class="statusbar-mask"></view>
  <view class="screen">
    <view class="body">
      <view class="a-hd">
        <view class="bk" bindtap="onClose">‹ 返回</view>
        <view class="a-tt">人物深度报告</view>
      </view>
      <view class="hint-row">
        <view class="hint">基于你的全部记录，做一份「专属人物深度分析报告」：你是哪种人、适合往哪走、容易卡在哪、怎么决策。只用你的记录，不脑补；推断会标【推论】，没信号的章节宁可留空。写实，不美化。下拉可刷新；重新生成每周一次（周一0点后可再来）。</view>
        <view wx:if="{{p}}" class="a-regen {{cooling||pending?'off':''}}" bindtap="onGenerate">{{cooling?'本周已生成':(pending?'生成中…':'↻ 重新生成')}}</view>
      </view>

      <!-- 生成中：后台跑着，不让用户干等 -->
      <view wx:if="{{pending}}" class="pending">
        <view class="pend-t">正在生成，请稍后查看</view>
        <view class="pend-s">分析全部记录需要一些时间（通常十几秒到一分钟）。可以先离开这个页面，生成好之后回来就能看到；这里也会自动为你刷新。下拉可随时查看最新结果。</view>
        <!-- 首次生成时还没有任何内容可显示，用骨架屏占位。
             不占的话下面会直接空一片，看着像加载失败；画几条灰条才像「正在出结果」。
             有旧报告时不占——让用户还能看着上次的内容。 -->
        <view wx:if="{{!p}}" class="pend-sk">
          <view class="sk-line sk-w40 sk-sm"></view>
          <view class="sk-box"></view>
          <view class="sk-box"></view>
        </view>
      </view>

      <!-- 生成失败（网络 / 服务端）：给一句说明 + 重试 -->
      <view wx:if="{{genFail}}" class="loadfail">
        <view class="lft">生成失败</view>
        <view class="lfr" bindtap="onGenerate">重试</view>
      </view>

      <!-- 骨架屏：首屏未就绪 -->
      <view wx:elif="{{!ready}}" class="sk skpage">
        <view class="sk-line sk-w40 sk-sm"></view>
        <view class="sk-box"></view>
        <view class="sk-box"></view>
      </view>

      <block wx:else>
        <!-- 还没生成过：空态 + 生成按钮。
             pending 时不显示空态：上面的「正在生成」卡已经把话说全了，
             再叠一段「还没有报告 / 生成需要一点时间」纯属重复，还让人以为没提交上。 -->
        <view wx:if="{{empty && !pending}}" class="empty">
          <view class="empty-t">还没有人物深度报告</view>
          <view class="empty-s">先去「记」里留下一些觉察，再回来生成属于你的深度报告。生成需要一点时间，提交后可以先去做别的。</view>
          <view wx:if="{{!pending}}" class="empty-btn" bindtap="onGenerate">生成深度报告</view>
        </view>

        <block wx:elif="{{p}}">
          <!-- 整份报告一个可用字段都没剩下。
               两种成因：旧版落库残留 [object Object]（脏数据，不可修复），
               或模型这次确实没给出内容（记录太少）。两者按钮动作相同，
               所以合并成一条提示，别分成两种说法让人以为有区别。 -->
          <view wx:if="{{p.broken}}" class="empty">
            <view class="empty-t">这份报告没有内容</view>
            <view class="empty-s">分析跑完了，但没能从现有记录里提炼出任何东西。可能是记录还太少 —— 先去「记」里多留几条，再回来重新生成一份。</view>
            <view wx:if="{{!cooling && !pending}}" class="empty-btn" bindtap="onGenerate">{{cooling?'本周已生成过，下周一可再来':'重新生成深度报告'}}</view>
          </view>

          <block wx:else>
          <!-- 入口卡摘要。没摘要就不渲染这张卡：强调色底 + 白字，
               空摘要会变成一条没有任何信息的绿条，看着像出了个进度条。 -->
          <view wx:if="{{p.hasSummary}}" class="pcard sum">
            <view class="pc-sum">{{p.summary}}</view>
            <view wx:if="{{p.updatedAtLabel}}" class="pc-upd">更新于 {{p.updatedAtLabel}} · 基于 {{p.n || ''}} 条记录</view>
          </view>

          <!-- 第一章 基础人物画像 -->
          <view wx:if="{{p.hasBasic}}" class="chap">
            <view class="chap-h"><text class="chap-no">一</text>基础人物画像</view>
            <view wx:if="{{p.basic.info.length}}" class="sub">
              <view class="sub-l">客观基础信息</view>
              <view class="sub-list"><view wx:for="{{p.basic.info}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.basic.energy.length}}" class="sub">
              <view class="sub-l">能量模式（充电 / 耗电场景）</view>
              <view class="sub-list"><view wx:for="{{p.basic.energy}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.basic.decision.length}}" class="sub">
              <view class="sub-l">决策模式（倾向 / 漏洞 / 思维陷阱）</view>
              <view class="sub-list"><view wx:for="{{p.basic.decision}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.basic.body.length}}" class="sub">
              <view class="sub-l">身体约束（健康 / 精力 / 体力）</view>
              <view class="sub-list"><view wx:for="{{p.basic.body}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.basic.finance.length}}" class="sub">
              <view class="sub-l">财务现状 / 底线 / 顾虑</view>
              <view class="sub-list"><view wx:for="{{p.basic.finance}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.basic.env.length}}" class="sub">
              <view class="sub-l">环境 & 社交偏好（能接受 / 绝对排斥）</view>
              <view class="sub-list"><view wx:for="{{p.basic.env}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
          </view>

          <!-- 第二章 核心盘点 -->
          <view wx:if="{{p.hasCore}}" class="chap">
            <view class="chap-h"><text class="chap-no">二</text>核心盘点：优势 / 短板 / 内在冲突</view>
            <view wx:if="{{p.core.strengths.length}}" class="sub">
              <view class="sub-l good">核心优势（何时发挥 / 何时失效）</view>
              <view class="sub-list"><view wx:for="{{p.core.strengths}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.core.downsides.length}}" class="sub">
              <view class="sub-l warn">短板与天然限制（触发条件 → 后果）</view>
              <view class="sub-list"><view wx:for="{{p.core.downsides}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.core.conflicts.length}}" class="sub">
              <view class="sub-l bad">内在矛盾（两边诉求 → 爆发场景）</view>
              <view class="sub-list"><view wx:for="{{p.core.conflicts}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
          </view>

          <!-- 第三章 适配方向推荐 -->
          <view wx:if="{{p.hasFit}}" class="chap">
            <view class="chap-h"><text class="chap-no">三</text>适配方向推荐</view>
            <view wx:if="{{p.fit.workFirst.length}}" class="sub">
              <view class="sub-l good">优先尝试 · 工作模式 / 任务 / 环境</view>
              <view class="sub-list"><view wx:for="{{p.fit.workFirst}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.fit.workCareful.length}}" class="sub">
              <view class="sub-l">谨慎尝试（设边界 / 限量）</view>
              <view class="sub-list"><view wx:for="{{p.fit.workCareful}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.fit.workAvoid.length}}" class="sub">
              <view class="sub-l bad">尽量避开（耗精力 / 放大短板）</view>
              <view class="sub-list"><view wx:for="{{p.fit.workAvoid}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.fit.life.length}}" class="sub">
              <view class="sub-l">生活习惯 / 自我调节（具体动作 + 何时执行）</view>
              <view class="sub-list"><view wx:for="{{p.fit.life}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.fit.risks.length}}" class="sub">
              <view class="sub-l warn">风险清单（触发条件 → 连锁后果 → 预警信号）</view>
              <view class="sub-list"><view wx:for="{{p.fit.risks}}" wx:key="*this" wx:for-item="it" class="risk-li">{{it}}</view></view>
            </view>
          </view>

          <!-- 第四章 未来图景推演 -->
          <view wx:if="{{p.future.neutral || p.future.optimistic || p.future.cautious}}" class="chap">
            <view class="chap-h"><text class="chap-no">四</text>未来图景推演（条件推演，非预言）</view>
            <view wx:if="{{p.future.neutral}}" class="sub">
              <view class="sub-l">中性情景 · 维持现状</view>
              <view class="sub-p">{{p.future.neutral}}</view>
            </view>
            <view wx:if="{{p.future.optimistic}}" class="sub">
              <view class="sub-l good">乐观情景 · 做到哪几件关键事</view>
              <view class="sub-p">{{p.future.optimistic}}</view>
            </view>
            <view wx:if="{{p.future.cautious}}" class="sub">
              <view class="sub-l bad">保守风险情景 · 触发行为与预警信号</view>
              <view class="sub-p">{{p.future.cautious}}</view>
            </view>
          </view>

          <!-- 第五章 实操行动方案 -->
          <view wx:if="{{p.hasAction}}" class="chap">
            <view class="chap-h"><text class="chap-no">五</text>实操行动方案</view>
            <view wx:if="{{p.action.quick.length}}" class="sub">
              <view class="sub-l good">低成本试错行动（优先，可随时终止）</view>
              <view class="sub-list"><view wx:for="{{p.action.quick}}" wx:key="*this" wx:for-item="it" class="sub-li act">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.action.rules.length}}" class="sub">
              <view class="sub-l">长期规则 / 个人边界红线</view>
              <view class="sub-list"><view wx:for="{{p.action.rules}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.action.metrics.length}}" class="sub">
              <view class="sub-l">复盘监测指标（可量化）</view>
              <view class="sub-list"><view wx:for="{{p.action.metrics}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
          </view>

          <!-- 第六章 决策辅助专项 -->
          <view wx:if="{{p.decision.rhythm || p.decision.framework.length || p.decision.trial.length}}" class="chap">
            <view class="chap-h"><text class="chap-no">六</text>决策辅助专项</view>
            <view wx:if="{{p.decision.rhythm}}" class="sub">
              <view class="sub-l">适合的决策节奏</view>
              <view class="sub-p">{{p.decision.rhythm}}</view>
            </view>
            <view wx:if="{{p.decision.framework.length}}" class="sub">
              <view class="sub-l">思考框架 & 要避开的思维陷阱</view>
              <view class="sub-list"><view wx:for="{{p.decision.framework}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
            <view wx:if="{{p.decision.trial.length}}" class="sub">
              <view class="sub-l">试错策略（哪些可大胆试 / 哪些绝不能试）</view>
              <view class="sub-list"><view wx:for="{{p.decision.trial}}" wx:key="*this" wx:for-item="it" class="sub-li">· {{it}}</view></view>
            </view>
          </view>

          <!-- 第七章 总结 -->
          <view wx:if="{{p.hasConcl}}" class="pcard concl">
            <view class="chap-h sm">七 · 总结</view>
            <view class="concl-t">{{p.conclusion}}</view>
          </view>
          </block>
        </block>
      </block>
    </view>
  </view>

  <view wx:if="{{brandH}}" class="brand {{brandPlay?'play':''}}" style="position:fixed;top:{{brandTop}}px;left:{{brandLeft}}px;width:{{brandW}}px;height:{{brandH}}px;">
    <text wx:for="{{brandChars}}" wx:key="*this" class="bc">{{item}}</text>
  </view>

  <theme-switcher />
</view>
