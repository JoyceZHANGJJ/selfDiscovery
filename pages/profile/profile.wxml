<view class="app" style="--status-h:{{statusH}}px;{{themeStyle}}">
  <view class="statusbar-mask"></view>
  <view class="screen">
    <view class="body">
      <view class="a-hd">
        <view class="bk" bindtap="onClose">‹ 返回</view>
        <view class="a-tt">个人画像</view>
        <view class="a-refresh {{loading?'on':''}}" bindtap="onGenerate">{{loading?'生成中…':'↻ 刷新'}}</view>
      </view>
      <view class="hint">基于你的全部记录，勾勒稳定的「你是谁」——擅长什么、在意什么、回避什么、适合往哪走、可以试什么。记录越多越准，下拉或点刷新随成长更新。</view>

      <!-- 生成失败（网络 / 服务端）：给一句说明 + 重试 -->
      <view wx:if="{{genFail}}" class="loadfail">
        <view class="lft">生成失败</view>
        <view class="lfr" bindtap="onGenerate">重试</view>
      </view>

      <!-- 骨架屏：首屏未就绪 -->
      <view wx:elif="{{!ready}}" class="sk skpage">
        <view class="sk-line sk-w40 sk-sm"></view>
        <view class="sk-box"></view>
        <view class="sk-box"></view>
      </view>

      <block wx:else>
        <!-- 还没生成过：空态 + 生成按钮 -->
        <view wx:if="{{empty}}" class="empty">
          <view class="empty-t">还没有个人画像</view>
          <view class="empty-s">先去「记」里留下一些觉察，再回来生成属于你的画像。</view>
          <view class="empty-btn {{loading?'on':''}}" bindtap="onGenerate">{{loading?'生成中…':'生成个人画像'}}</view>
        </view>

        <block wx:else>
          <!-- 整体画像 -->
          <view class="pcard sum">
            <view class="pc-sum">{{p.summary}}</view>
            <view wx:if="{{p.updatedAtLabel}}" class="pc-upd">更新于 {{p.updatedAtLabel}} · 基于 {{p.n || ''}} 条记录</view>
          </view>

          <view class="pgrid">
            <view class="pcard">
              <view class="pc-l">擅长</view>
              <view class="pc-tags"><text wx:for="{{p.strengths}}" wx:key="*this" wx:for-item="it" class="pc-tag s">{{it}}</text></view>
            </view>
            <view class="pcard">
              <view class="pc-l">感兴趣</view>
              <view class="pc-tags"><text wx:for="{{p.interests}}" wx:key="*this" wx:for-item="it" class="pc-tag i">{{it}}</text></view>
            </view>
          </view>

          <view wx:if="{{p.disinterests.length}}" class="pcard">
            <view class="pc-l">不太感兴趣</view>
            <view class="pc-tags"><text wx:for="{{p.disinterests}}" wx:key="*this" wx:for-item="it" class="pc-tag d">{{it}}</text></view>
          </view>

          <view class="pcard">
            <view class="pc-l">适合的方向</view>
            <view class="pc-list"><view wx:for="{{p.directions}}" wx:key="*this" wx:for-item="it" class="pc-li">· {{it}}</view></view>
          </view>

          <view class="pcard">
            <view class="pc-l">可以试试</view>
            <view class="pc-list"><view wx:for="{{p.tryThis}}" wx:key="*this" wx:for-item="it" class="pc-li act">· {{it}}</view></view>
          </view>

          <view class="pcard">
            <view class="pc-l">更深的模式</view>
            <view class="pc-pat">{{p.patterns}}</view>
          </view>
        </block>
      </block>
    </view>
  </view>

  <view wx:if="{{brandH}}" class="brand {{brandPlay?'play':''}}" style="position:fixed;top:{{brandTop}}px;left:{{brandLeft}}px;width:{{brandW}}px;height:{{brandH}}px;">
    <text wx:for="{{brandChars}}" wx:key="*this" class="bc">{{item}}</text>
  </view>

  <theme-switcher />
</view>
