/* 主题配色已统一到 utils/themes.js（单一来源）：各页根节点用内联 CSS 变量注入，
   这里不再定义 .theme-* 变量块，避免「常量与样式两处手工同步」。 */
/* ================= 基础布局 ================= */
.app { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; flex-direction: column; background: var(--bg); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif; line-height: 1.6; --r-card: 16px; --r-btn: 12px; --r-in: 14px; }
/* 状态栏遮罩：自定义导航下，页面内容滚动时会穿过状态栏（时间/电量）。
   用与背景同色的渐变把它柔和盖住——不挡交互、不占空间，主题切换自动跟随背景色 */
.statusbar-mask { position: fixed; top: 0; left: 0; right: 0; height: calc(var(--status-h, 20px) + 8px); background: linear-gradient(to bottom, var(--bg) 55%, rgba(0, 0, 0, 0)); z-index: 45; pointer-events: none; }
.screen { display: block; width: 100%; max-width: 640px; height: 100%; margin: 0 auto; box-sizing: border-box; }
.body { padding: calc(var(--status-h, 20px) + 12px) 14px calc(64px + env(safe-area-inset-bottom, 0px)); box-sizing: border-box; }
.body-top { padding: calc(var(--status-h, 20px) + 46px) 14px calc(64px + env(safe-area-inset-bottom, 0px)); }
.body::-webkit-scrollbar { width: 0; }
.greet { font-size: 19px; font-weight: 800; letter-spacing: -.01em; }
.greet-sub { font-size: 12.5px; color: var(--ink3); margin-top: 3px; }
.greet-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
.greet-wrap { min-width: 0; }
.greet-row .lg { font-size: 12px; color: var(--ink3); text-decoration: none; flex-shrink: 0; }

/* ================= 记 · 输入区 ================= */
.composer { background: radial-gradient(140% 140% at 50% 25%, var(--surface, #FFFFFF) 35%, var(--bg, #FFFFFF) 92%); border: 0; border-radius: var(--r-card); padding: 10px 16px 16px; margin: 0 0 22px; box-shadow: 0 14px 36px rgba(35,35,31,.08), 0 3px 10px rgba(35,35,31,.05); }
.body-top .composer { padding-top: 10px; padding-left: 14px; padding-right: 14px; }
.composer:focus-within { border-color: var(--accent); box-shadow: var(--ring); }
.tagrow { display: flex; gap: 14px; margin: 0 0 12px; padding-bottom: 4px; flex-wrap: nowrap; align-items: center; }
.tagrow-scroll { width: 100%; white-space: nowrap; }
.tagrow .tg { flex-shrink: 0; }
.tagrow-wrap { position: relative; }
.tagrow-fade { position: absolute; top: 0; right: 0; width: 8px; height: 21px; background: linear-gradient(to right, rgba(51,50,45,0), rgba(51,50,45,.08)); pointer-events: none; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 35%, #000 65%, transparent); mask-image: linear-gradient(to bottom, transparent, #000 35%, #000 65%, transparent); }
/* 左侧那份：往回滚过、左边还有 chip 没露出来时给提示（与右侧同一套，只是镜像） */
.tagrow-fade-l { right: auto; left: 0; background: linear-gradient(to left, rgba(51,50,45,0), rgba(51,50,45,.08)); }
/* 命中区补齐：维度 tag 约 22px 高 → 撑到约 44px（左右只扩 5px；下划线仍是选中态的唯一标识） */
.tg { font-size: 13.5px; padding: 0 0 4px; border: 0; border-bottom: 2px solid transparent; background: none; color: var(--ink3); display: inline-flex; align-items: center; gap: 5px; position: relative; }
.tg::after { content: ''; position: absolute; left: -5px; right: -5px; top: -11px; bottom: -11px; }
.tg .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ink3); }
.tg.on { border-bottom-color: var(--accent); color: var(--accent); font-weight: 700; }
.tg.on .dot { background: currentColor; }
.big-in { width: 100%; border: 0; outline: none; resize: none; font-size: 14px; font-family: inherit; color: var(--ink, #22252A); background: var(--soft, #F4F5F5); border-radius: 12px; padding: 8px 12px; line-height: 21px; min-height: 52px; caret-color: var(--accent, #2F8F7B); box-sizing: border-box; display: block; }
.big-in::placeholder { font-size: 14px; color: var(--ink4); }
.extra { margin-top: 14px; padding-top: 0; border-top: 0; }
.extra.first { margin-top: 7px; }
/* 没有标题的细节项（如「感受」组里跟在选项后面的自由输入框）：收紧间距，读起来和上一组是一体 */
.extra.nlab { margin-top: 8px; }
/* 「感受」组下面的档位副行（觉察）：不显示标题、没有管理入口、chip 小一号，
   读起来是上面情绪的修饰而不是另一组（未选情绪时整行不渲染，见 index.wxml） */
.extra.sub .chips .chip { font-size: 11.5px; }
.extra-h { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink3); letter-spacing: .02em; }
.ehead { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2px; }
.ehead .et { font-size: 11.5px; color: var(--ink3); letter-spacing: .04em; }
.qrow { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 11px 0 6px; }
.qrow:first-child { margin-top: 0; }
.qrow .ql { font-size: 12px; color: var(--ink3); }
/* 命中区补齐（N8）：小元素不好点，用一层**透明**的 ::after 把可点范围撑到 44px——
   它不占布局、不改视觉；与相邻内容重叠的那部分由后面的元素接管（绘制在上方），不会抢走点击。
   左右只扩少量，避免同类元素之间互相抢。 */
.qrow .mg, .ehead .mg { font-size: 11.5px; color: var(--ink3); border: 1px solid var(--line2); border-radius: 99px; padding: 1px 9px; background: #fff; position: relative; }
/* 「✎ 管理」实际只有约 19px 高 → 撑到约 43px */
.qrow .mg::after, .ehead .mg::after { content: ''; position: absolute; left: -8px; right: -8px; top: -12px; bottom: -12px; }
.q { font-size: 12px; color: var(--ink3); margin: 9px 0 6px; }
.q:first-child { margin-top: 0; }
/* 行间距 4px → 12px：给 chip 的可点区留出位置（见下面 .chip::after）。
   chip 之间挨得太近（原来只有 4px），把命中区扩到 44px 会互相抢——
   后面的 chip 绘制在前面之上，结果就是「点上一行 chip 的下半，命中的是下一行」。
   所以这里让间距与扩展量对齐：各扩 6px、间距 12px，正好相接、不重叠 */
.chips { display: flex; flex-wrap: wrap; gap: 12px 14px; align-items: baseline; }
/* 命中区补齐：选项 chip 约 21px 高 → 撑到约 33px（上下各 6px，与 .chips 的行间距对齐） */
.chip { font-size: 13.5px; padding: 2px 0; background: none; border: 0; color: var(--ink); position: relative; }
.chip::after { content: ''; position: absolute; left: -4px; right: -4px; top: -6px; bottom: -6px; }
.chip.on { color: var(--accent); font-weight: 700; }
.mini-in { width: 100%; resize: none; border: 1px solid transparent; border-radius: 11px; padding: 0 11px; height: 34px; line-height: 34px; font-size: 13.5px; font-family: inherit; outline: none; background: var(--soft, #F4F5F5); color: var(--ink, #22252A); caret-color: var(--accent, #2F8F7B); box-sizing: border-box; display: block; }
textarea.mini-in { padding: 7px 11px; height: auto; min-height: 34px; line-height: 20px; }
.mini-in:focus { background: var(--surface); border-color: var(--accent); box-shadow: var(--ring); }
.savebar { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
/* 吸底操作行（记页）：记卡在视口里时，这一行始终贴在视口底部（bottom 由页面按时键盘高度给），
   卡片滚出视口后它随卡片一起离开——配合不透明底色，滚动的列表不会从它下面透出来 */
.savebar.sticky { position: sticky; z-index: 22; background: var(--bg); padding: 10px 0 6px; }
/* 键盘弹着时的形态：sticky 受父容器（记卡）与滚动状态限制，不保证能上移到键盘上方，
   这时改成真正的 fixed——bottom 由页面按键盘高度给（style="bottom:{{barBottom}}"）。
   左右的 30px = 页面 .body 的 14px + 记卡 .composer 的 16px，让按钮与卡片里的内容左右对齐 */
.savebar.kb { position: fixed; left: 0; right: 0; max-width: 640px; margin: 0 auto; padding: 10px 30px 6px; }
/* 吸到底部时给一点过渡，避免像"硬贴在列表上" */
.savebar.sticky::before { content: ''; position: absolute; left: 0; right: 0; top: -14px; height: 14px; background: linear-gradient(to bottom, rgba(255,255,255,0), var(--bg)); pointer-events: none; }
.btn { flex: 1; padding: 11px 0; border-radius: var(--r-btn); background: var(--accent, #2F8F7B); color: #fff; font-size: 14.5px; font-weight: 700; border: 0; text-align: center; }
.btn:active { opacity: .88; }
.btn.gh { background: var(--soft); color: var(--ink2); border: 1px solid var(--line2); }
.btn.dan { background: var(--danger); }
.toastline { margin-top: 13px; background: var(--accent-soft); border-radius: 12px; padding: 10px 13px; font-size: 13px; color: var(--ink2); display: flex; align-items: center; gap: 8px; }
.toastline .tx { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.toastline .tb { font-size: 12px; color: var(--accent); text-decoration: underline; flex-shrink: 0; }

/* ================= 看 · 时间线 ================= */
.sect-t { font-size: 13px; font-weight: 800; color: var(--ink2); margin: 16px 0 9px; letter-spacing: .02em; }
/* 清单悬浮入口（右下角，抬到记录操作条「改/删」之上，避免遮挡） */
.fab { position: fixed; right: 16px; bottom: calc(116px + env(safe-area-inset-bottom, 0px)); width: 52px; height: 52px; border-radius: 50%; background: var(--accent); color: #fff; border: 3px solid #fff; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 20px; line-height: 1; box-shadow: 0 10px 22px rgba(35,35,31,.26), 0 3px 7px rgba(35,35,31,.16); z-index: 45; }
.fab:active { transform: scale(.94); }
.search { width: 100%; height: 40px; border: 1px solid var(--line2); border-radius: var(--r-in); padding: 0 13px; font-size: 14px; line-height: 40px; font-family: inherit; outline: none; background: #fff; caret-color: var(--accent); box-sizing: border-box; }
.search:focus { border-color: var(--accent); box-shadow: var(--ring); }
/* 间距 6px → 10px：给筛选 tab 的可点区留位置（见下面 .ft::after），与 chip 同理——
   挨得太近时把命中区扩开会互相抢（后面的绘制在前面之上） */
.filters { display: flex; gap: 10px; margin: 11px 0 4px; flex-wrap: wrap; }
/* 命中区补齐：筛选 tab 约 25px 高 → 撑到约 35px（上下 / 左右各 5px，与间距 10px 对齐） */
.ft { font-size: 12.5px; padding: 5px 2px; border: 0; background: none; color: var(--ink3); border-bottom: 2px solid transparent; position: relative; }
.ft::after { content: ''; position: absolute; left: -5px; right: -5px; top: -5px; bottom: -5px; }
.ft.on { color: var(--accent); font-weight: 700; border-bottom-color: var(--accent); }
.ft .fd { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--ink3); margin-right: 5px; vertical-align: middle; }
/* 选中项的小圆点保留自己的类别色：筛选行是「下划线 tab」而不是填充药丸，
   原来的「选中变白」（给填充式设计的）会让圆点在浅底上直接看不见 */
.daylab { font-size: 11.5px; color: var(--ink3); margin: 15px 0 2px; letter-spacing: .06em; }
.st-sum { font-size: 12.5px; color: var(--ink2); margin-bottom: 11px; }
.st-sum b { color: var(--ink); font-weight: 800; }
.st-ex { font-size: 12px; color: var(--ink3); margin-top: 11px; padding-top: 9px; border-top: 1px solid var(--line); }
.barrow { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-size: 13px; }
.barrow .bn { flex: 0 0 74px; color: var(--ink2); font-size: 12.5px; }
/* 统计块的占位行（看页）：只为撑住高度、不让统计随二级筛选伸缩，内容不可见 */
.barrow.pad { visibility: hidden; }
.barrow .bb { flex: 1; height: 8px; background: var(--soft); border-radius: 99px; overflow: hidden; }
.barrow .bf { height: 100%; border-radius: 99px; background: var(--accent); }
.barrow .bv { flex: 0 0 26px; text-align: right; font-size: 12px; color: var(--ink3); }
.rec { display: block; padding: 12px 14px; margin: 0 0 9px; border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 1px 2px rgba(35,35,31,.05); position: relative; overflow: hidden; }
.rec:active { background: #FCFBF8; }
.rec .edge { position: absolute; left: 0; top: 0; bottom: 0; width: 3px; }
.rec.sel { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }
/* ===== 时间线：不用卡片（看页时间流 / 记页「最近」共用）=====
   去掉边框、圆角、投影，改成左侧一条轴线 + 每个记录一个圆点（颜色跟随维度） */
.rec.tl { background: transparent; border: 0; border-radius: 0; box-shadow: none; padding: 8px 0 8px 24px; margin: 0; }
.rec.tl:active { background: transparent; }
.rec.tl .edge { display: none; }   /* 左侧色条的角色交给轴线上的圆点 */
/* 轴线 */
.rec.tl::before { content: ''; position: absolute; left: 5px; top: 0; bottom: 0; width: 1px; background: var(--line); }
/* 圆点：内容盒 + 2px 主题底描边，正好压住轴线（--dot 由页面按维度色传入） */
.rec.tl::after { content: ''; position: absolute; left: 2px; top: 12px; width: 7px; height: 7px; box-sizing: content-box; border: 2px solid var(--bg); border-radius: 50%; background: var(--dot, var(--accent)); }
/* 每组第一行：轴线从圆点开始；每组最后一行：到圆点为止；只有一条时不画线
   （组头有几种：日期 .daylab、待办块标题 .tfhd、小节标题 .sect-t、已完成分隔 .dnlab、筛选行 .filters） */
.daylab + .rec.tl::before,
.tfhd + .rec.tl::before,
.sect-t + .rec.tl::before,
.dnlab + .rec.tl::before,
.filters + .rec.tl::before { top: 17px; }
.rec.tl:last-child::before { bottom: auto; height: 17px; }
.daylab + .rec.tl:last-child::before,
.tfhd + .rec.tl:last-child::before,
.sect-t + .rec.tl:last-child::before,
.dnlab + .rec.tl:last-child::before,
.filters + .rec.tl:last-child::before { height: 0; }
/* 选中：不用浅色块（时间线下像糊了一层遮罩），改用时间线自己的语言——
   标题换成强调色、圆点加一圈柔光、该段轴线加粗成强调色 */
.rec.tl.sel { background: transparent; border-radius: 0; box-shadow: none; }
.rec.tl.sel .tv { color: var(--accent); }
.rec.tl.sel::before { left: 4.5px; width: 2px; background: var(--accent); }
.rec.tl.sel::after { box-shadow: 0 0 0 4px var(--accent-soft); }
.rec .hd { display: flex; align-items: baseline; gap: 8px; }
/* 维度名（觉察/无感…）：11px 下 700 在手机上不够明显，提到 800（与问候/小节标题同级强调）；
   标题折成两行时别跟着首行基线吊在上边——独立垂直居中（与勾选框一致） */
.rec .mn { font-size: 11px; font-weight: 800; align-self: center; }
/* 事件项（主内容）加重：用 700 而不是 600——手机端中文字体常缺 600 这一档，
   WebView 不合成中间字重时会回落到 400，导致加重看不出来；700 各端都能稳定渲染 */
.rec .tv { flex: 1; min-width: 0; font-size: 13.5px; font-weight: 700; color: var(--ink); word-break: break-all; line-height: 1.5; }
.rec .tw { font-size: 11.5px; color: var(--ink3); flex-shrink: 0; font-variant-numeric: tabular-nums; }
.rec .dt { margin-top: 6px; line-height: 1.9; font-size: 12.5px; color: var(--ink); }
/* 「归类 + 具体的描述」同排展示：归类为主（700），描述随后（次要色、过长省略）。
   只有带描述的记录（.has-desc）才把标题也收成单行，其它记录保持原来的可折行行为 */
.rec.tl.has-desc .tvw .tv { flex: 0 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rec .tvw .tdesc { flex: 1 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 12px; font-weight: 400; color: var(--ink3); margin-left: 7px; }
.sep { font-style: normal; font-size: 11px; color: var(--line2); margin: 0 5px; }
.it { margin-right: 14px; }
.it:last-child { margin-right: 0; }
.k { color: var(--ink3); margin-right: 5px; font-size: 11.5px; }
/* 备忘 / 购物：输入区只留一个输入框，一行高度、文字垂直居中 */
.plain-in { margin-top: 4px; height: 34px; min-height: 34px; line-height: 34px; padding: 0 12px; }
.plain-in:first-child { margin-top: 0; }

/* ================= 骨架屏（首屏加载占位） ================= */
.sk-line, .sk-box, .sk-btn, .sk-rec, .sk-dot, .sk-hr {
  background: var(--soft); position: relative; overflow: hidden;
}
.sk-line, .sk-box, .sk-btn, .sk-rec, .sk-dot, .sk-hr, .sk-line::after, .sk-box::after, .sk-btn::after, .sk-rec::after { border-radius: 8px; }
.sk-line::after, .sk-box::after, .sk-btn::after, .sk-rec::after, .sk-dot::after, .sk-hr::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.65), transparent);
  transform: translateX(-100%); animation: sk-shine 1.25s ease-in-out infinite;
}
@keyframes sk-shine { 100% { transform: translateX(100%); } }
.sk-line { height: 13px; margin-bottom: 8px; border-radius: 6px; }
.sk-sm { height: 10px; }
.sk-w60 { width: 60%; } .sk-w40 { width: 40%; } .sk-w30 { width: 30%; }
.sk-row { display: flex; align-items: center; gap: 7px; margin: 14px 0 12px; }
.sk-row .sk-line { margin: 0; }
.sk-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.sk-box { height: 52px; border-radius: 12px; margin-bottom: 4px; }
.sk-hr { height: 1px; margin: 14px 0 12px; border-radius: 0; }
.sk-hr::after { display: none; }
.sk-btn { height: 42px; border-radius: var(--r-btn); margin-top: 12px; }
.sk-rec { height: 62px; border-radius: 14px; margin-bottom: 9px; }
.sk .sk-line:last-of-type { margin-bottom: 0; }

/* 备忘 / 购物：可勾选完成 —— 勾选后划线，并记下完成时间 */
.rec .ck { width: 17px; height: 17px; border-radius: 50%; border: 1.5px solid var(--line2); flex-shrink: 0; align-self: center; position: relative; transition: background .15s, border-color .15s; }
.rec .ck:active { transform: scale(.9); }
.rec.done .ck { background: var(--accent); border-color: var(--accent); }
.rec.done .ck::after { content: ''; position: absolute; left: 4.5px; top: 1.5px; width: 5px; height: 9px; border: 1.7px solid #fff; border-top: 0; border-left: 0; transform: rotate(42deg); }
.rec.done .tv { color: var(--ink3); text-decoration: line-through; }
/* 已放弃：与「完成」统一为「实心圆 + 白色标记」语言——只是颜色用中性灰、标记用 ×，表示不再进行（这里也没给点击，完成要走「恢复」）
   × 用 left/top 50% + translate 居中：圆圈有 1.5px 边框，按 padding 盒硬折算容易偏出去 */
.rec.ab .ck { background: var(--ink3); border-color: var(--ink3); }
.rec.ab .ck::before, .rec.ab .ck::after { content: ''; position: absolute; left: 50%; top: 50%; width: 8px; height: 1.5px; border-radius: 2px; background: #fff; }
.rec.ab .ck::before { transform: translate(-50%, -50%) rotate(45deg); }
.rec.ab .ck::after { transform: translate(-50%, -50%) rotate(-45deg); }
/* 命中区补齐：勾选圈只有 17px → 用 ::before 铺一层透明区域撑到约 43px（不占布局、视觉不变）。
   「已放弃」的 × 已经占用 ::before/::after（且它本来不可点），所以把那两笔复位成居中画法 */
/* 只向左（行首的空白）与上下各扩一点：**不向右扩**——右边紧挨着文字，
   勾选圈是 position:relative（定位元素绘制在普通内容之上），向右扩会把文字左侧的点击抢走 */
.rec .ck::before { content: ''; position: absolute; left: -13px; right: 0; top: -8px; bottom: -8px; }
.rec.ab .ck::before { right: auto; bottom: auto; }
.rec.ab .tv { color: var(--ink3); text-decoration: line-through; }
.rec.done .edge { opacity: .35; }
.rec.done .tw { opacity: .6; }
.rec .done-at { font-size: 11.5px; color: var(--accent); margin-top: 6px; font-variant-numeric: tabular-nums; letter-spacing: .01em; }
/* 备忘 / 购物清单：不走时间流，平铺成列表 */
.rec.list { padding: 10px 13px; margin: 0 0 7px; border-radius: 12px; box-shadow: none; }
.rec.list .hd { gap: 9px; }
/* 清单行：事项标题完整显示（超长自动折行，不省略不溢出）；原因/用途最多折两行；时间必显 */
.rec.list .mn { flex-shrink: 0; white-space: nowrap; }
.rec.list .tv { flex: 1 1 auto; min-width: 0; white-space: normal; word-break: break-all; }
/* 时间那行不伸展（flex-grow:0）：否则会和事项标题平分宽度，把标题挤成两行、右侧留一片空白 */
.rec.list .twr { display: flex; align-items: baseline; gap: 5px; flex: 0 1 auto; justify-content: flex-end; min-width: 0; font-size: 11.5px; color: var(--ink3); }
/* 原因 / 放弃原因：最多折两行，超出第二行省略。
   已放弃的待办，「放弃原因」在 store.decorate 里就被映射到了 reason，所以和原因是同一个元素、同一套样式 */
.rec.list .twx { flex: 0 1 auto; min-width: 0; overflow: hidden; white-space: normal; word-break: break-all; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.rec.list .twd { flex-shrink: 0; }
.rec.list .twt { flex-shrink: 0; white-space: nowrap; font-variant-numeric: tabular-nums; }
.rec.list .tw { flex-shrink: 0; white-space: nowrap; margin-left: auto; }
/* 清单标题超长：隐藏原因/用途，标题占满整行自动折行，右侧只留时间 */
.rec.list.long .twx, .rec.list.long .twd { display: none; }
.rec.list.long .twr { flex: 0 0 auto; }
/* 正在被就地编辑的那一行：原内容隐身（编辑器就摆在它上面），
   只留时间线的轴线与圆点，编辑时线条不断 */
.rec.blank .hd,
.rec.blank .done-at,
.rec.blank .edge { opacity: 0; }
/* 清单行也走时间线（记页「最近」的备忘 / 购物、看页待办清单）：
   放在 .rec.list 之后覆盖一次，避免它自己的 padding / margin / 圆角把扁平样式顶回去 */
.rec.list.tl { background: transparent; border: 0; border-radius: 0; box-shadow: none; margin: 0; padding: 8px 0 8px 24px; }
.tsum { font-size: 11.5px; color: var(--ink3); margin: -5px 0 9px; }
/* 待办清单的标题行（组件 todo-list）：左边标题 + 汇总，右边留给使用方的入口
   （看页的「去清单页管理 ›」）——入口右起、与标题顶端对齐，不再单独占一行。
   没传插槽内容时右侧那个盒子是空的（宽 0），清单页的排布不变 */
.tl-top { display: flex; align-items: flex-start; }
.tl-top-l { flex: 1 1 auto; min-width: 0; }
.tl-top-r { flex: 0 0 auto; }
/* 清单页各段的「显示更多」（把长段先收在最近一段后面，避免一次铺开太多行） */
/* 命中区补齐：整块约 34px 高 → 撑到约 44px。**只向下扩**：上方紧挨着最后一条记录行，
   向上扩会被它抢（本块在 DOM 后面，绘制在上，反而会把行的点击吃掉） */
.moreline { text-align: center; font-size: 12.5px; color: var(--accent); padding: 10px 0 2px; position: relative; }
.moreline::after { content: ''; position: absolute; left: 0; right: 0; top: 0; bottom: -10px; }
/* 日期行里的「展开全部 N 条」（某天完成的特别多时）：跟在日期后面，不打断时间线轴线。
   命中区补齐：它只有约 17px 高；inline 元素的垂直 padding 不撑开行高（布局不变），
   只把可点范围撑到约 43px——这里不能用 ::after 扩展，text 组件的伪元素支持不稳 */
.daymore { margin-left: 7px; color: var(--accent); letter-spacing: 0; padding: 13px 0; }
.dnlab { display: flex; align-items: center; gap: 7px; font-size: 11.5px; color: var(--ink3); margin: 14px 0 3px; letter-spacing: .06em; }
.dnlab::after { content: ''; flex: 1; height: 1px; background: var(--line); }
/* 待办清单：待完成 / 已完成 可折叠（沿用之前的细线标题样式，不加卡片） */
/* 命中区补齐：段头整行可点（折叠 / 展开），但行高只有约 18px → 撑到约 44px。
   透明层不占布局（margin: 14px 0 3px 的间距不变）；上下相邻的记录行绘制在它之上，不会被抢走点击 */
.tfhd { display: flex; align-items: center; gap: 9px; margin: 14px 0 3px; position: relative; }
.tfhd::after { content: ''; position: absolute; left: 0; right: 0; top: -13px; bottom: -13px; }
.tfhd .tt { font-size: 11.5px; color: var(--ink3); letter-spacing: .06em; flex-shrink: 0; }
.tfhd .tl { flex: 1; height: 1px; background: var(--line); }
.tfhd .tc { font-size: 10px; color: var(--ink3); transition: transform .18s; flex-shrink: 0; }
.tfhd .tc.open { transform: rotate(90deg); }

/* ================= 回看 ================= */
.kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 6px; }
.kpi { background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 16px; }
.kpi .n { font-size: 27px; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
.kpi .l { font-size: 11.5px; color: var(--ink3); margin-top: 2px; }
.bars { margin-top: 16px; background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); padding: 16px; }
.insight { margin-top: 15px; background: var(--accent-soft); border-radius: var(--r-card); padding: 16px; }
.insight .it { font-size: 12px; color: var(--accent); font-weight: 800; letter-spacing: .04em; }
.insight .ib { font-size: 15px; font-weight: 700; color: var(--ink); margin-top: 5px; line-height: 1.5; }
.insight .is { font-size: 12.5px; color: var(--ink2); margin-top: 4px; }
.heat { display: flex; gap: 3px; margin-top: 12px; }
.heat i { flex: 1; height: 22px; border-radius: 3px; background: var(--soft); }
.heat i.l1 { background: var(--accent-soft); }
.heat i.l2 { background: var(--accent); opacity: .45; }
.heat i.l3 { background: var(--accent); }
.heat-sum { font-size: 11.5px; color: var(--ink3); margin-top: 7px; }
.rev-sum { margin-top: 12px; background: var(--accent-soft); border-radius: var(--r-card); padding: 3px 16px; }
.rev-row { display: flex; align-items: baseline; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--line); }
.rev-row:last-child { border-bottom: none; }
.rev-k { display: flex; align-items: center; gap: 5px; flex-shrink: 0; width: 72px; font-size: 12px; font-weight: 700; color: var(--ink2); }
.rev-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.rev-v { font-size: 13px; color: var(--ink); font-weight: 700; line-height: 1.4; flex: 1; min-width: 0; word-break: break-word; }
.evfold { margin-top: 15px; background: #fff; border: 1px solid var(--line); border-radius: var(--r-card); overflow: hidden; }
.evfold-h { display: flex; align-items: center; gap: 8px; padding: 14px 16px; }
.evfold-h .evfold-t { font-size: 14px; font-weight: 700; color: var(--ink); }
.evfold-h .evfold-c { font-size: 12px; color: var(--ink3); }
.evfold-h .evfold-chev { margin-left: auto; font-size: 11px; color: var(--ink3); transition: transform .18s; }
.evfold.open .evfold-chev { transform: rotate(90deg); }
.evfold-b { padding: 8px 16px 14px; }
.ev-grp { margin-top: 11px; }
.ev-grp:first-child { margin-top: 2px; }
.ev-grp-h { display: flex; align-items: baseline; gap: 8px; }
.ev-grp-h .ev-gn { font-size: 14px; font-weight: 700; color: var(--ink); }
.ev-grp-h .ev-gc { font-size: 11.5px; font-weight: 700; color: var(--ink3); }
.ev-dim { margin: 7px 0 2px 10px; padding-left: 10px; border-left: 2px solid var(--line2); }
.ev-dim-h { display: flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 700; color: var(--ink2); margin-bottom: 3px; }
.ev-dim-h .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.ev-row { font-size: 12.5px; color: var(--ink); line-height: 1.9; padding: 3px 0; }
.ev-row .ev-d { color: var(--ink3); font-variant-numeric: tabular-nums; margin-right: 10px; }
.ev-row .ev-desc { color: var(--ink2); margin-right: 10px; }

/* ================= 设置 ================= */
.srow { display: flex; align-items: center; gap: 12px; padding: 13px 0; border-bottom: 1px solid var(--line); }
.srow .sl { flex: 1; font-size: 14.5px; }
.srow .ss { font-size: 12px; color: var(--ink3); margin-top: 1px; }
.srow .sr { font-size: 13px; color: var(--accent); }
.srow .sv { font-size: 13px; color: var(--ink3); flex-shrink: 0; }
.empty-mini { font-size: 12.5px; color: var(--ink3); padding: 10px 0 4px; }
.danger { color: var(--danger) !important; }
.pool { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.po { font-size: 12.5px; padding: 5px 11px; border-radius: 99px; background: var(--soft); color: var(--ink2); display: inline-flex; align-items: center; gap: 6px; }
.po .x { color: var(--ink3); }
.themes { display: flex; gap: 7px; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end; max-width: 210px; }
.th { width: 25px; height: 25px; border-radius: 50%; border: 2px solid transparent; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 1px var(--line2); }
.th i { width: 15px; height: 15px; border-radius: 50%; display: block; }
.th.on { border-color: var(--accent); }
.glist { padding: 2px 0 6px; }
.gr-row { display: flex; align-items: center; gap: 8px; padding: 8px 2px; border-bottom: 1px solid var(--line); }
.gr-row:last-child { border-bottom: 0; }
.gr-t { flex: 1; font-size: 13px; color: var(--ink); min-width: 0; word-break: break-all; }
.gr-in { flex: 1; min-width: 0; }
.gr-add { font-size: 12.5px; color: var(--accent); padding: 9px 2px; }
.gr-reset { font-size: 12.5px; color: var(--ink3); padding: 11px 2px; border-top: 1px solid var(--line); margin-top: 4px; }
.gwrap .gbody { display: none; }
.gwrap.open .gbody { display: block; }
.fold { cursor: pointer; display: flex; align-items: center; justify-content: space-between; }
.fold .fico { color: var(--ink3); font-size: 11px; transition: transform .18s; }
.gwrap.open .fold .fico { transform: rotate(90deg); }

/* 取数失败态：以前什么都不显示（记页永远停在骨架屏、看页整屏空白），
   现在撤掉骨架屏、给一句说明和一个能点的重试（见各页的 loadFail / onRetry） */
.loadfail { text-align: center; padding: 30px 0 10px; }
.loadfail .lft { font-size: 13px; color: var(--ink3); }
.loadfail .lfr { display: inline-block; margin-top: 10px; font-size: 13px; color: var(--accent); border: 1px solid var(--accent); border-radius: 99px; padding: 6px 18px; }

/* ================= 选项管理浮层 ================= */
.sheet { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 60; background: var(--bg); display: flex; flex-direction: column; padding: calc(var(--status-h, 20px) + 70px) 0 calc(10px + env(safe-area-inset-bottom, 0px)); box-sizing: border-box; }
.sh-h { display: flex; align-items: center; justify-content: space-between; padding: 15px 22px 2px; flex-shrink: 0; }
.sh-h .st { font-size: 17px; font-weight: 800; letter-spacing: -.01em; }
/* 命中区补齐：浮层关闭 30px → 撑到约 44px（四周都没有别的可点元素，放心扩） */
.sh-h .sx { width: 30px; height: 30px; border-radius: 50%; background: var(--soft); color: var(--ink2); font-size: 12px; display: flex; align-items: center; justify-content: center; position: relative; }
.sh-h .sx::after { content: ''; position: absolute; left: -7px; right: -7px; top: -7px; bottom: -7px; }
.sh-sub { font-size: 12px; color: var(--ink3); padding: 0 22px 12px; flex-shrink: 0; }
.sh-list { flex: 1; overflow-y: auto; padding: 2px 22px 4px; }
.opt-row { display: flex; align-items: center; gap: 9px; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 10px 11px; margin-bottom: 8px; }
.opt-row .ov { flex: 1; min-width: 0; font-size: 14.5px; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.opt-row .mini-in { flex: 1; min-width: 0; }
.sh-empty { font-size: 12.5px; color: var(--ink3); text-align: center; padding: 28px 0; }
.sh-newrow { flex-shrink: 0; padding: 10px 22px 0; border-top: 1px solid var(--line); }
.sh-foot { flex-shrink: 0; padding: 10px 22px 16px; display: flex; }
.undoline { margin: 0 22px 10px; flex-shrink: 0; background: var(--soft); border-radius: 12px; padding: 9px 12px; font-size: 12.5px; color: var(--ink2); display: flex; align-items: center; gap: 8px; }
.undoline .tx { flex: 1; }
.undoline .tb { font-size: 12px; color: var(--accent); text-decoration: underline; }

/* ================= 底部操作条 / 下拉刷新 / 通用 ================= */
.actbar { position: fixed; left: 0; right: 0; bottom: calc(58px + env(safe-area-inset-bottom, 0px)); background: var(--ink); color: #fff; border-radius: 18px 18px 0 0; display: flex; align-items: center; padding: 12px 10px calc(12px + env(safe-area-inset-bottom, 0px)); box-shadow: 0 -8px 24px rgba(35,35,31,.20); transform: translateY(150%); transition: transform .2s; z-index: 50; pointer-events: none; visibility: hidden; max-width: 640px; margin: 0 auto; }
.actbar.on { transform: translateY(0); pointer-events: auto; visibility: visible; }
.actbar > view { flex: 1; text-align: center; font-size: 13.5px; }
.actbar > view.del { color: #F0A9A5; }
.actbar > view.tx { flex: 2; font-size: 12.5px; color: #E8E6DE; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; padding-left: 12px; }
.actbar > view:active { opacity: .65; }
/* 「已删除 … · 撤销」/「已记入 … · 撤销」：原来贴着底部、整屏宽的一条，很容易被忽略。
   改成屏幕正中的小卡片（左右居中、圆角 + 描边 + 投影），带一点点「弹出来」的动效，
   「撤销」也从下划线文字变成实心药丸，一眼能看见、也更好点。
   注：只在 .undo-bar 上生效——.toastline 还有一处「记卡内的已记入确认行」（.sbline），
   那条要跟着记卡待在文档流里，不能浮起来。 */
.undo-bar {
  position: fixed; left: 50%; top: 50%; right: auto; bottom: auto;
  transform: translate(-50%, -50%);
  width: auto; min-width: 216px; max-width: 82vw;
  margin: 0; z-index: 60;
  background: #fff; border: 1px solid var(--line2); border-radius: 14px;
  padding: 12px 14px; box-shadow: 0 14px 34px rgba(35, 35, 31, .20), 0 4px 10px rgba(35, 35, 31, .12);
  animation: undo-pop .22s cubic-bezier(.2, .9, .3, 1.15);
}
.undo-bar .tb { font-size: 12.5px; font-weight: 700; color: #fff; background: var(--accent); text-decoration: none; padding: 5px 11px; border-radius: 999px; }
.undo-bar .tb:active { opacity: .85; }
@keyframes undo-pop {
  from { opacity: 0; transform: translate(-50%, -50%) scale(.82); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

/* ================= 自定义 tabBar ================= */
.tabbar { display: flex; border-top: 1px solid var(--line); background: var(--bg); flex-shrink: 0; padding: 6px 0 calc(6px + env(safe-area-inset-bottom, 0px)); z-index: 40; }
.tbb { flex: 1; text-align: center; font-size: 12px; color: var(--ink3); padding: 9px 0 5px; position: relative; }
.tbb.on { color: var(--accent); font-weight: 800; }
.tbb.on::before { content: ''; position: absolute; top: 3px; left: 50%; transform: translateX(-50%); width: 16px; height: 2.5px; border-radius: 99px; background: var(--accent); }
.tbb .ic { display: block; font-size: 15px; line-height: 1.3; }

/* 纯文本省略 */

/* ================= 程序名（记 / 看 共用） =================
   按胶囊矩形 fixed 定位，平时被原生胶囊盖住；下拉刷新把页面（含这个 fixed 元素）推下去时才露出来 */
.brand { display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 46; /* 高于状态栏遮罩(45)，下拉露出时不被渐变冲淡 */ }
/* 常亮：跟随主题的强调色 + 主题色柔光 */
.brand .bc { font-size: 14px; color: var(--accent); font-weight: 800; letter-spacing: .03em; text-shadow: 0 0 10px var(--accent-soft), 0 0 2px var(--accent-soft); }
/* 下拉刷新时：逐字浮现（每个字依次延迟） */
.brand.play .bc { animation: brandIn .5s cubic-bezier(.2, .8, .2, 1) both; }
.brand.play .bc:nth-child(1) { animation-delay: 0s; }
.brand.play .bc:nth-child(2) { animation-delay: .07s; }
.brand.play .bc:nth-child(3) { animation-delay: .14s; }
.brand.play .bc:nth-child(4) { animation-delay: .21s; }
@keyframes brandIn {
  from { opacity: 0; transform: translateY(8px) scale(.9); }
  to { opacity: 1; transform: none; }
}
