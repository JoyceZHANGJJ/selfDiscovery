<view class="tabroot theme-{{theme}}" wx:if="{{!hidden}}">
  <view class="tabbar">
    <view
      wx:for="{{list}}"
      wx:key="index"
      class="tbb {{selected === index ? 'on' : ''}} {{selected === index && pulse ? 'pulse' : ''}} {{selected === index && hint ? 'hint' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <text class="ic">{{item.icon}}</text>
      <text>{{item.text}}</text>
    </view>
  </view>
  <view class="fab" bindtap="onFab" aria-label="清单">☑</view>
</view>
