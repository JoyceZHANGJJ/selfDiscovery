<view class="tabroot {{ballOnly ? 'ballonly' : ''}}" style="{{themeStyle}}" wx:if="{{!hidden}}">
  <!-- 快捷记（待办 / 随记）：点「＋」球在原地弹条（不跳页）；
       面板 / 撤销条以外的任何地方（页面空白、记录、操作条、球）都收起——但键盘不收起 -->
  <!-- 遮罩上的任何操作（点按 / 上下滚动）都收起面板：不只是点击，滚动页面也算 -->
  <view wx:if="{{qa || qaUndo}}" class="qa-mask" bindtap="onMaskTap" bindtouchstart="onMaskTouch" bindtouchmove="onMaskTouch"></view>
  <view wx:if="{{qa}}" class="qa" style="bottom:{{qaBottom}}" bindtap="onQaBgTap">
    <!-- 标题只留「快捷记」：原先右上角的「清单 ›」入口已去掉。
         进清单页：看页待办块里的「去清单页管理 ›」，或长按这个「＋」球 -->
    <view class="qa-hd">
      <!-- 编辑态（qaEditId 非空＝左滑「改这一条」进来的）：标题换成「改这一条」，
           右边多一个「删除」——改到一半发现这条不要了，不用先退出再找操作条 -->
      <view class="qa-title">{{qaEditId ? '改这一条' : '快捷记'}}</view>
      <view wx:if="{{qaEditId}}" class="qa-del" catchtap="onQaDel">删除</view>
    </view>
    <!-- 平铺的快捷类别：点哪个就在哪个类别下记（来自「设置」里的勾选，上限见 store.QUICKCATS_MAX）。
         横向铺不下就换行（面板吸在球上方，往上长），不做左右滚——一屏看全、点哪条都不用先拨 -->
    <view wx:if="{{qaCats.length > 1}}" class="qa-chips">
      <view wx:for="{{qaCats}}" wx:key="key" class="qa-chip {{qaIdx===index?'on':''}}" data-i="{{index}}" catchtap="onQaChip">
        <view class="qa-dot" style="background:{{item.c}}"></view>
        <text>{{item.n}}</text>
      </view>
    </view>
    <!-- 优先级：只有待办类别才有这一格（随记类别下整行不渲染）。
         与记卡同一套档位（紧急 / 重要 四象限），默认落在默认档——不点也记，只是列表不插旗 -->
    <view wx:if="{{qaIsTodo && qaPrios.length > 1}}" class="qa-chips qa-prios">
      <view wx:for="{{qaPrios}}" wx:key="n" class="qa-chip {{qaPrioIdx===index?'on':''}}" data-i="{{index}}" catchtap="onQaPrio">
        <view class="qa-dot" style="background:{{item.c}}"></view>
        <text>{{item.n}}</text>
      </view>
    </view>
    <!-- 计划完成：只有待办类别才有这一格（与优先级同理）。
         这一行就是为了**不弹选择器**——点一格就设好（今天 / 明天 / 本周末 / 下周一 / 无）；
         只有「自定…」会开下面那个浮层。默认停在「无」：没计划是常态，不预选任何一档 -->
    <view wx:if="{{qaIsTodo}}" class="qa-due">
      <view class="qa-lab">计划完成</view>
      <view class="qa-chips qa-dues">
        <view wx:for="{{qaDues}}" wx:key="k" class="qa-chip {{qaDuePick===item.k?'on':''}}" data-k="{{item.k}}" catchtap="onQaDue">
          <text>{{item.t}}</text>
        </view>
      </view>
    </view>
    <view class="qa-row" catchtap="onQaNoop">
      <!-- adjust-position 关掉：面板的位置由我们自己按键盘高度给（见 _applyKb），
           不再让微信去「顶页面」——回看整页是 scroll-view（页面本身不滚），它顶不动，
           结果就是面板留在原地被键盘盖住；两边的调整叠在一起也会把面板抬过头 -->
      <input class="qa-in" placeholder="{{qaPh}}" value="{{qaTxt}}" bindinput="onQaInput" bindconfirm="onQaSave" bindblur="onQaBlur" bindkeyboardheightchange="onQaKb" confirm-type="done" adjust-position="{{false}}" cursor-spacing="24" always-embed="{{true}}" focus="{{qaFocus}}" id="qaIn" />
      <view class="qa-go {{qaTxt ? 'on' : ''}}" bindtap="onQaSave">{{qaEditId ? '保存' : '记下'}}</view>
    </view>
  </view>

  <!-- 「自定…」的浮层：日期 + 时间两个原生选择器，与睡页「改时刻」同一套 sheet
       （.sheet / .sh-* / .btn 都是 app.wxss 里的全局样式，本组件开了 addGlobalClass 才拿得到）。
       这是整个快捷记里唯一会弹选择器的地方——平时靠上面那排档位，一次点击就设好了 -->
  <view wx:if="{{qaDueOpen}}" class="sheet du-sheet">
    <view class="sh-h"><view class="st">计划完成</view><view class="sx" bindtap="closeQaDue" aria-label="关闭">✕</view></view>
    <view class="sh-sub">选到哪一天、哪一刻为止（不设就走上面那排档位）</view>
    <view class="sh-list">
      <view class="du-row">
        <picker class="du-pk" mode="date" value="{{qaDueDate}}" bindchange="onQaDueDate">
          <view class="du-pick"><text class="du-k">日期</text><text class="du-v">{{qaDueDate}}</text><text class="du-c">▸</text></view>
        </picker>
        <picker class="du-pk" mode="time" value="{{qaDueTime}}" bindchange="onQaDueTime">
          <view class="du-pick"><text class="du-k">时间</text><text class="du-v">{{qaDueTime}}</text><text class="du-c">▸</text></view>
        </picker>
      </view>
      <view class="du-hint">时间默认停在那天的 23:59（＝那天结束前），要精确到几点就改右边。</view>
    </view>
    <view class="sh-foot">
      <view class="btn gh" bindtap="closeQaDue">取消</view>
      <view class="btn" bindtap="okQaDue">好</view>
    </view>
  </view>

  <!-- 记下后给一次撤销（与其它页同一套样式：屏幕正中的小卡片，见 app.wxss 的 .undo-bar） -->
  <view wx:if="{{qaUndo}}" class="toastline undo-bar qa-undo">
    <view class="tx">已记入{{qaUndo.name}}「{{qaUndo.txt}}」</view>
    <view class="tb" bindtap="onQaUndo">撤销</view>
  </view>

  <!-- 底部 tab 栏：ballOnly（挂在清单页这类「非 tab 页」上）时整条不渲染，只留「＋」球与面板。
       图标是现画的 SVG（utils/tabicons.js，颜色按当前主题算好写在 data URI 里，
       见 index.js 的 tabList）——不再用 ✎ ☰ ◐ ◎ ⚙ 这类系统字符（各机型大小不一） -->
  <view wx:if="{{!ballOnly}}" class="tabbar">
    <view
      wx:for="{{list}}"
      wx:key="index"
      class="tbb {{selected === index ? 'on' : ''}} {{selected === index && pulse ? 'pulse' : ''}} {{selected === index && hint ? 'hint' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
      aria-role="button" aria-label="{{item.text}}"
    >
      <image class="ic" src="{{selected === index ? item.iconOn : item.iconOff}}" aria-hidden="true" />
      <text>{{item.text}}</text>
    </view>
  </view>
  <!-- 球 = 快捷记待办（展开时变 ×）；长按 = 进清单页 -->
  <view class="fab {{qa ? 'on' : ''}}" bindtap="onFab" bindlongpress="onFabLong" aria-label="快捷记待办">{{qa ? '×' : '＋'}}</view>
</view>
