.tabbar {
  display: flex;
  border-top: 1px solid var(--line, #EAE5DC);
  background: var(--bg, #FAF8F4);
  flex-shrink: 0;
  padding: 6px 0 calc(6px + env(safe-area-inset-bottom, 0px));
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-width: 640px;
  margin: 0 auto;
  z-index: 40;
}
.tbb {
  flex: 1; text-align: center; font-size: 12px; color: var(--ink3, #8B8779);
  padding: 9px 0 5px; position: relative;
}
.tbb.on { color: var(--accent, #7C9A86); font-weight: 800; }
.tbb.on::before {
  content: ''; position: absolute; top: 3px; left: 50%; transform: translateX(-50%);
  width: 16px; height: 2.5px; border-radius: 99px; background: var(--accent, #7C9A86);
}
.tbb .ic { display: block; font-size: 15px; line-height: 1.3; }

/* ================= 常驻悬浮球 ================= */
.fab {
  position: fixed; right: 18px; bottom: calc(66px + env(safe-area-inset-bottom, 0px));
  z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: 10px;
  max-width: 640px;
}
.fab-main {
  width: 52px; height: 52px; border-radius: 50%;
  background: #7C9A86; color: #fff; font-size: 28px; line-height: 52px; text-align: center;
  box-shadow: 0 4px 14px rgba(124,154,134,.45); flex-shrink: 0;
}
.fab-main.on { font-size: 26px; }
.fab-menu { display: flex; flex-direction: column; gap: 9px; align-items: flex-end; }
.fab-item {
  padding: 7px 16px; border-radius: 99px; background: #fff; color: #5A564C;
  border: 1.5px solid rgba(0,0,0,.06);
  font-size: 13px; font-weight: 700; box-shadow: 0 2px 10px rgba(35,35,31,.12); flex-shrink: 0;
}
.fab-item:active { opacity: .85; }
