/* 组件根上挂一份底部偏移变量：page 级变量（app.wxss）对自定义组件内部不可靠，
   球 / 面板 / tab 栏都在本组件里，必须在这里自给自足（值与 app.wxss 的 page 块保持一致） */
.tabroot {
  --max-w: 640px;
  --tabbar-h: 58px;
  --fab-bottom: 116px;
  --qa-bottom: 178px;
}
.tabbar {
  display: flex;
  border-top: 1px solid var(--line, #EAE5DC);
  background: var(--bg, #FAF8F4);
  flex-shrink: 0;
  padding: 6px 0 calc(6px + env(safe-area-inset-bottom, 0px));
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-width: var(--max-w);
  margin: 0 auto;
  z-index: 40;
}
.tbb {
  flex: 1; text-align: center; font-size: 12px; color: var(--ink3, #8B8779);
  padding: 7px 0 5px; position: relative;
}
.tbb.on { color: var(--accent, #7C9A86); font-weight: 800; }
.tbb.on::before {
  content: ''; position: absolute; top: 3px; left: 50%; transform: translateX(-50%);
  width: 16px; height: 2.5px; border-radius: 99px; background: var(--accent, #7C9A86);
}
/* 图标是现画的 SVG（utils/tabicons.js），不是字体字符，所以这里只给**盒子**：
   五个图标同一 24×24 视框、同一条 1.8 描边、视觉尺寸都约 17/24，显示出来就一样大。
   高度已补偿：盒子 22px + 上内边距 7px（原来是字符约 19.5px + 9px），底栏总高不变 */
.tbb .ic { display: block; width: 22px; height: 22px; margin: 0 auto; }
/* 再点当前 tab 回顶时：图标轻弹一下（在手指落点给反馈，不占页面空间） */
@keyframes tabPulse {
  0% { transform: scale(1); }
  35% { transform: scale(1.22); }
  100% { transform: scale(1); }
}
.tbb.pulse .ic { animation: tabPulse .42s cubic-bezier(.3, .8, .3, 1); }
.tbb.pulse::before { animation: tabPulse .42s cubic-bezier(.3, .8, .3, 1); }

/* 滑到底部：图标连续轻跳 + 顶部指示条闪烁，暗示「点这里能回到顶部」 */
@keyframes tabHint {
  0%, 100% { transform: translateY(0); }
  30% { transform: translateY(-3px); }
  60% { transform: translateY(0); }
}
@keyframes barHint {
  0%, 100% { opacity: 1; }
  50% { opacity: .2; }
}
.tbb.hint .ic { animation: tabHint .55s ease-in-out 3; }
.tbb.hint::before { animation: barHint .55s ease-in-out 3; }

/* ===== 快捷记待办：点「＋」球在原地弹出的输入条 =====
   位置固定在球的正上方（球 bottom 116 + 球高 52 + 10 间隙），不占页面空间、不推挤列表 */
/* 遮罩：盖住整屏（含底部 tab 栏与它的安全区留白）。
   面板是「跟着键盘的输入条」：只要输入框失焦，点到面板以外的任何地方（页面空白 / 记录 /
   操作条 / tab 栏 / 球）都收起。z-index 取在操作条(50) / 标题条(45) 之上、面板与撤销条(62) 之下。 */
.qa-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 61; }
.qa {
  position: fixed; left: 16px; right: 16px; bottom: calc(var(--qa-bottom) + env(safe-area-inset-bottom, 0px));
  max-width: 608px; margin: 0 auto; z-index: 62;
  background: var(--bg, #FAF8F4); border: 1px solid var(--line2, #E2DCD1); border-radius: 16px;
  padding: 11px 12px 12px; box-sizing: border-box;
  box-shadow: 0 14px 30px rgba(35,35,31,.20), 0 4px 10px rgba(35,35,31,.12);
}
.qa-hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.qa-title { font-size: 12.5px; color: var(--ink2, #55524A); font-weight: 600; }
/* 编辑态（左滑「改这一条」）右上角多出来的「删除」：与标题同一排、低一档的浅色小字，
   不抢「保存」的主操作；命中区同样补齐（12px 的字太小，手指点不准） */
.qa-del { font-size: 12px; color: var(--ink3, #8B8779); padding: 3px 0 3px 10px; position: relative; }
.qa-del::after { content: ''; position: absolute; left: -4px; right: -4px; top: -6px; bottom: -6px; }
.qa-dot { width: 6px; height: 6px; border-radius: 50%; margin-right: 5px; flex-shrink: 0; }
/* 快捷类别：纯文字（与记卡里的「类别 / 喜恶」同一套）——无边框无底，
   选中＝主题色 + 加粗；类别颜色由前面的小圆点带出来（原来靠药丸底色）。
   最多 10 个，横向铺不下就换行（面板吸在球上方，往上长） */
/* 行间距 4px → 8px：给类别的可点区留位置（见 .qa-chip::after），否则会互相抢 */
.qa-chips { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-bottom: 10px; }
/* 命中区补齐：类别约 22px 高 → 撑到约 30px（面板贴在键盘上方，空间紧，只补到这个程度） */
.qa-chip { display: inline-flex; align-items: center; font-size: 13.5px; color: var(--ink, #22252A); padding: 3px 0; box-sizing: border-box; position: relative; }
.qa-chip::after { content: ''; position: absolute; left: -4px; right: -4px; top: -4px; bottom: -4px; }
.qa-chip.on { color: var(--accent, #7C9A86); font-weight: 700; }
/* 优先级那一行：比类别低半档（字小一档、色浅一档）——类别是「记到哪儿」，
   优先级只是「多要紧」，两行同重会让人以为要先选优先级 */
.qa-prios { margin-bottom: 8px; }
.qa-prios .qa-chip { font-size: 12px; color: var(--ink2, #55524A); }
/* 计划完成：比优先级再低半档（字更小、色更浅）——它是「补充信息」，
   优先级才是每一条待办都该看一眼的。上面的小标题是必须的：
   「今天 / 明天 / 无」这排 chip 不写标题会被当成筛选器 */
.qa-due { margin-bottom: 8px; }
.qa-lab { font-size: 11px; color: var(--ink3, #8B8779); margin-bottom: 6px; }
.qa-dues { margin-bottom: 0; }
.qa-dues .qa-chip { font-size: 12px; color: var(--ink2, #55524A); }

/* 「自定…」浮层：月历 + 时刻快捷档。
   样式照抄全局的 .sheet / .sh-*（组件里能拿到全局那份），这里只写自己的一层。
   日历用 7 列 grid：格子宽高固定 → 6 行高度恒定，翻月时不跳 */
.du-mon { display: flex; align-items: center; justify-content: space-between; padding: 2px 2px 8px; }
.du-mon-t { font-size: 14.5px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
.du-arrow {
  width: 34px; height: 34px; border-radius: 50%; background: var(--soft); color: var(--ink2);
  font-size: 17px; line-height: 1; display: flex; align-items: center; justify-content: center; position: relative;
}
.du-arrow::after { content: ''; position: absolute; left: -8px; right: -8px; top: -8px; bottom: -8px; }
.du-wk { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 4px; }
.du-wk1 { text-align: center; font-size: 11px; color: var(--ink4, #A9A498); }
.du-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
.du-cell {
  height: 38px; line-height: 38px; text-align: center; border-radius: 10px;
  font-size: 14px; color: var(--ink); font-variant-numeric: tabular-nums; position: relative;
}
/* 前后补的空格：留着位置但画淡，免得这个月的 1 号看着像月初开始 */
.du-cell.out { color: var(--ink4, #A9A498); opacity: .45; }
/* 今天：不填色，只加一圈（选中态才是实心，两个别打架） */
.du-cell.today { box-shadow: inset 0 0 0 1.5px var(--line2, #E2DCD1); font-weight: 700; }
.du-cell.past { color: var(--ink4, #A9A498); }
.du-cell.sel { background: var(--accent); color: #fff; font-weight: 700; }
.du-lab { font-size: 12px; color: var(--ink4, #A9A498); padding: 16px 2px 6px; }
.du-times { display: flex; flex-wrap: wrap; gap: 7px; }
.du-time {
  font-size: 12.5px; color: var(--ink2, #55524A); background: var(--surface, #FFFFFF);
  border: 1px solid var(--line); border-radius: 999px; padding: 7px 12px; line-height: 1.2;
}
.du-time.on { background: var(--accent-soft, #E6F4F0); border-color: var(--accent, #2F8F7B); color: var(--accent, #2F8F7B); font-weight: 700; }
.du-pk { display: block; padding-top: 10px; }
.du-pick { display: flex; align-items: center; gap: 8px; background: var(--surface, #FFFFFF); border: 1px solid var(--line); border-radius: 12px; padding: 12px 13px; }
.du-k { font-size: 12px; color: var(--ink4, #A9A498); flex: none; }
.du-v { flex: 1; min-width: 0; font-size: 15px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
.du-c { font-size: 12px; color: var(--ink4, #A9A498); flex: none; }
.du-hint { font-size: 11.5px; color: var(--ink4, #A9A498); line-height: 1.7; padding: 11px 2px 0; }
/* 浮层压过页面浮层（.sheet 本来是 60）：面板是 62，不抬起来会被面板盖住上半截 */
.sheet.du-sheet { z-index: 70; }
.qa-row { display: flex; align-items: center; }
.qa-in {
  flex: 1; min-width: 0; height: 38px; line-height: 38px; border: 1px solid var(--line2, #E2DCD1);
  border-radius: 10px; padding: 0 12px; font-size: 14px; font-family: inherit; background: #fff;
  box-sizing: border-box; caret-color: var(--accent, #7C9A86);
}
.qa-in:focus { border-color: var(--accent, #7C9A86); }
/* 命中区补齐：约 35px 高 → 撑到约 45px。**不向左扩**：左边是输入框，
   本按钮绘制在它之上，往左扩会把输入框右侧的点击抢走（点了输入框却触发「记下」） */
.qa-go { flex-shrink: 0; font-size: 13.5px; font-weight: 700; color: var(--ink3, #8B8779); padding: 8px 2px 8px 12px; position: relative; }
.qa-go::after { content: ''; position: absolute; left: 0; right: -4px; top: -5px; bottom: -5px; }
.qa-go.on { color: var(--accent, #7C9A86); }
/* 撤销条：位置与样式全部沿用全局 .undo-bar（屏幕正中的小卡片），这里只抬到遮罩 / 面板之上——
   否则点「撤销」会先被遮罩吃掉 */
.undo-bar.qa-undo { z-index: 62; }
/* 球展开时（显示 ×）压深一档，和「收起」区分开 */
.fab.on { background: var(--ink2, #55524A); }
/* 注：ballOnly（清单页这类非 tab 页）只隐藏底部 tab 栏，球与面板的位置与 tab 页完全一致
   （球 bottom 116px、面板 178px），保证「快捷入口」在每个页面都在同一个地方 */
